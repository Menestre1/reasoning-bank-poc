Процедура ЗаписатьВЛог(ТекстСообщения, ИмяФайлаЛога = "avs_integration_log.txt") Экспорт

	Попытка
		ПутьКЛогу = КаталогВременныхФайлов() + ИмяФайлаЛога;
		
		Текст = Новый ТекстовыйДокумент;
		
		// ПРАВИЛЬНО: создаем объект Файл и проверяем его существование
		ФайлЛога = Новый Файл(ПутьКЛогу);
		Если ФайлЛога.Существует() Тогда
			Текст.Прочитать(ПутьКЛогу, КодировкаТекста.UTF8);
		КонецЕсли;
		
		// Добавляем новую строку с датой и текстом
		СтрокаЛога = Строка(ТекущаяДата()) + " | " + ТекстСообщения;
		Текст.ДобавитьСтроку(СтрокаЛога);
		
		// Записываем обратно
		Текст.Записать(ПутьКЛогу, КодировкаТекста.UTF8);
	Исключение
		// Если не получается записать лог, хотя бы в окно сообщений выведем
		Сообщить("Ошибка записи лога: " + ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры
Функция ПоказатьПутьКЛогам() Экспорт
	Путь = КаталогВременныхФайлов();
	Сообщить("Логи сохраняются в: " + Путь);
	
	// Можно открыть папку
	ЗапуститьПриложение("explorer " + Путь);
	
	Возврат Путь;
КонецФункции