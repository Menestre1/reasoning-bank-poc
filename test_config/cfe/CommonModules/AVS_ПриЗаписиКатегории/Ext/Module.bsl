// { ПРАВКА: Корректное определение INSERT / UPDATE }

// 1. Этот обработчик нужно повесить на событие ПЕРЕД ЗАПИСЬЮ
Процедура AVS_ПриЗаписиКатегорииПередЗаписью(Источник, Отказ) Экспорт
	Если Источник.ОбменДанными.Загрузка Тогда Возврат; КонецЕсли;
	
	// --- А) ВАЛИДАЦИЯ ИЕРАРХИИ (Централизованно) ---
	Если ЗначениеЗаполнено(Источник.Родитель) Тогда
		Если Источник.Родитель = Источник.Ссылка Тогда
			Отказ = Истина; Сообщить("Категория не может быть родителем самой себе!"); Возврат;
		КонецЕсли;
		Если Не Источник.ЭтоНовый() И Источник.Родитель.ПринадлежитЭлементу(Источник.Ссылка) Тогда
			Отказ = Истина; Сообщить("Ошибка: Выбранный родитель является дочерним элементом текущей категории. Это вызовет зацикливание!"); Возврат;
		КонецЕсли;
	КонецЕсли;

	// --- Б) ОПРЕДЕЛЕНИЕ ТИПА СОБЫТИЯ ---
	// Запоминаем состояние "Новый", т.к. в ПриЗаписи метод ЭтоНовый() всегда вернет Ложь
	Источник.ДополнительныеСвойства.Вставить("AVS_ЭтоНовый", Источник.ЭтоНовый());
	
	Если Источник.ЭтоНовый() Тогда
		Источник.ДополнительныеСвойства.Вставить("AVS_ТипСобытия", "INSERT");
	Иначе
		// Сравниваем реквизиты с данными в БД
		Реквизиты = "Наименование, Родитель, ПометкаУдаления, СсылкаНаИзображение, ПорядокСортировки";
		Старые = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Источник.Ссылка, Реквизиты);
		
		Вид = "";
		// 1. Пометка удаления
		Если Источник.ПометкаУдаления <> Старые.ПометкаУдаления Тогда
			Вид = ?(Источник.ПометкаУдаления, "DELETE", "UPDATE");
		
		// 2. Иерархия или Характеристики (LINK_CHANGE)
		ИначеЕсли Источник.Родитель <> Старые.Родитель 
			Или Источник.ДополнительныеСвойства.Свойство("AVS_ХарактеристикиИзменены") Тогда
			Вид = "LINK_CHANGE";
			
		// 3. Данные объекта (UPDATE)
		ИначеЕсли Источник.Наименование <> Старые.Наименование 
			Или Источник.СсылкаНаИзображение <> Старые.СсылкаНаИзображение
			Или Источник.ПорядокСортировки <> Старые.ПорядокСортировки Тогда
			Вид = "UPDATE";
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Вид) Тогда
			Источник.ДополнительныеСвойства.Вставить("AVS_ТипСобытия", Вид);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

// Вызывается из подписки AVS_ПриЗаписиКатегории (событие ПриЗаписи)
Процедура AVS_ПриЗаписиКатегорииПриЗаписи(Источник, Отказ) Экспорт
	
	Если Источник.ОбменДанными.Загрузка Тогда Возврат; КонецЕсли;
    
	Если Источник.ДополнительныеСвойства.Свойство("AVS_ТипСобытия") Тогда
		Тип = Источник.ДополнительныеСвойства.AVS_ТипСобытия;
		AVS_ОбщийМодульСайт.AVS_ЗарегистрироватьИзменение(Источник.Ссылка, Тип);
	КонецЕсли;
    
КонецПроцедуры 

// Это сработает, если объект удаляют физически (Shift+Del или обработкой)
Процедура AVS_ПриЗаписиКатегорииПередУдалением(Источник, Отказ) Экспорт
	Если Источник.ОбменДанными.Загрузка Тогда Возврат; КонецЕсли;
	AVS_ОбщийМодульСайт.AVS_ЗарегистрироватьИзменение(Источник.Ссылка, "DELETE");
КонецПроцедуры