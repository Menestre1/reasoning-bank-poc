// Модуль содержит функции для работы с категориями и выгрузкой

#Область ПрограммныйИнтерфейс

// { ПРАВКА: Строгий маппинг и расширенный лог (ТЗ 1.6) }
Процедура AVS_ЗарегистрироватьИзменение(Объект, ВидСобытия) Экспорт
	
	Если Не ЗначениеЗаполнено(Объект) Тогда Возврат; КонецЕсли;
	
	ТекстВход = ВРег(СокрЛП(Строка(ВидСобытия)));
	
	Попытка
		ТекущийМомент = ТекущаяДатаСеанса();
		ЗначениеСобытия = Неопределено;
		
		// 1. СТРОГИЙ МАППИНГ (сначала проверяем полные совпадения)
		Если ТекстВход = "UPDATE" Или ТекстВход = "ОБНОВЛЕНИЕ" Тогда 
			ТекстКода = "UPDATE";
		ИначеЕсли ТекстВход = "DELETE" Или ТекстВход = "УДАЛЕНИЕ" Тогда 
			ТекстКода = "DELETE";
		ИначеЕсли ТекстВход = "INSERT" Или ТекстВход = "ДОБАВЛЕНИЕ" Тогда 
			ТекстКода = "INSERT";
		ИначеЕсли ТекстВход = "GROUP_LINK_CHANGE" Или ТекстВход = "ИЗМЕНЕНИЕ ГРУППОВОЙ СВЯЗКИ" Тогда 
			ТекстКода = "GROUP_LINK_CHANGE";
		ИначеЕсли ТекстВход = "LINK_CHANGE" Или ТекстВход = "ИЗМЕНЕНИЕ СВЯЗИ" Тогда 
			ТекстКода = "LINK_CHANGE";
		ИначеЕсли ТекстВход = "MEDIA_CHANGE" Или ТекстВход = "ИЗМЕНЕНИЕ МЕДИА" Тогда 
			ТекстКода = "MEDIA_CHANGE";
		Иначе
			ТекстКода = ТекстВход; // Пробуем как есть (для новых типов)
		КонецЕсли;
		
		Попытка
			ЗначениеСобытия = Перечисления.AVS_ВидСобытия[ТекстКода];
		Исключение
			// Если не нашли по имени, ищем по синониму среди всех значений
			Для Каждого ТекМета Из Метаданные.Перечисления.AVS_ВидСобытия.ЗначенияПеречисления Цикл
				Если ВРег(ТекМета.Синоним) = ТекстВход Тогда
					ЗначениеСобытия = Перечисления.AVS_ВидСобытия[ТекМета.Имя];
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецПопытки;

		Если ЗначениеСобытия = Неопределено Тогда 
			Сообщить(СтрШаблон("[AVS ERROR]: Не удалось сопоставить событие '%1'", ТекстВход));
			Возврат; 
		КонецЕсли;

		// 2. ЗАПИСЬ
		Менеджер = РегистрыСведений.AVS_РегистрИзмененийКатегорийСайта.СоздатьМенеджерЗаписи();
		Менеджер.Период     = ТекущийМомент;
		Менеджер.Объект     = Объект;
		Менеджер.ВидСобытия = ЗначениеСобытия;
		Менеджер.МеткаВремени = ТекущийМомент;
		Менеджер.Записать(Истина);
		
		// 3. ЛОГ (Синоним + Системное Имя)
		СистемноеИмя = ЗначениеСобытия.Метаданные().Имя;
		Сообщить(СтрШаблон("[%1] [AVS]: %2 -> %3 (%4)", 
			Формат(ТекущийМомент, "ДФ=HH:mm:ss"), Объект, ЗначениеСобытия, СистемноеИмя));
			
	Исключение
		AVS_Логирование.ЗаписатьВЛог("Ошибка регистрации: " + ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

// { ПРАВКА_НАЧАЛО: Централизация и безопасность регистрации GROUP_LINK_CHANGE }
// Регистрирует событие для всех товаров, входящих в указанную связку.
// Параметры:
//  Связка - СправочникСсылка.AVS_ИдентификаторыСвязок - Ссылка на группу вариаций.
Процедура ЗарегистрироватьИзменениеСвязки(Связка) Экспорт
	
	Если Не ЗначениеЗаполнено(Связка) Тогда Возврат; КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ Состав.Товар КАК Товар 
		|ИЗ РегистрСведений.AVS_СоставСвязокНоменклатуры КАК Состав 
		|ГДЕ Состав.Связка = &Связка";
	
	Запрос.УстановитьПараметр("Связка", Связка);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		// Вызываем новый универсальный метод
		AVS_ЗарегистрироватьИзменение(Выборка.Товар, "GROUP_LINK_CHANGE");
	КонецЦикла;
	
КонецПроцедуры
// { ПРАВКА_КОНЕЦ }

// Получает состав связки
Функция ПолучитьСоставСвязки(Связка) Экспорт
    
    Запрос = Новый Запрос;
    Запрос.Текст = 
    "ВЫБРАТЬ
    |   Состав.Товар КАК Товар,
    |   Состав.Порядок КАК Порядок
    |ИЗ
    |   РегистрСведений.AVS_СоставСвязокНоменклатуры КАК Состав
    |ГДЕ
    |   Состав.Связка = &Связка
    |
    |УПОРЯДОЧИТЬ ПО
    |   Порядок";
    
    Запрос.УстановитьПараметр("Связка", Связка);
    Возврат Запрос.Выполнить().Выгрузить();
    
КонецФункции

// Получает характеристики связки для товара
Функция ПолучитьХарактеристикиСвязкиТовара(Связка, Товар) Экспорт
    
    Запрос = Новый Запрос;
    Запрос.Текст = 
    "ВЫБРАТЬ
    |   Характеристики.Характеристика КАК Характеристика,
    |   Характеристики.Значение КАК Значение
    |ИЗ
    |   РегистрСведений.AVS_ХарактеристикиСвязок КАК Характеристики
    |ГДЕ
    |   Характеристики.Связка = &Связка
    |   И Характеристики.Товар = &Товар";
    
    Запрос.УстановитьПараметр("Связка", Связка);
    Запрос.УстановитьПараметр("Товар", Товар);
    Возврат Запрос.Выполнить().Выгрузить();
    
КонецФункции

// Получает связки товара
Функция ПолучитьСвязкиТовара(Товар) Экспорт
    
    Запрос = Новый Запрос;
    Запрос.Текст = 
    "ВЫБРАТЬ РАЗЛИЧНЫЕ
    |   Состав.Связка КАК Связка
    |ИЗ
    |   РегистрСведений.AVS_СоставСвязокНоменклатуры КАК Состав
    |ГДЕ
    |   Состав.Товар = &Товар";
    
    Запрос.УстановитьПараметр("Товар", Товар);
    Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Связка");
    
КонецФункции

Функция ТоварПривязанККатегориям(Товар) Экспорт
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 1 ИЗ РегистрСведений.AVS_СоставКатегорийНоменклатуры ГДЕ Номенклатура = &Товар");
    Запрос.УстановитьПараметр("Товар", Товар);
    Возврат Не Запрос.Выполнить().Пустой();
КонецФункции

#КонецОбласти 

// Возвращает ссылку на связку (вариацию), в которой участвует товар.
// Используется для отображения статуса связки в карточке номенклатуры.
Функция ПолучитьИдентификаторСвязкиТовара(Товар) Экспорт
    
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Связка ИЗ РегистрСведений.AVS_СоставСвязокНоменклатуры ГДЕ Товар = &Товар");
    Запрос.УстановитьПараметр("Товар", Товар);
    Выборка = Запрос.Выполнить().Выбрать();
    Возврат ?(Выборка.Следующий(), Выборка.Связка, Справочники.AVS_ИдентификаторыСвязок.ПустаяСсылка());
    
КонецФункции

// Возвращает таблицу товаров, входящих в ту же связку, что и текущий товар
Функция ПолучитьДанныеСоставаСвязки(Товар) Экспорт
    
    Связка = ПолучитьИдентификаторСвязкиТовара(Товар);
    Если Связка.Пустая() Тогда
        Возврат Неопределено;
    КонецЕсли;
    
    Запрос = Новый Запрос;
    Запрос.Текст = 
    "ВЫБРАТЬ
    |	Состав.Товар КАК Товар,
    |	Состав.Товар.Наименование КАК ТоварПредставление,
    |	Состав.Порядок КАК Порядок
    |ИЗ
    |	РегистрСведений.AVS_СоставСвязокНоменклатуры КАК Состав
    |ГДЕ
    |	Состав.Связка = &Связка
    |УПОРЯДОЧИТЬ ПО
    |	Состав.Порядок";
    
    Запрос.УстановитьПараметр("Связка", Связка);
    Возврат Запрос.Выполнить().Выгрузить();
    
КонецФункции

// Возвращает значения характеристик для всех товаров в связке
Функция ПолучитьЗначенияХарактеристикСвязки(Связка) Экспорт
    Запрос = Новый Запрос;
    Запрос.Текст = 
    "ВЫБРАТЬ
    |	Хар.Товар,
    |	Хар.Характеристика КАК Свойство,
    |	Хар.Характеристика.Заголовок КАК СвойствоНаименование,
    |	Хар.Значение
    |ИЗ
    |	РегистрСведений.AVS_ХарактеристикиСвязок КАК Хар
    |ГДЕ
    |	Хар.Связка = &Связка";
    Запрос.УстановитьПараметр("Связка", Связка);
    Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

// { ПРАВКА_НАЧАЛО: Автозаполнение характеристик из Доп. Сведений }
// Функция переносит значения из стандартного регистра ДополнительныеСведения в СоставСвязок
// Возвращает массив заголовков характеристик, которые не были найдены или пусты
Функция ЗаполнитьХарактеристикиИзДопСведений(Связка, Товар, Порядок) Экспорт
	
	Результат = Новый Структура("Изменено, СписокПропущенных", Ложь, Новый Массив);
    
    Попытка
        Набор = РегистрыСведений.AVS_СоставСвязокНоменклатуры.СоздатьНаборЗаписей();
        Набор.Отбор.Связка.Установить(Связка);
        Набор.Отбор.Товар.Установить(Товар);
        Набор.Прочитать();
        
        // Сохраним старое состояние для сравнения
        ТаблицаСтарая = Набор.Выгрузить();
        Для Каждого ИмяКолонки Из СтрРазделить("Связка,Товар", ",") Цикл
            Колонка = ТаблицаСтарая.Колонки.Найти(СокрЛП(ИмяКолонки));
            Если Колонка <> Неопределено Тогда ТаблицаСтарая.Колонки.Удалить(Колонка); КонецЕсли;
        КонецЦикла;
        ТаблицаСтарая.Сортировать("ХарактеристикаСвязки");

        Набор.Очистить(); 

        Запрос = Новый Запрос(
            "ВЫБРАТЬ 
            |   Схема.Характеристика КАК Характеристика, 
            |   ЕСТЬNULL(Схема.Характеристика.Заголовок, ""[Без заголовка]"") КАК Заголовок, 
            |   ДС.Значение КАК Значение
            |ИЗ 
            |   РегистрСведений.AVS_ХарактеристикиСвязок КАК Схема
            |   ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК ДС 
            |       ПО Схема.Характеристика = ДС.Свойство И ДС.Объект = &Товар
            |ГДЕ 
            |   Схема.Связка = &Связка");
        Запрос.УстановитьПараметр("Связка", Связка);
        Запрос.УстановитьПараметр("Товар",  Товар);
        Выборка = Запрос.Выполнить().Выбрать();
        
        Если Выборка.Количество() = 0 Тогда
            Запись = Набор.Добавить(); Запись.Связка = Связка; Запись.Товар = Товар; Запись.Порядок = Порядок;
        Иначе
            Пока Выборка.Следующий() Цикл
                Запись = Набор.Добавить();
                Запись.Связка = Связка; Запись.Товар = Товар; Запись.Порядок = Порядок;
                Запись.ХарактеристикаСвязки = Выборка.Характеристика;
                Запись.ЗначениеХарактеристики = Выборка.Значение;
                Если Не ЗначениеЗаполнено(Выборка.Значение) Тогда 
                    Результат.СписокПропущенных.Добавить(Строка(Выборка.Заголовок)); 
				КонецЕсли;
            КонецЦикла;
        КонецЕсли;
        
        // Сравнение данных
        ТаблицаНовая = Набор.Выгрузить();
        Для Каждого ИмяКолонки Из СтрРазделить("Связка,Товар", ",") Цикл
            Колонка = ТаблицаНовая.Колонки.Найти(СокрЛП(ИмяКолонки));
            Если Колонка <> Неопределено Тогда ТаблицаНовая.Колонки.Удалить(Колонка); КонецЕсли;
        КонецЦикла;
        ТаблицаНовая.Сортировать("ХарактеристикаСвязки");
        
        Если ТаблицаСтарая.Количество() <> ТаблицаНовая.Количество() Тогда
            Результат.Изменено = Истина;
        Иначе
            Для Сч = 0 По ТаблицаСтарая.Количество() - 1 Цикл
                СтрСтарая = ТаблицаСтарая[Сч];
                СтрНовая  = ТаблицаНовая[Сч];
                Если СтрСтарая.ХарактеристикаСвязки <> СтрНовая.ХарактеристикаСвязки 
                   Или СтрСтарая.ЗначениеХарактеристики <> СтрНовая.ЗначениеХарактеристики
                   Или СтрСтарая.Порядок <> СтрНовая.Порядок Тогда
                    Результат.Изменено = Истина;
                    Прервать;
                КонецЕсли;
            КонецЦикла;
        КонецЕсли;

        Если Результат.Изменено Тогда
            Набор.Записать(Истина); 
            Сообщить(СтрШаблон("[AVS DEBUG]: Данные товара %1 в связке обновлены.", Товар));
        КонецЕсли;
        
    Исключение
        ТекстОшибки = "[AVS ERROR]: Ошибка синхронизации состава: " + ОписаниеОшибки();
        Сообщить(ТекстОшибки);
        AVS_Логирование.ЗаписатьВЛог(ТекстОшибки);
        Результат.Изменено = Ложь; // Возвращаем корректную структуру, чтобы не падал вызывающий код
    КонецПопытки;
    
    Возврат Результат;
    
КонецФункции
// { ПРАВКА_КОНЕЦ }

// { ПРАВКА: Массовое обновление всех товаров в связке }
Процедура ОбновитьДанныеВсехТоваровСвязки(Связка) Экспорт
    
    Если Не ЗначениеЗаполнено(Связка) Тогда Возврат; КонецЕсли;
    
    // 1. Получаем список всех товаров в этой группе
    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ РАЗЛИЧНЫЕ
        |	Состав.Товар КАК Товар,
        |	Состав.Порядок КАК Порядок
        |ИЗ
        |	РегистрСведений.AVS_СоставСвязокНоменклатуры КАК Состав
        |ГДЕ
        |	Состав.Связка = &Связка";
    Запрос.УстановитьПараметр("Связка", Связка);
    
    Выборка = Запрос.Выполнить().Выбрать();
    
    // 2. Для каждого товара вызываем синхронизацию
    Пока Выборка.Следующий() Цикл
        ЗаполнитьХарактеристикиИзДопСведений(Связка, Выборка.Товар, Выборка.Порядок);
    КонецЦикла;
    
    // 3. Регистрируем изменение для всей группы (событие GROUP_LINK_CHANGE)
    //ЗарегистрироватьИзменениеСвязки(Связка);
    
КонецПроцедуры

// { ПРАВКА_НАЧАЛО: Метод полного удаления связки }
// Полностью удаляет группу вариаций, очищая все связанные регистры.
// Параметры:
//  Связка - СправочникСсылка.AVS_ИдентификаторыСвязок - Ссылка на удаляемую группу.
Процедура РазорватьСвязку(Связка) Экспорт
	
	Если Не ЗначениеЗаполнено(Связка) Тогда Возврат; КонецЕсли;
	
	AVS_ЗарегистрироватьИзменение(Связка, "DELETE");
	
	Попытка
		// Оповещаем сайт перед удалением
		ЗарегистрироватьИзменениеСвязки(Связка);
		
		НаборСостав = РегистрыСведений.AVS_СоставСвязокНоменклатуры.СоздатьНаборЗаписей();
		НаборСостав.Отбор.Связка.Установить(Связка);
		НаборСостав.Записать();
		
		НаборХар = РегистрыСведений.AVS_ХарактеристикиСвязок.СоздатьНаборЗаписей();
		НаборХар.Отбор.Связка.Установить(Связка);
		НаборХар.Записать();
		
		ОбъектСвязки = Связка.ПолучитьОбъект();
        Если ОбъектСвязки <> Неопределено Тогда
            ОбъектСвязки.УстановитьПометкуУдаления(Истина);
            ОбъектСвязки.Записать();
            
            Сообщить("[AVS]: Группа вариаций " + Строка(Связка) + " успешно расформирована и помечена на удаление.");
        КонецЕсли;
    Исключение
        Сообщить("[AVS ERROR]: Не удалось пометить на удаление связку: " + ОписаниеОшибки());
    КонецПопытки;
	
КонецПроцедуры
// { ПРАВКА_КОНЕЦ } 

// { ПРАВКА: Проверка готовности товара для сайта (ТЗ 1.6 + требование к связкам) }
Функция AVS_ТоварГотовКВыгрузке(Товар) Экспорт
    
    Запрос = Новый Запрос;
    Запрос.Текст = 
    "ВЫБРАТЬ ПЕРВЫЕ 1 1 
    |ИЗ РегистрСведений.AVS_СоставКатегорийНоменклатуры КАК Состав 
    |ГДЕ Состав.Номенклатура = &Товар И Состав.СвязкаАктивна = ИСТИНА";
    
    Запрос.УстановитьПараметр("Товар", Товар);
    Возврат Не Запрос.Выполнить().Пустой();
    
КонецФункции