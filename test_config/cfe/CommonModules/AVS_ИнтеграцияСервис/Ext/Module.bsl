// Преобразует значение перечисления 1С в строковый код для сайта
Функция КодТипаДляСайта(ЗначениеПеречисления) Экспорт
    
    // Используем Имя значения перечисления (оно должно совпадать с требованиями сайта)
    Если ЗначениеПеречисления = Неопределено Или ЗначениеПеречисления.Пустая() Тогда
        Возврат "string"; // Значение по умолчанию
    КонецЕсли;
    
    // Метод Метаданные().Имя вернет "string", "groupLink" и т.д.
    Возврат ЗначениеПеречисления.Метаданные().Имя;
    
КонецФункции