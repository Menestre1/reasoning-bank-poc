// [РегистрСведений.AVS_СоставСвязокНоменклатуры.Форма.ФормаЗаписи.Модуль]

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Устанавливаем фильтр при открытии, если связка уже заполнена
	AVS_УстановитьФильтрХарактеристикНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура СвязкаПриИзменении(Элемент)
	
	// Переустанавливаем фильтр, если пользователь изменил группу
	AVS_УстановитьФильтрХарактеристикНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура AVS_УстановитьФильтрХарактеристикНаСервере()
	
	// 1. Получаем массив разрешенных характеристик
	МассивРазрешенных = Новый Массив;
	
	Если ЗначениеЗаполнено(Запись.Связка) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ Характеристика ИЗ РегистрСведений.AVS_ХарактеристикиСвязок ГДЕ Связка = &Связка";
		Запрос.УстановитьПараметр("Связка", Запись.Связка);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			МассивРазрешенных.Добавить(Выборка.Характеристика);
		КонецЦикла;
	КонецЕсли;
	
	// 2. Формируем фиксированный массив параметров выбора
	// Это заставит платформу ВСЕГДА фильтровать список ПВХ по этому массиву
	НовыеПараметры = Новый Массив;
	
	Если МассивРазрешенных.Количество() > 0 Тогда
		// Создаем отбор по ссылке
		Отбор = Новый Структура("Ссылка", МассивРазрешенных);
		ПараметрОтбора = Новый ПараметрВыбора("Отбор", Отбор);
		НовыеПараметры.Добавить(ПараметрОтбора);
	КонецЕсли;
	
	// Устанавливаем параметры в элемент формы (имя элемента должно быть ХарактеристикаСвязки)
	Элементы.ХарактеристикаСвязки.ПараметрыВыбора = Новый ФиксированныйМассив(НовыеПараметры);
	
КонецПроцедуры