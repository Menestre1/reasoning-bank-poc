&Перед("ПередЗаписью")
Процедура AVS_ПередЗаписью_Характеристики(Отказ, Замещение)
	Если ОбменДанными.Загрузка Тогда Возврат; КонецЕсли;
	
	Попытка
		// 1. Собираем список категорий, в которых меняются характеристики
		СписокИзмененныхРодителей = Новый Соответствие;
		
		// Из отбора (при удалении или замещении)
		Для Каждого ЭлементОтбора Из Отбор Цикл
			Если ВРег(ЭлементОтбора.Имя) = "КАТЕГОРИЯ" И ЭлементОтбора.Использование Тогда
				СписокИзмененныхРодителей.Вставить(ЭлементОтбора.Значение, Истина);
			КонецЕсли;
		КонецЦикла;
		
		// Из новых записей
		Для Каждого Запись Из ЭтотОбъект Цикл
			Если ЗначениеЗаполнено(Запись.Категория) Тогда 
				СписокИзмененныхРодителей.Вставить(Запись.Категория, Истина); 
			КонецЕсли;
		КонецЦикла;

		// 2. Для каждой измененной категории регистрируем изменения (саму и всех потомков)
		Для Каждого Кв Из СписокИзмененныхРодителей Цикл
			КатегорияРодитель = Кв.Ключ;
			
			// Регистрация для самой категории (пропускаем, если пишем из формы, т.к. там будет UPDATE)
			Если Не ДополнительныеСвойства.Свойство("AVS_ЗаписьИзФормы") Тогда
				AVS_ОбщийМодульСайт.AVS_ЗарегистрироватьИзменение(КатегорияРодитель, "LINK_CHANGE");
			КонецЕсли;
			
			// { ПРАВКА: Регистрация для всех дочерних категорий (ТЗ 2.5) }
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ Ссылка ИЗ Справочник.AVS_КатегорииНоменклатурыСайт ГДЕ Ссылка В ИЕРАРХИИ(&Родитель) И Ссылка <> &Родитель";
			Запрос.УстановитьПараметр("Родитель", КатегорияРодитель);
			
			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл
				// Для дочерних всегда шлем LINK_CHANGE, так как их состав "виртуально" изменился
				AVS_ОбщийМодульСайт.AVS_ЗарегистрироватьИзменение(Выборка.Ссылка, "LINK_CHANGE");
			КонецЦикла;
			// { КОНЕЦ ПРАВКИ }
			
		КонецЦикла;
		
	Исключение
		ЗаписьЖурналаРегистрации("AVS.Интеграция", УровеньЖурналаРегистрации.Ошибка, , , 
			"Ошибка при каскадной регистрации характеристик: " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры