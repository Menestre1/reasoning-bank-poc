// { ПРАВКА: Исправлено имя системного перечисления на ХешФункция (стандарт платформы 8.3) }
Функция AVS_СтрокаВGUID(Знач Текст)
	
	Если ПустаяСтрока(Текст) Тогда Возврат ""; КонецЕсли;
	
	Попытка
		// Используем MD5 для получения стабильного хэша. 
		// ПРАВИЛЬНО: ХешФункция.MD5
		Хеширование = Новый ХешированиеДанных(ХешФункция.MD5);
		Хеширование.Добавить(Текст);
		
		// Получаем шестнадцатеричную строку из двоичных данных
		ХешСумма = СтрЗаменить(Строка(Хеширование.ХешСумма), " ", "");
		
		// Форматируем хэш в стандартный вид GUID: 8-4-4-4-12
		Результат = НРег(СтрШаблон("%1-%2-%3-%4-%5",
			Сред(ХешСумма, 1, 8),
			Сред(ХешСумма, 9, 4),
			Сред(ХешСумма, 13, 4),
			Сред(ХешСумма, 17, 4),
			Сред(ХешСумма, 21, 12)));
			
		Возврат Результат;
	Исключение
		// Если по какой-то причине хэширование недоступно, возвращаем пустую строку, 
		// чтобы не прерывать выгрузку, но фиксируем ошибку.
		Сообщить("[AVS ERROR]: Ошибка генерации GUID для '" + Текст + "': " + ОписаниеОшибки());
		Возврат "";
	КонецПопытки;
	
КонецФункции

// Выгружает объекты, помеченные в журнале как DELETE (ТЗ 2.1)
Процедура ВыгрузитьУдаленныеОбъекты(Параметры)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Рег.Объект КАК Объект
	|ИЗ
	|	РегистрСведений.AVS_РегистрИзмененийКатегорийСайта КАК Рег
	|ГДЕ
	|	Рег.ВидСобытия = ЗНАЧЕНИЕ(Перечисление.AVS_ВидСобытия.DELETE)";
	
	Запрос.УстановитьПараметр("ДатаС", Параметры.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаПо", Параметры.ДатаОкончания);
	
	Выборка = Запрос.Выполнить().Выбрать();
	МассивУдаленных = Новый Массив;
	
	Пока Выборка.Следующий() Цикл
		// ТЗ 2.1: Выгружается JSON с пометкой "deleted": true
		Данные = Новый Структура("id, deleted", 
			AVS_ВыгрузкаНаСайт.AVS_ПреобразоватьЗначениеДляJSON(Выборка.Объект), Истина);
		МассивУдаленных.Добавить(Данные);
	КонецЦикла;
	
	Если МассивУдаленных.Количество() > 0 Тогда
		СохранитьФайл("deleted.json", AVS_ВыгрузкаНаСайт.СформироватьJSONСтроку(МассивУдаленных));
		ДобавитьВЛог("Выгружено удалений: " + МассивУдаленных.Количество());
	КонецЕсли;
	
КонецПроцедуры

  #КонецОбласти  
  
  #Область Предпросмотр
  // Функция собирает данные для предпросмотра без формирования JSON
// Функция собирает данные для предпросмотра (только строки)
Функция ПолучитьДанныеДляПредпросмотра(Параметры) Экспорт
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("ТипОбъекта", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Объект",      Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("GUID",        Новый ОписаниеТипов("Строка"));

	// 1. Категории
	МассивКат = ОпределитьСписокКатегорий(Параметры);
	Для Каждого Ссылка Из МассивКат Цикл
		НоваяСтр = Таблица.Добавить();
		НоваяСтр.ТипОбъекта = "Категория";
		НоваяСтр.Объект     = Строка(Ссылка);
		НоваяСтр.GUID       = AVS_ВыгрузкаНаСайт.AVS_ПреобразоватьЗначениеДляJSON(Ссылка);
	КонецЦикла;

	// 2. Товары
	МассивТов = ОпределитьСписокТоваров(Параметры, МассивКат);
	Для Каждого Ссылка Из МассивТов Цикл
		НоваяСтр = Таблица.Добавить();
		НоваяСтр.ТипОбъекта = "Товар";
		НоваяСтр.Объект     = Строка(Ссылка);
		НоваяСтр.GUID       = AVS_ВыгрузкаНаСайт.AVS_ПреобразоватьЗначениеДляJSON(Ссылка);
	КонецЦикла;
	
	// 3. Характеристики (ПВХ)
	ЗапросХар = Новый Запрос;
	ЗапросХар.Текст = "ВЫБРАТЬ Ссылка, Заголовок ИЗ ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения ГДЕ AVS_ВыгружатьНаСайт = ИСТИНА";
	Если Параметры.Режим = 1 Тогда // По изменениям
		ЗапросХар.Текст = ЗапросХар.Текст + " И Ссылка В (ВЫБРАТЬ Объект ИЗ РегистрСведений.AVS_РегистрИзмененийКатегорийСайта)";
	ИначеЕсли Параметры.Режим = 2 Тогда // Тест
		МассивВсехКатДляПоиска = Новый Массив;
		Для Каждого Кат Из МассивКат Цикл
			// Получаем массив родителей для каждой категории ветки
			Родители = AVS_ВыгрузкаНаСайт.AVS_ПолучитьМассивРодителей(Кат);
			Для Каждого Род Из Родители Цикл
				Если МассивВсехКатДляПоиска.Найти(Род) = Неопределено Тогда 
					МассивВсехКатДляПоиска.Добавить(Род); 
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		
		ЗапросХар.Текст = ЗапросХар.Текст + " И Ссылка В (ВЫБРАТЬ Свойство ИЗ РегистрСведений.AVS_ХарактеристикиКатегорий ГДЕ Категория В (&МассивКат))";
		ЗапросХар.УстановитьПараметр("МассивКат", МассивВсехКатДляПоиска);
	КонецЕсли;
	
	ВыборкаХар = ЗапросХар.Выполнить().Выбрать();
	КолХар = 0;
	Пока ВыборкаХар.Следующий() Цикл
		НоваяСтр = Таблица.Добавить();
		НоваяСтр.ТипОбъекта = "Характеристика";
		НоваяСтр.Объект     = ВыборкаХар.Заголовок;
		НоваяСтр.GUID       = AVS_ВыгрузкаНаСайт.AVS_ПреобразоватьЗначениеДляJSON(ВыборкаХар.Ссылка);
		КолХар = КолХар + 1;
	КонецЦикла;
	
	// 4. Связки (Bundles) 
	ЗапросСвязки = Новый Запрос;
	Если Параметры.Режим = 0 Тогда // Полная: Все неудаленные связки
		ЗапросСвязки.Текст = "ВЫБРАТЬ Ссылка, Наименование КАК Наим ИЗ Справочник.AVS_ИдентификаторыСвязок ГДЕ НЕ ПометкаУдаления";
	ИначеЕсли Параметры.Режим = 1 Тогда // Изменения: Только метаданные связок (UPDATE в РИКС)
		ЗапросСвязки.Текст = 
			"ВЫБРАТЬ РАЗЛИЧНЫЕ Рег.Объект КАК Ссылка, Рег.Объект.Наименование КАК Наим 
			|ИЗ РегистрСведений.AVS_РегистрИзмененийКатегорийСайта КАК Рег 
			|ГДЕ Рег.Объект ССЫЛКА Справочник.AVS_ИдентификаторыСвязок 
			|  И (Рег.ВидСобытия = ЗНАЧЕНИЕ(Перечисление.AVS_ВидСобытия.UPDATE) 
			|      ИЛИ Рег.ВидСобытия = ЗНАЧЕНИЕ(Перечисление.AVS_ВидСобытия.INSERT))";
	ИначеЕсли Параметры.Режим = 2 И МассивТов.Количество() > 0 Тогда // Тест: Связки товаров категории
		ЗапросСвязки.Текст = 
			"ВЫБРАТЬ РАЗЛИЧНЫЕ Состав.Связка КАК Ссылка, Состав.Связка.Наименование КАК Наим 
			|ИЗ РегистрСведений.AVS_СоставСвязокНоменклатуры КАК Состав ГДЕ Состав.Товар В (&МассивТоваров)";
		ЗапросСвязки.УстановитьПараметр("МассивТоваров", МассивТов);
	КонецЕсли;
	
	КолСвязок = 0;
	Если ЗначениеЗаполнено(ЗапросСвязки.Текст) Тогда
		ВыборкаСвязок = ЗапросСвязки.Выполнить().Выбрать();
		Пока ВыборкаСвязок.Следующий() Цикл
			НоваяСтр = Таблица.Добавить();
			НоваяСтр.ТипОбъекта = "Связка";
			НоваяСтр.Объект     = ?(ПустаяСтрока(ВыборкаСвязок.Наим), "<Без названия>", ВыборкаСвязок.Наим);
			НоваяСтр.GUID       = AVS_ВыгрузкаНаСайт.AVS_ПреобразоватьЗначениеДляJSON(ВыборкаСвязок.Ссылка);
			КолСвязок = КолСвязок + 1;
		КонецЦикла;
	КонецЕсли;
	
	// 5. Удаленные объекты (только для режима изменений)
	КолУдаленных = 0;
	Если Параметры.Режим = 1 Тогда
		ЗапросУдл = Новый Запрос(
		"ВЫБРАТЬ Объект, ВидСобытия ИЗ РегистрСведений.AVS_РегистрИзмененийКатегорийСайта 
		|ГДЕ ВидСобытия = ЗНАЧЕНИЕ(Перечисление.AVS_ВидСобытия.DELETE)");
		ВыборкаУдл = ЗапросУдл.Выполнить().Выбрать();
		Пока ВыборкаУдл.Следующий() Цикл
			НоваяСтр = Таблица.Добавить();
			
			// { ПРАВКА: Определение реального типа объекта вместо жесткого "УДАЛЕНИЕ" }
			ТекОбъект = ВыборкаУдл.Объект;
			ТекТип = "Прочее";
			
			Если ТипЗнч(ТекОбъект) = Тип("СправочникСсылка.Номенклатура") Тогда
				ТекТип = "Товар";
			ИначеЕсли ТипЗнч(ТекОбъект) = Тип("СправочникСсылка.AVS_КатегорииНоменклатурыСайт") Тогда
				ТекТип = "Категория";
			ИначеЕсли ТипЗнч(ТекОбъект) = Тип("СправочникСсылка.AVS_ИдентификаторыСвязок") Тогда
				ТекТип = "Связка";
			ИначеЕсли ТипЗнч(ТекОбъект) = Тип("ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения") Тогда
				ТекТип = "Характеристика";
			КонецЕсли;

			// Выводим тип и добавляем маркер удаления, чтобы в предпросмотре было наглядно
			НоваяСтр.ТипОбъекта = ТекТип + " (УДАЛЕНИЕ)"; 
			
			НоваяСтр.Объект     = Строка(ТекОбъект);
			НоваяСтр.GUID       = AVS_ВыгрузкаНаСайт.AVS_ПреобразоватьЗначениеДляJSON(ТекОбъект);
			КолУдаленных = КолУдаленных + 1;
		КонецЦикла;
	КонецЕсли;

	// Преобразуем ТаблицуЗначений в Массив структур (чтобы передать на клиент)
	МассивДляКлиента = Новый Массив;
	Для Каждого Стр Из Таблица Цикл
		СтруктураСтроки = Новый Структура("ТипОбъекта, Объект, GUID");
		ЗаполнитьЗначенияСвойств(СтруктураСтроки, Стр);
		МассивДляКлиента.Добавить(СтруктураСтроки);
	КонецЦикла;

	Итоги = Новый Структура;
	Итоги.Вставить("Список",            МассивДляКлиента); // Теперь это массив, он пройдет
	Итоги.Вставить("КолХарактеристик",  КолХар);
	Итоги.Вставить("КолКатегорий",      МассивКат.Количество());
	Итоги.Вставить("КолТоваров",        МассивТов.Количество());
	Итоги.Вставить("КолСвязок",         КолСвязок);
	Итоги.Вставить("КолУдаленных",      КолУдаленных);
	
	Возврат Итоги;
КонецФункции

#КонецОбласти 



