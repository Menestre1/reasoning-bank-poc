// { AVS: Внешняя обработка выгрузки данных }

Перем Лог;
Перем СписокФайловДляСкачивания;

Процедура ВыполнитьВыгрузку(ПараметрыВыгрузки) Экспорт
	
	// В процедуру ВыполнитьВыгрузку добавлена инициализация списка
СписокФайловДляСкачивания = Новый СписокЗначений;
	
	Лог = Новый СписокЗначений;
	ДобавитьВЛог("--- Запуск выгрузки ---");
	
	Попытка
		// 1. Характеристики (features) — ТЗ 2.4 приоритет 1
		МассивКатегорий = ОпределитьСписокКатегорий(ПараметрыВыгрузки);
		JSON_Метаданные = ВыгрузитьМетаданныеХарактеристик(ПараметрыВыгрузки, МассивКатегорий);
		Если ЗначениеЗаполнено(JSON_Метаданные) Тогда
			СохранитьФайл("features.json", JSON_Метаданные);
		КонецЕсли;

		// 2. Категории (categories) — ТЗ 2.4 приоритет 2
		Если МассивКатегорий.Количество() > 0 Тогда
			JSON_Категории = AVS_ВыгрузкаНаСайт.ВыгрузитьКатегории(МассивКатегорий);
			СохранитьФайл("categories.json", JSON_Категории);
			ДобавитьВЛог("Выгружено категорий: " + МассивКатегорий.Количество());
		КонецЕсли;
		
		// 3. Товары (products) — ТЗ 2.4 приоритет 3
		МассивТоваров = ОпределитьСписокТоваров(ПараметрыВыгрузки, МассивКатегорий);
		Если МассивТоваров.Количество() > 0 Тогда
			// Вызываем новую функцию с сокращенным форматом
			JSON_Товары = AVS_ВыгрузкаНаСайт.AVS_ВыгрузитьТовары(МассивТоваров);
			СохранитьФайл("products.json", JSON_Товары);
			ДобавитьВЛог("Выгружено товаров: " + МассивТоваров.Количество());
		КонецЕсли;

		// 4. Связки (bundles) — ТЗ 2.4 приоритет 4
		МассивСвязок = ОпределитьСписокСвязок(ПараметрыВыгрузки, МассивТоваров);
		Если МассивСвязок.Количество() > 0 Тогда
			JSON_Связки = AVS_ВыгрузкаНаСайт.AVS_ВыгрузитьСвязкиПоСписку(МассивСвязок);
			Если JSON_Связки <> "[]" Тогда
				СохранитьФайл("bundles.json", JSON_Связки);
				ДобавитьВЛог("[AVS DEBUG]: Выгрузка связок (bundles) завершена.");
			КонецЕсли;
		КонецЕсли;
		
		Если ПараметрыВыгрузки.Режим = 1 Тогда // Только в режиме "По изменениям"
		ВыгрузитьУдаленныеОбъекты(ПараметрыВыгрузки);
	КонецЕсли;
		
		// Очистка регистра (ТЗ 2.3)
		Если ПараметрыВыгрузки.ОчиститьРегистр Тогда
			ОчиститьЖурналИзменений(ПараметрыВыгрузки);
		КонецЕсли;
		
		ДобавитьВЛог("--- Выгрузка завершена успешно ---");
		
	Исключение
		ТекстОшибки = "[AVS ERROR]: " + ОписаниеОшибки();
		ДобавитьВЛог(ТекстОшибки);
		Сообщить(ТекстОшибки);
	КонецПопытки;

КонецПроцедуры

#Область СлужебныйПрограммныйИнтерфейс

Функция ОпределитьСписокКатегорий(Параметры)
	
	Массив = Новый Массив;
	Если Параметры.Режим = 0 Тогда // Полная
		Запрос = Новый Запрос("ВЫБРАТЬ Ссылка ИЗ Справочник.AVS_КатегорииНоменклатурыСайт ГДЕ НЕ ПометкаУдаления");
		Массив = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	ИначеЕсли Параметры.Режим = 1 Тогда // Изменения (БЕЗ ПЕРИОДА)
		Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗЛИЧНЫЕ Рег.Объект КАК Ссылка ИЗ РегистрСведений.AVS_РегистрИзмененийКатегорийСайта КАК Рег 
		|ГДЕ Рег.Объект ССЫЛКА Справочник.AVS_КатегорииНоменклатурыСайт И Рег.ВидСобытия <> ЗНАЧЕНИЕ(Перечисление.AVS_ВидСобытия.DELETE)");
		Массив = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	Иначе // Тест
		л_ВключатьПодкатегории = Ложь; // Значение по умолчанию
		Если ТипЗнч(Параметры) = Тип("Структура") И Параметры.Свойство("ВключатьПодкатегории") Тогда
			л_ВключатьПодкатегории = Параметры.ВключатьПодкатегории;
		КонецЕсли;
		
		ТекстЗапроса = "ВЫБРАТЬ Ссылка ИЗ Справочник.AVS_КатегорииНоменклатурыСайт ГДЕ НЕ ПометкаУдаления И " + // Добавлен фильтр
			?(л_ВключатьПодкатегории, "Ссылка В ИЕРАРХИИ(&Корневая)", "Ссылка = &Корневая");
			
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.УстановитьПараметр("Корневая", Параметры.КорневаяКатегория);
		Массив = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	КонецЕсли;
	Возврат Массив;
КонецФункции

Функция ОпределитьСписокТоваров(Параметры, МассивКатегорий)
	Массив = Новый Массив;
	Если Параметры.Режим = 0 Тогда // Полная
		Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ Номенклатура ИЗ РегистрСведений.AVS_СоставКатегорийНоменклатуры ГДЕ СвязкаАктивна = ИСТИНА");
		Массив = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Номенклатура");
	ИначеЕсли Параметры.Режим = 1 Тогда // Изменения (БЕЗ ПЕРИОДА)
		Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗЛИЧНЫЕ Рег.Объект КАК Ссылка ИЗ РегистрСведений.AVS_РегистрИзмененийКатегорийСайта КАК Рег 
		|ГДЕ Рег.Объект ССЫЛКА Справочник.Номенклатура И Рег.ВидСобытия <> ЗНАЧЕНИЕ(Перечисление.AVS_ВидСобытия.DELETE)");
		Массив = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	Иначе // Тест
		Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ Номенклатура ИЗ РегистрСведений.AVS_СоставКатегорийНоменклатуры ГДЕ Категория В (&Массив) И СвязкаАктивна = ИСТИНА");
		Запрос.УстановитьПараметр("Массив", МассивКатегорий);
		Массив = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Номенклатура");
	КонецЕсли;
	Возврат Массив;
	
КонецФункции

// Определяет список связок согласно новой логике событий (ТЗ 17.04)
Функция ОпределитьСписокСвязок(Параметры, МассивТоваров = Неопределено) 
	
	Массив = Новый Массив;
	Запрос = Новый Запрос;
	
	Если Параметры.Режим = 0 Тогда // Полная выгрузка
		// Собираем ВСЕ существующие связки напрямую из справочника
		Запрос.Текст = "ВЫБРАТЬ Ссылка ИЗ Справочник.AVS_ИдентификаторыСвязок ГДЕ НЕ ПометкаУдаления";
		Массив = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
		
	ИначеЕсли Параметры.Режим = 1 Тогда // По изменениям
		// Собираем только те связки, у которых в РИКС зарегистрировано событие UPDATE (изменение метаданных)
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗЛИЧНЫЕ Рег.Объект КАК Ссылка 
			|ИЗ РегистрСведений.AVS_РегистрИзмененийКатегорийСайта КАК Рег 
			|ГДЕ Рег.Объект ССЫЛКА Справочник.AVS_ИдентификаторыСвязок 
			|  И (Рег.ВидСобытия = ЗНАЧЕНИЕ(Перечисление.AVS_ВидСобытия.UPDATE) 
			|      ИЛИ Рег.ВидСобытия = ЗНАЧЕНИЕ(Перечисление.AVS_ВидСобытия.INSERT))";
		Массив = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
		
	ИначеЕсли Параметры.Режим = 2 Тогда // Тестовая выгрузка
		// Собирает связки, в которых участвуют товары выгружаемой категории
		Если МассивТоваров <> Неопределено И МассивТоваров.Количество() > 0 Тогда
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗЛИЧНЫЕ Состав.Связка КАК Ссылка 
				|ИЗ РегистрСведений.AVS_СоставСвязокНоменклатуры КАК Состав 
				|ГДЕ Состав.Товар В (&МассивТоваров)";
			Запрос.УстановитьПараметр("МассивТоваров", МассивТоваров);
			Массив = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
		КонецЕсли;
	КонецЕсли;
	
	Возврат Массив;
	
КонецФункции

// { ПРАВКА: Исправлена ошибка запроса с полями неограниченной длины (ТЗ 2.2) }

Функция ВыгрузитьМетаданныеХарактеристик(Параметры, МассивКатегорий = Неопределено)
	
	Режим = Параметры.Режим;
	НужнаФильтрация = (Режим <> 0); // Добавлено определение переменной
	
	Попытка
		// 1. Если режим "По изменениям" и изменений ПВХ нет - файл НЕ создаем
		Если Режим = 1 Тогда
			ЗапросЧек = Новый Запрос(
			"ВЫБРАТЬ ПЕРВЫЕ 1 1 ИЗ РегистрСведений.AVS_РегистрИзмененийКатегорийСайта КАК Рег 
			|ГДЕ ТИПЗНАЧЕНИЯ(Рег.Объект) = ТИП(ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения)");
			Если ЗапросЧек.Выполнить().Пустой() Тогда Возврат ""; КонецЕсли;
		КонецЕсли;

		// 2. Подготовка фильтра категорий (только для режима Тест)
		МассивДляЗапроса = Новый Массив;
		Если Режим = 2 И МассивКатегорий <> Неопределено Тогда
			Для Каждого Кат Из МассивКатегорий Цикл
				Родители = AVS_ВыгрузкаНаСайт.AVS_ПолучитьМассивРодителей(Кат);
				Для Каждого Род Из Родители Цикл
					Если МассивДляЗапроса.Найти(Род) = Неопределено Тогда МассивДляЗапроса.Добавить(Род); КонецЕсли;
				КонецЦикла;
			КонецЦикла;
		КонецЕсли;

		// 3. Запрос метаданных
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ Рег.Объект КАК Свойство ПОМЕСТИТЬ втИзмененияПВХ
		|ИЗ РегистрСведений.AVS_РегистрИзмененийКатегорийСайта КАК Рег
		|ГДЕ ТИПЗНАЧЕНИЯ(Рег.Объект) = ТИП(ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения);
		|
		|ВЫБРАТЬ ХарКат.Свойство КАК Свойство, МИНИМУМ(ХарКат.ПорядокСортировки) КАК МинПорядок ПОМЕСТИТЬ втПорядки
		|ИЗ РегистрСведений.AVS_ХарактеристикиКатегорий КАК ХарКат
		|ГДЕ (&Режим <> 2 ИЛИ ХарКат.Категория В (&МассивКатегорий)) 
		|СГРУППИРОВАТЬ ПО ХарКат.Свойство;
		|
		|ВЫБРАТЬ Свойства.Ссылка, Свойства.Заголовок КАК name, Свойства.AVS_ГруппаХарактеристик КАК group_name,
		|Свойства.AVS_ТипЗначенияХарактеристики КАК ТипЗначения, Свойства.AVS_ВариантыЗначений КАК options_json, ЕСТЬNULL(втПорядки.МинПорядок, 0) КАК Порядок
		|ИЗ ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения КАК Свойства
		|ЛЕВОЕ СОЕДИНЕНИЕ втПорядки КАК втПорядки ПО Свойства.Ссылка = втПорядки.Свойство
		|ГДЕ Свойства.AVS_ВыгружатьНаСайт = ИСТИНА 
		|И (
		|    &Режим = 0 
		|    ИЛИ (&Режим = 1 И Свойства.Ссылка В (ВЫБРАТЬ Свойство ИЗ втИзмененияПВХ))
		|    ИЛИ (&Режим = 2 И Свойства.Ссылка В (ВЫБРАТЬ Свойство ИЗ втПорядки))
		|)";
		
		Запрос.УстановитьПараметр("Режим", Режим);
		Запрос.УстановитьПараметр("МассивКатегорий", МассивДляЗапроса);
		
		ТаблицаХарактеристик = Запрос.Выполнить().Выгрузить();
		Если НужнаФильтрация И ТаблицаХарактеристик.Количество() = 0 Тогда Возврат ""; КонецЕсли;

		// Формирование JSON
		МассивГрупп = Новый Массив; УникальныеГруппы = Новый Соответствие;
		Для Каждого Стр Из ТаблицаХарактеристик Цикл
			Если ПустаяСтрока(Стр.group_name) Или УникальныеГруппы[Стр.group_name] <> Неопределено Тогда Продолжить; КонецЕсли;
			МассивГрупп.Добавить(Новый Структура("id, name", AVS_СтрокаВGUID(Стр.group_name), Стр.group_name));
			УникальныеГруппы.Вставить(Стр.group_name, Истина);
		КонецЦикла;
		
		МассивХар = Новый Массив;
		Для Каждого Стр Из ТаблицаХарактеристик Цикл
			КодТипа = AVS_ВыгрузкаНаСайт.AVS_ПолучитьКодТипаНаСервере(Стр.ТипЗначения);
			СтруктураХар = Новый Структура("id, name, sort, group_id, value_type", 
				AVS_ВыгрузкаНаСайт.AVS_ПреобразоватьЗначениеДляJSON(Стр.Ссылка), Стр.name, Строка(Стр.Порядок), 
				AVS_СтрокаВGUID(Стр.group_name), КодТипа);
			Если (Найти(КодТипа, "option") > 0) И ЗначениеЗаполнено(Стр.options_json) Тогда
				СтруктураХар.Вставить("options", AVS_ВыгрузкаНаСайт.ПрочитатьJSONСтроку(Стр.options_json));
			КонецЕсли;
			МассивХар.Добавить(СтруктураХар);
		КонецЦикла;
		
		Возврат AVS_ВыгрузкаНаСайт.СформироватьJSONСтроку(Новый Структура("groups, features", МассивГрупп, МассивХар));
		
	Исключение
		ДобавитьВЛог("[AVS ERROR]: Ошибка выгрузки метаданных: " + ОписаниеОшибки()); Возврат "";
	КонецПопытки;
КонецФункции

Процедура ОчиститьЖурналИзменений(Параметры)
	Попытка
		НачатьТранзакцию();
		
		// 1. Очистка изменений категорий
		Запрос = Новый Запрос("ВЫБРАТЬ Период, Объект, ВидСобытия ИЗ РегистрСведений.AVS_РегистрИзмененийКатегорийСайта");
		Запрос.УстановитьПараметр("ДатаС", Параметры.ДатаНачала);
		Запрос.УстановитьПараметр("ДатаПо", Параметры.ДатаОкончания);
		Выборка = Запрос.Выполнить().Выбрать();
		Счетчик = 0;
        Пока Выборка.Следующий() Цикл
            Менеджер = РегистрыСведений.AVS_РегистрИзмененийКатегорийСайта.СоздатьМенеджерЗаписи();
            Менеджер.Объект = Выборка.Объект;
			Менеджер.Период = Выборка.Период;
            Менеджер.ВидСобытия = Выборка.ВидСобытия;
            Менеджер.Удалить();
            Счетчик = Счетчик + 1;
        КонецЦикла;
        
        ДобавитьВЛог("[AVS_DEBUG]   Удалено записей из основного регистра: " + Счетчик);
        
        // 2. Очистка изменений товаров (если регистр существует)
        Попытка
            МетаРегистрТовары = Метаданные.НайтиПоПолномуИмени("РегистрСведений.AVS_РегистрИзмененийТоваровСайта");
            Если МетаРегистрТовары <> Неопределено Тогда
                Запрос.Текст = "ВЫБРАТЬ Номенклатура, ВидСобытия, Период ИЗ РегистрСведений.AVS_РегистрИзмененийТоваровСайта";
                ВыборкаТовары = Запрос.Выполнить().Выбрать();
                
                СчетчикТовары = 0;
                Пока ВыборкаТовары.Следующий() Цикл
                    Менеджер = РегистрыСведений.AVS_РегистрИзмененийТоваровСайта.СоздатьМенеджерЗаписи();
                    ЗаполнитьЗначенияСвойств(Менеджер, ВыборкаТовары);
                    Менеджер.Удалить();
                    СчетчикТовары = СчетчикТовары + 1;
                КонецЦикла;
                
                ДобавитьВЛог("[AVS_DEBUG]   Удалено записей из регистра товаров: " + СчетчикТовары);
            КонецЕсли;
        Исключение
            ДобавитьВЛог("[AVS_WARN]   Ошибка при очистке регистра товаров (возможно, он не существует): " + ОписаниеОшибки());
        КонецПопытки;
        
        ЗафиксироватьТранзакцию();
        ДобавитьВЛог("[AVS_DEBUG] Журнал изменений за период очищен успешно");
        ДобавитьВЛог("[AVS_DEBUG] ===== КОНЕЦ ОчисткаЖурналаИзменений =====");
        
    Исключение
        Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли;
        ДобавитьВЛог("[AVS_ERROR] Ошибка очистки журнала: " + ОписаниеОшибки());
        ДобавитьВЛог("[AVS_DEBUG] ===== КОНЕЦ ОчисткаЖурналаИзменений (ОШИБКА) =====");
    КонецПопытки;
КонецПроцедуры

Процедура СохранитьФайл(ИмяФайла, Данные)
	Попытка
		// 1. Сохраняем во временный каталог сервера
		ПутьНаСервере = КаталогВременныхФайлов() + ИмяФайла;
		
		Текст = Новый ТекстовыйДокумент;
		Текст.УстановитьТекст(Данные);
		Текст.Записать(ПутьНаСервере, КодировкаТекста.UTF8);
		
		// 2. Регистрируем файл для последующей передачи на клиент
		СписокФайловДляСкачивания.Добавить(ПутьНаСервере, ИмяФайла);
		
	Исключение
		ДобавитьВЛог("Критическая ошибка записи файла " + ИмяФайла + ": " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

