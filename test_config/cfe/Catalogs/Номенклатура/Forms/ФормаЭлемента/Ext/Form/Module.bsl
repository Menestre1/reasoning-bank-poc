#Область AVS_Медиа_Интерфейс_И_Логика

&НаСервере
Процедура AVS_Медиа_ИнициализироватьВкладку()
	
	ИмяТЗ = "AVS_ТаблицаМедиа";
	
	// 1. Создание реквизитов формы (Таблица и колонки)
	Если Не AVS_РеквизитСуществует(ИмяТЗ) Тогда
		МассивДобавляемых = Новый Массив;
		МассивДобавляемых.Добавить(Новый РеквизитФормы(ИмяТЗ, Новый ОписаниеТипов("ТаблицаЗначений")));
		МассивДобавляемых.Добавить(Новый РеквизитФормы("ТипМедиа", Новый ОписаниеТипов("ПеречислениеСсылка.AVS_ТипыМедиа"), ИмяТЗ, "Тип"));
		МассивДобавляемых.Добавить(Новый РеквизитФормы("URL", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(500)), ИмяТЗ, "URL"));
		МассивДобавляемых.Добавить(Новый РеквизитФормы("Сортировка", Новый ОписаниеТипов("Число", , Новый КвалификаторыЧисла(10, 0)), ИмяТЗ, "Сорт."));
		МассивДобавляемых.Добавить(Новый РеквизитФормы("ПометкаУдаления", Новый ОписаниеТипов("Булево"), ИмяТЗ, "Скрыть"));
		МассивДобавляемых.Добавить(Новый РеквизитФормы("СсылкаНаОбъект", Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.AVS_МедиаФайлыТоваров"), ИмяТЗ, "Ссылка"));
		
		ЭтаФорма.ИзменитьРеквизиты(МассивДобавляемых);
	КонецЕсли;

	// 2. Поиск группы страниц и создание новой вкладки
		    ГруппаСтраницы = Неопределено;
	ИменаГрупп = СтрРазделить("Страницы,ГруппаСтраницы,Панель,ГруппаПанель", ",");
	Для Каждого Имя Из ИменаГрупп Цикл
		ГруппаСтраницы = Элементы.Найти(Имя);
		Если ГруппаСтраницы <> Неопределено Тогда Прервать; КонецЕсли;
	КонецЦикла;
	
	Если ГруппаСтраницы = Неопределено Тогда
		Для Каждого Элемент Из Элементы Цикл
			Если ТипЗнч(Элемент) = Тип("ГруппаФормы") И Элемент.Вид = ВидГруппыФормы.Страница Тогда
				ГруппаСтраницы = Элемент.Родитель;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	
	Если ГруппаСтраницы <> Неопределено И Элементы.Найти("AVS_СтраницаМедиа") = Неопределено Тогда
		
		СтраницаМедиа = Элементы.Добавить("AVS_СтраницаМедиа", Тип("ГруппаФормы"), ГруппаСтраницы);
		СтраницаМедиа.Вид = ВидГруппыФормы.Страница;
		СтраницаМедиа.Заголовок = "Медиа (Галерея)";
		
		// Командная панель
		Панель = Элементы.Добавить("AVS_МедиаКоманднаяПанель", Тип("ГруппаФормы"), СтраницаМедиа);
		Панель.Вид = ВидГруппыФормы.КоманднаяПанель;
		
		AVS_СоздатьКомандуИКнопку(ЭтаФорма, "AVS_МедиаДобавить", "Добавить", "AVS_МедиаДобавитьКоманда", Панель);
		AVS_СоздатьКомандуИКнопку(ЭтаФорма, "AVS_МедиаВверх", "Вверх", "AVS_МедиаВверхКоманда", Панель);
		AVS_СоздатьКомандуИКнопку(ЭтаФорма, "AVS_МедиаВниз", "Вниз", "AVS_МедиаВнизКоманда", Панель);
		AVS_СоздатьКомандуИКнопку(ЭтаФорма, "AVS_МедиаУдалить", "Удалить", "AVS_МедиаУдалитьКоманда", Панель);
		AVS_СоздатьКомандуИКнопку(ЭтаФорма, "AVS_МедиаИмпорт", "Импорт ссылок", "AVS_МедиаИмпортКоманда", Панель);
		
		// Сетка таблицы
		Таблица = Элементы.Добавить("AVS_ТаблицаМедиаСетка", Тип("ТаблицаФормы"), СтраницаМедиа);
		Таблица.ПутьКДанным = ИмяТЗ;
		Таблица.ПоложениеКоманднойПанели = ПоложениеКоманднойПанелиЭлементаФормы.Нет;
		
		Таблица.ТолькоПросмотр = Ложь;
		
		// Создаем структуру события
		СобытияМедиа = Новый Структура("ПриИзменении", "AVS_Медиа_ПриИзмененииДанных");

		AVS_ДФИ.СздКолонкаТаблицыФормы(ЭтаФорма, "AVS_МедиаТип", Таблица, 0, "Тип", ИмяТЗ + ".ТипМедиа", , , , СобытияМедиа);
		AVS_ДФИ.СздКолонкаТаблицыФормы(ЭтаФорма, "AVS_МедиаURL", Таблица, 0, "URL медиа-файла", ИмяТЗ + ".URL", , , , СобытияМедиа);
		AVS_ДФИ.СздКолонкаТаблицыФормы(ЭтаФорма, "AVS_МедиаСортировка", Таблица, 0, "Сорт.", ИмяТЗ + ".Сортировка", , , , СобытияМедиа);
		
		КолСкрыть = Элементы.Добавить("AVS_МедиаСкрыть", Тип("ПолеФормы"), Таблица);
		КолСкрыть.Вид = ВидПоляФормы.ПолеФлажка;
		КолСкрыть.ПутьКДанным = ИмяТЗ + ".ПометкаУдаления";
		КолСкрыть.Заголовок = "Скрыть";
		
		Элементы.AVS_МедиаURL.УстановитьДействие("ПриИзменении", "AVS_Медиа_ПриИзмененииДанных");
		Элементы.AVS_МедиаТип.УстановитьДействие("ПриИзменении", "AVS_Медиа_ПриИзмененииДанных");
		
		// для флажка Скрыть модифицированность
		КолСкрыть = Элементы.Найти("AVS_МедиаСкрыть");
			Если КолСкрыть <> Неопределено Тогда
    			КолСкрыть.УстановитьДействие("ПриИзменении", "AVS_Медиа_ПриИзмененииДанных");
			КонецЕсли;
	КонецЕсли;
	
	AVS_Медиа_ЗагрузитьДанные();
КонецПроцедуры

&НаСервере
Процедура AVS_Медиа_ЗагрузитьДанные()
	Если Объект.Ссылка.Пустая() Тогда Возврат; КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Медиа.AVS_ТипМедиа КАК ТипМедиа,
		|	Медиа.AVS_URL КАК URL,
		|	Медиа.AVS_Сортировка КАК Сортировка,
		|	Медиа.ПометкаУдаления КАК ПометкаУдаления,
		|	Медиа.Ссылка КАК СсылкаНаОбъект
		|ИЗ
		|	ПланВидовХарактеристик.AVS_МедиаФайлыТоваров КАК Медиа
		|ГДЕ
		|	Медиа.AVS_Номенклатура = &Номенклатура
		|УПОРЯДОЧИТЬ ПО Сортировка";
	
	Запрос.УстановитьПараметр("Номенклатура", Объект.Ссылка);
	ЭтаФорма.AVS_ТаблицаМедиа.Загрузить(Запрос.Выполнить().Выгрузить());
КонецПроцедуры

&НаСервере
Процедура AVS_Медиа_СохранитьДанные(ТоварСсылка)
	Если ТоварСсылка.Пустая() Тогда Возврат; КонецЕсли;
	
	// 1. Получаем текущие записи
	Запрос = Новый Запрос("ВЫБРАТЬ Ссылка ИЗ ПланВидовХарактеристик.AVS_МедиаФайлыТоваров ГДЕ AVS_Номенклатура = &Номенклатура");
	Запрос.УстановитьПараметр("Номенклатура", ТоварСсылка);
	ТаблицаБазы = Запрос.Выполнить().Выгрузить();
	
	// 2. Запись данных
	Для Каждого СтрФормы Из ЭтаФорма.AVS_ТаблицаМедиа Цикл
		
		Если СтрФормы.СсылкаНаОбъект.Пустая() Тогда
			ОбъектМедиа = ПланыВидовХарактеристик.AVS_МедиаФайлыТоваров.СоздатьЭлемент();
			ОбъектМедиа.AVS_Номенклатура = ТоварСсылка;
		Иначе
			ОбъектМедиа = СтрФормы.СсылкаНаОбъект.ПолучитьОбъект();
			Если ОбъектМедиа = Неопределено Тогда 
				ОбъектМедиа = ПланыВидовХарактеристик.AVS_МедиаФайлыТоваров.СоздатьЭлемент();
				ОбъектМедиа.AVS_Номенклатура = ТоварСсылка;
			КонецЕсли;
			
			СтрБазы = ТаблицаБазы.Найти(СтрФормы.СсылкаНаОбъект, "Ссылка");
			Если СтрБазы <> Неопределено Тогда ТаблицаБазы.Удалить(СтрБазы); КонецЕсли;
		КонецЕсли;
		
		// Заполнение реквизитов
		ОбъектМедиа.AVS_ТипМедиа     = СтрФормы.ТипМедиа;
		ОбъектМедиа.AVS_URL          = СтрФормы.URL;
		ОбъектМедиа.AVS_Сортировка    = СтрФормы.Сортировка;
		ОбъектМедиа.ПометкаУдаления = СтрФормы.ПометкаУдаления;
		
		// Системные поля (Уникальность)
		Индекс = ЭтаФорма.AVS_ТаблицаМедиа.Индекс(СтрФормы) + 1;
		ОбъектМедиа.Наименование = Лев(СтрШаблон("%1 #%2", Строка(ТоварСсылка), Индекс), 100);
		
		// Тип значения (ОБЯЗАТЕЛЬНО для ПВХ)
		Если ОбъектМедиа.ТипЗначения.Типы().Количество() = 0 Тогда
			// Берем разрешенные типы из метаданных самого ПВХ
			ОбъектМедиа.ТипЗначения = ОбъектМедиа.Метаданные().ТипЗначения;
		КонецЕсли;
		
		// Код (ОБЯЗАТЕЛЬНО, если автонумерация в метаданных выключена)
		Если ОбъектМедиа.Метаданные().ДлинаКода > 0 И ПустаяСтрока(ОбъектМедиа.Код) Тогда
			Попытка ОбъектМедиа.УстановитьНовыйКод(); Исключение КонецПопытки;
		КонецЕсли;

				
		Попытка
			ОбъектМедиа.Записать();
			СтрФормы.СсылкаНаОбъект = ОбъектМедиа.Ссылка;
		Исключение
			ТекстОшибки = СтрШаблон("Ошибка записи медиа (%1): %2", СтрФормы.URL, ОписаниеОшибки());
			ЗаписьЖурналаРегистрации("AVS_Медиа.Сохранение", УровеньЖурналаРегистрации.Предупреждение, , , ТекстОшибки);
		КонецПопытки;
		
	КонецЦикла;
	
	// 3. Удаление лишних
	Для Каждого СтрОстаток Из ТаблицаБазы Цикл
		ОбъектМедиа = СтрОстаток.Ссылка.ПолучитьОбъект();
		Если ОбъектМедиа <> Неопределено Тогда
			Попытка 
				ОбъектМедиа.Удалить(); 
			Исключение 
				// Если не удалилось физически (есть ссылки), помечаем на удаление
				ОбъектМедиа.УстановитьПометкуУдаления(Истина);
				ОбъектМедиа.Записать();
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура AVS_МедиаДобавитьКоманда(Команда)
	НоваяСтр = ЭтаФорма.AVS_ТаблицаМедиа.Добавить();
	НоваяСтр.ТипМедиа = ПредопределенноеЗначение("Перечисление.AVS_ТипыМедиа.Фото");
	AVS_Медиа_ПересчитатьСортировку();
	AVS_Медиа_ПометитьИзмененным();
КонецПроцедуры

&НаКлиенте
Процедура AVS_МедиаВверхКоманда(Команда)
	ТекДанные = Элементы.AVS_ТаблицаМедиаСетка.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда Возврат; КонецЕсли;
	
	ТаблицаМедиа = ЭтаФорма.AVS_ТаблицаМедиа;
	Индекс = ЭтаФорма.AVS_ТаблицаМедиа.Индекс(ТекДанные);
	Если Индекс > 0 Тогда
		ТаблицаМедиа.Сдвинуть(Индекс, -1);
		AVS_Медиа_ПересчитатьСортировку();
		AVS_Медиа_ПометитьИзмененным();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура AVS_МедиаВнизКоманда(Команда)
	// Получаем текущую строку из сетки таблицы
	ТекДанные = Элементы.AVS_ТаблицаМедиаСетка.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда 
		Возврат; 
	КонецЕсли;
	
	// В расширениях к динамическим реквизитам обращаемся через ЭтаФорма
	ТаблицаМедиа = ЭтаФорма.AVS_ТаблицаМедиа;
	Индекс = ТаблицаМедиа.Индекс(ТекДанные);
	
	// Проверяем, что строка не последняя
	Если Индекс < ТаблицаМедиа.Количество() - 1 Тогда
			// Сдвигаем строку на 1 позицию вниз
		ТаблицаМедиа.Сдвинуть(Индекс, 1);
			// Пересчитываем визуальный порядок (10, 20, 30...)
		AVS_Медиа_ПересчитатьСортировку();
		AVS_Медиа_ПометитьИзмененным();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура AVS_МедиаИмпортКоманда(Команда)
	Оповещение = Новый ОписаниеОповещения("AVS_Медиа_ПослеВводаСсылок", ЭтотОбъект);
	
	// Используем асинхронный метод ввода текста в режиме многострочного ввода
	ПоказатьВводСтроки(Оповещение, "", "Вставьте список URL (каждый с новой строки)", 0, Истина);
КонецПроцедуры

&НаКлиенте
Процедура AVS_МедиаУдалитьКоманда(Команда)
	
	ТекДанные = Элементы.AVS_ТаблицаМедиаСетка.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда Возврат; КонецЕсли;
	
	// Подготовка параметров для ответа
	Оповещение = Новый ОписаниеОповещения("ПослеПодтвержденияУдаленияМедиа", ЭтотОбъект, ТекДанные);
	ПоказатьВопрос(Оповещение, "Удалить медиа-файл безвозвратно?", РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеПодтвержденияУдаленияМедиа(Результат, ТекДанные) Экспорт
	
	Если Результат <> КодВозвратаДиалога.Да Тогда Возврат; КонецЕсли;
	
	//// Прямое удаление из базы данных, если объект уже был сохранен
	//Если ЗначениеЗаполнено(ТекДанные.СсылкаНаОбъект) Тогда
	//	AVS_Медиа_УдалитьФизическиНаСервере(ТекДанные.СсылкаНаОбъект);
	//КонецЕсли;
	
	// Удаление строки из таблицы формы
	ЭтаФорма.AVS_ТаблицаМедиа.Удалить(ТекДанные);
	
	AVS_Медиа_ПересчитатьСортировку();
	AVS_Медиа_ПометитьИзмененным();
	
КонецПроцедуры

&НаКлиенте
Процедура AVS_Медиа_ПослеВводаСсылок(Текст, ДопПараметры) Экспорт
	// Если пользователь нажал Отмена, Текст будет равен Неопределено
	Если Текст = Неопределено Или ПустаяСтрока(Текст) Тогда Возврат; КонецЕсли;
	
	МассивСтрок = СтрРазделить(Текст, Символы.ПС, Ложь);
	Для Каждого СтрURL Из МассивСтрок Цикл
		ТекСсылка = СокрЛП(СтрURL);
		Если ПустаяСтрока(ТекСсылка) Тогда Продолжить; КонецЕсли;
		
		НоваяСтр = ЭтаФорма.AVS_ТаблицаМедиа.Добавить();
		НоваяСтр.URL = ТекСсылка;
		НоваяСтр.ТипМедиа = ПредопределенноеЗначение("Перечисление.AVS_ТипыМедиа.Фото");
	КонецЦикла;
	
	AVS_Медиа_ПересчитатьСортировку();
	AVS_Медиа_ПометитьИзмененным();
КонецПроцедуры

&НаКлиенте
Процедура AVS_Медиа_ПересчитатьСортировку()
	Порядок = 10;
	Для Каждого Стр Из ЭтаФорма.AVS_ТаблицаМедиа Цикл
		Стр.Сортировка = Порядок;
		Порядок = Порядок + 10;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура AVS_Медиа_ПроверитьЗаполнение(Отказ)

	ИмяТЗ = "AVS_ТаблицаМедиа";
	
	Если Не AVS_РеквизитСуществует(ИмяТЗ) Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаМедиа = ЭтаФорма[ИмяТЗ];
	
	НайденныеURL = Новый Соответствие; 
	
	Для Каждого Стр Из ТаблицаМедиа Цикл
		Если Стр.ПометкаУдаления Тогда Продолжить; КонецЕсли;
		
		Индекс = ТаблицаМедиа.Индекс(Стр);
		НомерСтроки = Индекс + 1;
		ТекстURL = СокрЛП(Стр.URL);
		
		// 1. Проверка Типа
		Если Не ЗначениеЗаполнено(Стр.ТипМедиа) Тогда
			ТекстОшибки = СтрШаблон(НСтр("ru = 'В таблице медиа-файлов не заполнен тип в строке %1'"), НомерСтроки);
			ПутьКПолю   = СтрШаблон("%1[%2].ТипМедиа", ИмяТЗ, Индекс);
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, , ПутьКПолю, , Отказ);
		КонецЕсли;
		
		// 2. { ПРАВКА: Проверка уникальности внутри текущей таблицы }
		Если ЗначениеЗаполнено(ТекстURL) Тогда
			ТекКлюч = ВРег(ТекстURL);
			Если НайденныеURL[ТекКлюч] <> Неопределено Тогда
				ТекстОшибки = СтрШаблон(НСтр("ru = 'В строке %1 указан URL, который уже встречается в таблице выше!'"), НомерСтроки);
				ПутьКПолю   = СтрШаблон("%1[%2].URL", ИмяТЗ, Индекс);
				ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, , ПутьКПолю, , Отказ);
			Иначе
				НайденныеURL.Вставить(ТекКлюч, Истина);
			КонецЕсли;
		КонецЕсли;
		
		// 3. { ПРАВКА: Проверка уникальности по базе данных (для новых строк) }
		Если Не Отказ И ЗначениеЗаполнено(ТекстURL) Тогда
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ ПЕРВЫЕ 1 1 
				|ИЗ ПланВидовХарактеристик.AVS_МедиаФайлыТоваров КАК Медиа 
				|ГДЕ Медиа.AVS_Номенклатура = &Номенклатура 
				|	И Медиа.AVS_URL = &URL 
				|	И Медиа.Ссылка <> &Ссылка 
				|	И НЕ Медиа.ПометкаУдаления";
			Запрос.УстановитьПараметр("Номенклатура", Объект.Ссылка);
			Запрос.УстановитьПараметр("URL",          ТекстURL);
			Запрос.УстановитьПараметр("Ссылка",       Стр.СсылкаНаОбъект);
			
			Если Не Запрос.Выполнить().Пустой() Тогда
				ТекстОшибки = СтрШаблон(НСтр("ru = 'В строке %1 указан URL, который уже используется для этого товара в базе!'"), НомерСтроки);
				ПутьКПолю   = СтрШаблон("%1[%2].URL", ИмяТЗ, Индекс);
				ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, , ПутьКПолю, , Отказ);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура AVS_Медиа_ПриИзмененииДанных(Элемент)
	AVS_Медиа_ПометитьИзмененным();
КонецПроцедуры

&НаКлиенте
Процедура AVS_Медиа_ПометитьИзмененным()
	
	ЭтаФорма.Модифицированность = Истина;
	
	// Добавляем звездочку к заголовку вкладки, если её там еще нет
	ИмяСтраницы = "AVS_СтраницаМедиа";
	ТекЗаголовок = Элементы[ИмяСтраницы].Заголовок;
	
	Если Найти(ТекЗаголовок, "*") = 0 Тогда
		Элементы[ИмяСтраницы].Заголовок = ТекЗаголовок + " *";
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

