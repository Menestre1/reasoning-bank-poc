&НаСервере
&После("ПриСозданииНаСервере")
Процедура AVS_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	
	// { ПРАВКА_НАЧАЛО: Идемпотентное создание реквизитов и интерфейса }
	Попытка
		
		// 15.04.2026 { БЛОК_МЕДИА: Инициализация вкладки }
AVS_Медиа_ИнициализироватьВкладку();
	// конец блок медиа
		
		Сообщить("[AVS DEBUG]: Начало формирования интерфейса...");
		
		Страница = Элементы.Найти("AVS_СтраницаСвязкиИВариации");
		Если Страница = Неопределено Или Объект.Ссылка.Пустая() Тогда Возврат; КонецЕсли;

		Связка = AVS_ОбщийМодульСайт.ПолучитьИдентификаторСвязкиТовара(Объект.Ссылка);
		ИмяТЗ = "AVS_ТаблицаСоставаСвязки";

		// --- 1. ПОДГОТОВКА РЕКВИЗИТОВ (С учетом удаления лишних) ---
		МассивДобавляемых = Новый Массив;
		МассивУдаляемых   = Новый Массив; // { ПРАВКА: Добавлен массив для удаления }
		
		// Таблица и базовые колонки
		Если Не AVS_РеквизитСуществует(ИмяТЗ) Тогда
			МассивДобавляемых.Добавить(Новый РеквизитФормы(ИмяТЗ, Новый ОписаниеТипов("ТаблицаЗначений")));
			МассивДобавляемых.Добавить(Новый РеквизитФормы("Товар", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"), ИмяТЗ, "Товар"));
			МассивДобавляемых.Добавить(Новый РеквизитФормы("Порядок", Новый ОписаниеТипов("Число"), ИмяТЗ, "Порядок"));
		КонецЕсли;
		
		// Инфо-поля шапки
		Если Не AVS_РеквизитСуществует("AVS_Info_GUID") Тогда
			МассивДобавляемых.Добавить(Новый РеквизитФормы("AVS_Info_GUID", AVS_ДФИ.ОписаниеТипаСтрока(100), , "GUID группы"));
		КонецЕсли;
		Если Не AVS_РеквизитСуществует("AVS_Info_Properties") Тогда
			МассивДобавляемых.Добавить(New РеквизитФормы("AVS_Info_Properties", AVS_ДФИ.ОписаниеТипаСтрока(250), , "Характеристики"));
		КонецЕсли;
		Если Не AVS_РеквизитСуществует("AVS_Info_Count") Тогда
			МассивДобавляемых.Добавить(Новый РеквизитФормы("AVS_Info_Count", AVS_ДФИ.ОписаниеТипаЧисло(5, 0), , "Кол-во товаров"));
		КонецЕсли;
		
		// Динамические колонки характеристик
		МассивИменАктуальныхХар = Новый Массив; // { ПРАВКА: Список того, что должно остаться }
		Если ЗначениеЗаполнено(Связка) Тогда
			Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ Характеристика ИЗ РегистрСведений.AVS_ХарактеристикиСвязок ГДЕ Связка = &Связка");
			Запрос.УстановитьПараметр("Связка", Связка);
			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл
				ИмяКолонки = "Хар_" + СтрЗаменить(Строка(Выборка.Характеристика.УникальныйИдентификатор()), "-", "_");
				МассивИменАктуальныхХар.Добавить(ИмяКолонки);
				
				Если Не AVS_РеквизитСуществует(ИмяКолонки, ИмяТЗ) Тогда
					МассивДобавляемых.Добавить(Новый РеквизитФормы(ИмяКолонки, AVS_ДФИ.ОписаниеТипаСтрока(100), ИмяТЗ, Выборка.Характеристика.Заголовок));
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		// { ПРАВКА_НАЧАЛО: Поиск и удаление устаревших колонок }
		Если AVS_РеквизитСуществует(ИмяТЗ) Тогда
			РеквизитыТЗ = ЭтаФорма.ПолучитьРеквизиты(ИмяТЗ);
			Для Каждого Рек Из РеквизитыТЗ Цикл
				Если СтрНачинаетсяС(Рек.Имя, "Хар_") И МассивИменАктуальныхХар.Найти(Рек.Имя) = Неопределено Тогда
					МассивУдаляемых.Добавить(ИмяТЗ + "." + Рек.Имя);
					Сообщить("[AVS DEBUG]: Лишняя колонка '" + Рек.Имя + "' будет удалена.");
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		// { ПРАВКА_КОНЕЦ }
		
		Если МассивДобавляемых.Количество() > 0 Или МассивУдаляемых.Количество() > 0 Тогда
			Попытка
				ЭтаФорма.ИзменитьРеквизиты(МассивДобавляемых, МассивУдаляемых);
				Сообщить(СтрШаблон("[AVS DEBUG]: Структура обновлена. Добавлено: %1, Удалено: %2", 
					МассивДобавляемых.Количество(), МассивУдаляемых.Количество()));
			Исключение
				Сообщить("[AVS ERROR]: Ошибка ИзменитьРеквизиты: " + ОписаниеОшибки());
			КонецПопытки;
		КонецЕсли;

			
		// --- 3. ОТРИСОВКА БЛОКА СВЯЗОК ---
		Если Элементы.Найти("AVS_ГрСвязки") = Неопределено Тогда
			ТекстНаименования = "";
Если ЗначениеЗаполнено(Связка) Тогда
    ТекстНаименования = СокрЛП(Связка.Наименование);
    Если ПустаяСтрока(ТекстНаименования) Тогда
        ТекстНаименования = "Наименование не задано";
    КонецЕсли;
КонецЕсли;

ЗаголовокГруппы = ?(ЗначениеЗаполнено(Связка), "Состав группы вариаций """ + ТекстНаименования + """", "Связки и вариации");
ГруппаСвязки = AVS_ДФИ.СздГруппаОбычная(ЭтаФорма, "AVS_ГрСвязки", Страница, ЗаголовокГруппы, 1, 1, 1);
			
			Если ЗначениеЗаполнено(Связка) Тогда
				ГруппаИнфо = AVS_ДФИ.СздГруппаОбычнаяБезОтображения(ЭтаФорма, "AVS_ГрИнфо", ГруппаСвязки, 1);
				СвойстваИнфо = Новый Структура("ТолькоПросмотр, РастягиватьПоГоризонтали", Истина, Истина);
				AVS_ДФИ.СздПоле(ЭтаФорма, "AVS_Info_GUID_F", ГруппаИнфо, "Идентификатор группы (GUID)", 1, "AVS_Info_GUID", СвойстваИнфо);
				AVS_ДФИ.СздПоле(ЭтаФорма, "AVS_Info_Prop_F", ГруппаИнфо, "Характеристики связки", 1, "AVS_Info_Properties", СвойстваИнфо);
				AVS_ДФИ.СздПоле(ЭтаФорма, "AVS_Info_Cnt_F", ГруппаИнфо, "Кол-во товаров в группе", 1, "AVS_Info_Count", СвойстваИнфо);

				ГруппаКн = AVS_ДФИ.СздГруппаОбычнаяБезОтображения(ЭтаФорма, "AVS_ГрКн", ГруппаСвязки, 2);
				AVS_СоздатьКомандуИКнопку(ЭтаФорма, "AVS_AddOther", "Добавить товары в связку", "AVS_ДобавитьДругойТоварКоманда", ГруппаКн);
				AVS_СоздатьКомандуИКнопку(ЭтаФорма, "AVS_Выйти", "Исключить этот товар", "AVS_ВыйтиИзСвязкиКоманда", ГруппаКн);
				AVS_СоздатьКомандуИКнопку(ЭтаФорма, "AVS_ManageLink", "Управление связкой", "AVS_УправлениеСвязкойКоманда", ГруппаКн);
				AVS_СоздатьКомандуИКнопку(ЭтаФорма, "AVS_Refresh", "Обновить", "AVS_RefreshКоманда", ГруппаКн);
				
				ЭлементТаблица = AVS_ДФИ.СздТаблицаФормы(ЭтаФорма, "AVS_GridСвязки", ГруппаСвязки, ИмяТЗ);
				
				// { ПРАВКА_НАЧАЛО: Очистка панели и добавление ссылки на место кнопок }
				Попытка
					// Отключаем стандартные кнопки (освобождаем место слева)
					ЭлементТаблица.ИзменятьСоставСтрок  = Ложь; 
					ЭлементТаблица.ИзменятьПорядокСтрок = Ложь; 

					// Находим стандартную командную панель таблицы
					Панель = Элементы.Найти("AVS_GridСвязкиКоманднаяПанель");
					Если Панель <> Неопределено Тогда
						
						// Создаем команду открытия состава (если она еще не создана)
						ИмяКоманды = "AVS_ОткрытьСостав";
						Если ЭтаФорма.Команды.Найти(ИмяКоманды) = Неопределено Тогда
							AVS_ДФИ.СоздатьКоманду(ЭтаФорма, ИмяКоманды, "Состав связок номенклатуры", "AVS_ОткрытьСоставКоманда");
						КонецЕсли;
						
						// Добавляем кнопку-гиперссылку в начало панели
						ИмяКнопки = "AVS_КнСоставСвязок";
						Если Элементы.Найти(ИмяКнопки) = Неопределено Тогда
							// Определяем элемент, перед которым встать (чтобы быть крайними слева)
							ЭлементПеред = ?(Панель.ПодчиненныеЭлементы.Количество() > 0, Панель.ПодчиненныеЭлементы[0], Неопределено);
							
							// Создаем кнопку с видом "Гиперссылка" (параметр ВидКнопки = 2)
							AVS_ДФИ.СздКнопка(ЭтаФорма, ИмяКнопки, Панель, "Состав связок номенклатуры", ИмяКоманды, 2, , ЭлементПеред);
						КонецЕсли;
						
					КонецЕсли;
					
					Сообщить("[AVS DEBUG]: Интерфейс таблицы связок настроен успешно.");
					
				Исключение
					// Безопасный код: ошибка интерфейса не должна прерывать работу пользователя
					Сообщить("[AVS ERROR]: Ошибка настройки панели связок: " + ОписаниеОшибки());
				КонецПопытки;
				// { ПРАВКА_КОНЕЦ }
				
					
				AVS_ДФИ.СздКолонкаТаблицыФормы(ЭтаФорма, "ColТовар", ЭлементТаблица, 1, "Товар", ИмяТЗ + ".Товар");
				
				// Отрисовка колонок характеристик из ТЗ (безопасно)
				Для Каждого Колонка Из ЭтаФорма[ИмяТЗ].Выгрузить().Колонки Цикл
					Если СтрНачинаетсяС(Колонка.Имя, "Хар_") Тогда
						AVS_ДФИ.СздКолонкаТаблицыФормы(ЭтаФорма, "Col_" + Колонка.Имя, ЭлементТаблица, 1, Колонка.Заголовок, ИмяТЗ + "." + Колонка.Имя);
					КонецЕсли;
				КонецЦикла;
				AVS_ЗаполнитьДанныеСвязки(Связка, ИмяТЗ);
				// { ПРАВКА: Настройка выделения текущей строки }
        AVS_НастроитьУсловноеОформлениеТаблицыСвязок();
				
			Иначе
				AVS_ДФИ.СздДекорацияНадпись(ЭтаФорма, "AVS_NoLink", ГруппаСвязки, "Товар не входит в группу вариаций", Истина);
				
				// Проверяем, что товар есть на сайте (включен в какую-либо категорию)
				ТоварГотов = AVS_ОбщийМодульСайт.AVS_ТоварГотовКВыгрузке(Объект.Ссылка);
				
				Если Не ТоварГотов Тогда
					ТекстПредупреждения = "Товар не входит ни в одну категорию сайта или не настроена его видимость! Для добавления в связку или создания новой включите товар в одну из категорий сайта!";
					
					// Создаем дополнительную надпись с предупреждением
					ДекорацияИнфо = AVS_ДФИ.СздДекорацияНадпись(ЭтаФорма, "AVS_NotReadyInfo", ГруппаСвязки, ТекстПредупреждения, Истина);
					
					// Выделяем текст цветом (FireBrick / Огнеупорный кирпич)
					ДекорацияИнфо.ЦветТекста = WebЦвета.Красный; 
				КонецЕсли;
				
				
			// Группа для кнопок (горизонтальная)
				ГруппаКнВыбора = AVS_ДФИ.СздГруппаОбычнаяБезОтображения(ЭтаФорма, "AVS_ГрКнВыбора", ГруппаСвязки, 2);
				
				// Кнопка присоединения к существующей группе
				AVS_СоздатьКомандуИКнопку(ЭтаФорма, "AVS_Присоединить", "Выбрать существующую группу", "AVS_ПрисоединитьКСвязкеКоманда", ГруппаКнВыбора);
				
				// Кнопка создания новой группы
				AVS_СоздатьКомандуИКнопку(ЭтаФорма, "AVS_Создать", "Создать новую группу", "AVS_СоздатьСвязкуКоманда", ГруппаКнВыбора);
			// управление доступностью кнопок
			   Элементы.Кн_AVS_Присоединить.Доступность = ТоварГотов;
				Элементы.Кн_AVS_Создать.Доступность      = ТоварГотов;

				Сообщить(СтрШаблон("[AVS DEBUG]: Кнопки управления связками настроены. Товар готов: %1", ТоварГотов));
				
				
				
				// { ПРАВКА_КОНЕЦ }
			КонецЕсли;
		КонецЕсли;
		
			
	Исключение
		Сообщить("[AVS ERROR]: Ошибка ПриСозданииНаСервереПосле: " + ОписаниеОшибки());
	КонецПопытки;
	// { ПРАВКА_КОНЕЦ }
КонецПроцедуры

&НаСервере
&После("ОбработкаПроверкиЗаполненияНаСервере")
Процедура AVS_Медиа_ОбработкаПроверкиЗаполненияНаСервереПосле(Отказ, ПроверяемыеРеквизиты)
	
	// { БЛОК_МЕДИА: Проверка обязательных полей динамической таблицы }
	AVS_Медиа_ПроверитьЗаполнение(Отказ);
		
КонецПроцедуры

// { ПРАВКА_НАЧАЛО: Вспомогательные методы }
   &НаСервере
Процедура AVS_СоздатьКомандуИКнопку(Форма, Имя, Заголовок, Действие, Родитель)
	// Безопасное создание команды
	Если Форма.Команды.Найти(Имя) = Неопределено Тогда
		AVS_ДФИ.СоздатьКоманду(Форма, Имя, Заголовок, Действие);
	КонецЕсли;
	
	// Безопасное создание кнопки
	ИмяКнопки = "Кн_" + Имя;
	Если Форма.Элементы.Найти(ИмяКнопки) = Неопределено Тогда
		AVS_ДФИ.СздКнопка(Форма, ИмяКнопки, Родитель, Заголовок, Имя, 1);
	КонецЕсли;
КонецПроцедуры

 // { ПРАВКА_КОНЕЦ }
// --- Обработчики Связок ---

&НаКлиенте
Процедура AVS_СоздатьСвязкуКоманда(Команда)
    // Мы НЕ вызываем создание на сервере здесь. 
	// Мы просто открываем форму НОВОГО элемента справочника.
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("AVS_Источник", Объект.Ссылка);
	
	// Настраиваем оповещение, которое сработает ПРИ ЗАКРЫТИИ окна группы
	ОписаниеОповещения = Новый ОписаниеОповещения("AVS_ПослеЗакрытияОкнаГруппы", ЭтотОбъект);
	
	ОткрытьФорму("Справочник.AVS_ИдентификаторыСвязок.ФормаОбъекта", ПараметрыФормы, ЭтотОбъект, , , , ОписаниеОповещения);
КонецПроцедуры

&НаСервере
Функция AVS_СоздатьСвязкуНаСервере()
    // { ПРАВКА_НАЧАЛО: Создание группы с пустым наименованием }
    Попытка
        // 1. Создаем ID связки
        НоваяСвязка = Справочники.AVS_ИдентификаторыСвязок.СоздатьЭлемент();
    НоваяСвязка.Записать();
    
    // 2. Добавляем текущий товар как первого участника
    Менеджер = РегистрыСведений.AVS_СоставСвязокНоменклатуры.СоздатьМенеджерЗаписи();
        Менеджер.Связка = НоваяСвязка.Ссылка;
        Менеджер.Товар  = Объект.Ссылка;
        Менеджер.Порядок = 10;
        Менеджер.Записать();
        
        Сообщить("[AVS DEBUG]: Создана новая пустая группа вариаций.");
        Возврат НоваяСвязка.Ссылка;
        
    Исключение
        Сообщить("[AVS ERROR]: Не удалось создать группу: " + ОписаниеОшибки());
        Возврат Неопределено;
    КонецПопытки;
    // { ПРАВКА_КОНЕЦ }
КонецФункции

&НаСервере
Процедура AVS_ЗаполнитьДанныеСвязки(Связка, ИмяТЗ)
    
    // { ПРАВКА_НАЧАЛО: Исправление фильтрации характеристик и безопасное заполнение }
    Попытка
        Сообщить("[AVS DEBUG]: Начало синхронизации данных для связки: " + Строка(Связка));
        
        // 0. ПРОВЕРКА ДОСТУПНОСТИ ТАБЛИЦЫ НА ФОРМЕ
        // Используем встроенную проверку реквизитов (безопасный доступ)
        Попытка
            КоллекцияФормы = ЭтаФорма[ИмяТЗ];
        Исключение
            Сообщить("[AVS ERROR]: Таблица '" + ИмяТЗ + "' не найдена в реквизитах формы!");
            Возврат;
        КонецПопытки;
        
        КоллекцияФормы.Очистить();
        
        Если Не ЗначениеЗаполнено(Связка) Тогда 
            Сообщить("[AVS DEBUG]: Связка пустая, таблица очищена.");
            Возврат; 
        КонецЕсли;

        // 1. ПОЛУЧЕНИЕ АКТУАЛЬНОЙ СХЕМЫ (Только те характеристики, что выбраны для группы СЕЙЧАС)
        ЗапросСхема = Новый Запрос;
        ЗапросСхема.Текст = 
            "ВЫБРАТЬ 
            |	Характеристики.Характеристика КАК СсылкаНаПВХ,
            |	Характеристики.Характеристика.Заголовок КАК Заголовок
            |ИЗ 
            |	РегистрСведений.AVS_ХарактеристикиСвязок КАК Характеристики 
            |ГДЕ 
            |	Характеристики.Связка = &Связка 
            |УПОРЯДОЧИТЬ ПО 
            |	Характеристики.Порядок";
        
        ЗапросСхема.УстановитьПараметр("Связка", Связка);
        ТаблицаСхемы = ЗапросСхема.Выполнить().Выгрузить();
        
        // Собираем массив актуальных характеристик для фильтрации данных состава
        МассивАктуальныхХар = Новый Массив;
        СтрХар = "";
        Для Каждого СтрСхемы Из ТаблицаСхемы Цикл
            МассивАктуальныхХар.Добавить(СтрСхемы.СсылкаНаПВХ);
            СтрХар = СтрХар + ?(СтрХар = "", "", ", ") + СтрСхемы.Заголовок;
        КонецЦикла;

        // Заполнение инфо-полей шапки (с проверкой наличия полей)
        Попытка
            ЭтаФорма.AVS_Info_GUID = Строка(Связка.УникальныйИдентификатор());
            ЭтаФорма.AVS_Info_Properties = СтрХар;
        Исключение
            // Поля могут быть не созданы, если это первый запуск
        КонецПопытки;
        
        // 2. ПОЛУЧЕНИЕ ДАННЫХ СОСТАВА (Значения для каждого товара)
        Запрос = Новый Запрос;
        Запрос.Текст = 
            "ВЫБРАТЬ
            |	Состав.Товар КАК Товар,
            |	Состав.ХарактеристикаСвязки КАК Характеристика,
            |	ПРЕДСТАВЛЕНИЕ(Состав.ЗначениеХарактеристики) КАК ЗначениеТекст,
            |	Состав.Порядок КАК Порядок
            |ИЗ
            |	РегистрСведений.AVS_СоставСвязокНоменклатуры КАК Состав
            |ГДЕ
            |	Состав.Связка = &Связка
            |УПОРЯДОЧИТЬ ПО
            |	Состав.Порядок,
            |	Состав.Товар";
        
        Запрос.УстановитьПараметр("Связка", Связка);
        ДанныеРегистра = Запрос.Выполнить().Выгрузить();
        
        // Группируем по товару (одна строка в таблице = один товар)
        ТаблицаТоваров = ДанныеРегистра.Скопировать();
        ТаблицаТоваров.Свернуть("Товар, Порядок");
        ТаблицаТоваров.Сортировать("Порядок Возр");
        
        Попытка
            ЭтаФорма.AVS_Info_Count = ТаблицаТоваров.Количество();
        Исключение
        КонецПопытки;
        
        // 3. ЗАПОЛНЕНИЕ СТРОК ТАБЛИЦЫ
        Для Каждого СтрТовар Из ТаблицаТоваров Цикл
            
            НоваяСтр = КоллекцияФормы.Добавить();
            НоваяСтр.Товар = СтрТовар.Товар;
            НоваяСтр.Порядок = СтрТовар.Порядок;
            
            // Ищем все значения характеристик для этого товара
            Отбор = Новый Структура("Товар", СтрТовар.Товар);
            СтрокиЗначений = ДанныеРегистра.НайтиСтроки(Отбор);
            
            Для Каждого СтрЗначение Из СтрокиЗначений Цикл
                
                // { ИСПРАВЛЕНИЕ: Проверка на актуальность характеристики }
                // Если характеристики нет в текущей схеме группы (МассивАктуальныхХар) - игнорируем её
                Если МассивАктуальныхХар.Найти(СтрЗначение.Характеристика) = Неопределено Тогда
                    Сообщить("[AVS DEBUG]: Скрыто значение неактуальной характеристики '" + СтрЗначение.Характеристика + "' для товара " + СтрТовар.Товар);
                    Продолжить; 
                КонецЕсли;

                // Генерируем имя колонки (должно строго совпадать с логикой в ПриСозданииНаСервере)
                ИмяКолонки = "Хар_" + СтрЗаменить(Строка(СтрЗначение.Характеристика.УникальныйИдентификатор()), "-", "_");
                
                Попытка
                    НоваяСтр[ИмяКолонки] = СтрЗначение.ЗначениеТекст;
                Исключение
                    // Ошибка возникнет, если колонка не была создана в ИзменитьРеквизиты
                    Сообщить("[AVS WARNING]: Не найдена колонка '" + ИмяКолонки + "' в структуре таблицы!");
                КонецПопытки;
                
            КонецЦикла;
            
        КонецЦикла;
        
        Сообщить("[AVS DEBUG]: Синхронизация данных завершена. Товаров в таблице: " + ТаблицаТоваров.Количество());

    Исключение
        ТекстОшибки = "[AVS ERROR]: Ошибка в процедуре AVS_ЗаполнитьДанныеСвязки: " + ОписаниеОшибки();
        Сообщить(ТекстОшибки);
        AVS_Логирование.ЗаписатьВЛог(ТекстОшибки);
    КонецПопытки;
    // { ПРАВКА_КОНЕЦ }
    
КонецПроцедуры

&НаКлиенте
Процедура AVS_ДобавитьДругойТоварКоманда(Команда)
    
    // { ПРАВКА_НАЧАЛО: Команда добавления товара в текущую связку }
    
    Попытка
        Оповещение = Новый ОписаниеОповещения("AVS_ПослеВыбораТовараДляСвязки", ЭтотОбъект);
        ПараметрыФормы = Новый Структура("РежимВыбора", Истина);
		ПараметрыФормы.Вставить("МножественныйВыбор", Истина);
        ОткрытьФорму("Справочник.Номенклатура.ФормаВыбора", ПараметрыФормы, ЭтотОбъект, , , , Оповещение);
    Исключение
        Сообщить("[AVS ERROR]: Не удалось открыть форму выбора: " + ОписаниеОшибки());
    КонецПопытки;
    
    // { ПРАВКА_КОНЕЦ }
    
КонецПроцедуры

&НаКлиенте
Процедура AVS_ПослеВыбораТовараДляСвязки(Результат, ДопПараметры) Экспорт
    
    Если Результат = Неопределено Тогда Возврат; КонецЕсли;
    
    Попытка
		
		// Преобразуем результат в массив, если выбрано несколько товаров
		ВыбранныеТовары = Новый Массив;
        Если ТипЗнч(Результат) = Тип("Массив") Тогда
            ВыбранныеТовары = Результат;
        Иначе
            ВыбранныеТовары.Добавить(Результат);
        КонецЕсли;
		
		// { ПРАВКА: Обработка результата и вывод предупреждения }
        Итог = AVS_ПрисоединитьТоварКСвязкеНаСервере(ВыбранныеТовары);
        
        AVS_RefreshНаСервере();
        
        Если ЗначениеЗаполнено(Итог.Сообщение) Тогда
            ПоказатьПредупреждение(, Итог.Сообщение);
        КонецЕсли;
        
        // Оповещаем систему об изменении каждого товара
        Для Каждого ТекТовар Из ВыбранныеТовары Цикл
            ОповеститьОбИзменении(ТекТовар);
        КонецЦикла;
        
    Исключение
        Сообщить("[AVS ERROR]: Ошибка в AVS_ПослеВыбораТовараДляСвязки: " + ОписаниеОшибки());
    КонецПопытки;
    
КонецПроцедуры


&НаСервере
Функция AVS_ПрисоединитьТоварКСвязкеНаСервере(МассивТоваров)
    
    РезультатОперации = Новый Структура("Успех, Сообщение", Истина, "");
    ОбщийСписокПропущенных = Новый Массив;
    СписокНевалидных = Новый Массив;
    
    // 1. Быстрая проверка входных данных
    Если МассивТоваров = Неопределено Или МассивТоваров.Количество() = 0 Тогда
        Возврат РезультатОперации;
    КонецЕсли;

    // 2. Открываем транзакцию для защиты целостности данных
    НачатьТранзакцию();
    
    Попытка
        // Получаем ID связки текущего товара
        Связка = AVS_ОбщийМодульСайт.ПолучитьИдентификаторСвязкиТовара(Объект.Ссылка);
        
        Если Не ЗначениеЗаполнено(Связка) Тогда
            ОтменитьТранзакцию();
            РезультатОперации.Успех = Ложь;
            РезультатОперации.Сообщение = "Ошибка: Не удалось определить связку для основного товара (объект не записан или не включен в систему связок).";
            Возврат РезультатОперации;
        КонецЕсли;

        // 3. ОПРЕДЕЛЯЕМ ГОТОВНОСТЬ ВСЕХ ТОВАРОВ И ПОРЯДОК ОДНИМ ПАКЕТНЫМ ЗАПРОСОМ (ПРИОРИТЕТНАЯ ПРОВЕРКА)
        Запрос = Новый Запрос;
        Запрос.Текст = 
            "ВЫБРАТЬ РАЗЛИЧНЫЕ
            |	Состав.Номенклатура КАК Товар
            |ИЗ
            |	РегистрСведений.AVS_СоставКатегорийНоменклатуры КАК Состав
            |ГДЕ
            |	Состав.Номенклатура В (&МассивТоваров)
            |	И Состав.СвязкаАктивна = ИСТИНА
            |;
            |
            |////////////////////////////////////////////////////////////////////////////////
            |ВЫБРАТЬ
            |	ЕСТЬNULL(МАКСИМУМ(Регистр.Порядок), 0) КАК МаксПорядок
            |ИЗ
            |	РегистрСведений.AVS_СоставСвязокНоменклатуры КАК Регистр
            |ГДЕ
            |	Регистр.Связка = &Связка";
        
        Запрос.УстановитьПараметр("МассивТоваров", МассивТоваров);
        Запрос.УстановитьПараметр("Связка", Связка);
        
        РезультатыПакета = Запрос.ВыполнитьПакет();
        
        // Таблица товаров, которые ЕСТЬ в категориях и АКТИВНЫ
        ТаблицаВалидных = РезультатыПакета[0].Выгрузить();
        ТаблицаВалидных.Индексы.Добавить("Товар");
        
        // Текущий максимальный порядок в связке
        ВыборкаПорядок = РезультатыПакета[1].Выбрать();
        МаксПорядок = 0;
        Если ВыборкаПорядок.Следующий() Тогда
            МаксПорядок = ВыборкаПорядок.МаксПорядок;
        КонецЕсли;
        
        // 4. Основной цикл обработки товаров
        Для Каждого ТекТовар Из МассивТоваров Цикл
            
            // Пропускаем, если товар — это сам текущий объект (он уже в связке)
            Если ТекТовар = Объект.Ссылка Тогда 
                Продолжить; 
            КонецЕсли;
            
            // ПРОВЕРКА №1 (ПРИОРИТЕТНАЯ): Готовность для сайта
            Если ТаблицаВалидных.Найти(ТекТовар, "Товар") = Неопределено Тогда
                СписокНевалидных.Добавить("""" + Строка(ТекТовар) + """");
                Продолжить; // Переходим к следующему товару, этот не добавляем
            КонецЕсли;
            
            МаксПорядок = МаксПорядок + 10;
            
            // ПРОВЕРКА №2: Наличие характеристик (существующий функционал)
            // Функция сама создаст записи в РС СоставСвязок
            Пропущенные = AVS_ОбщийМодульСайт.ЗаполнитьХарактеристикиИзДопСведений(Связка, ТекТовар, МаксПорядок);
            
            // Собираем отчет о пропусках характеристик для УСПЕШНО добавленных товаров
            ИтогСинхр = AVS_ОбщийМодульСайт.ЗаполнитьХарактеристикиИзДопСведений(Связка, ТекТовар, МаксПорядок);
            
            // Безопасное получение списка пропущенных
            Пропущенные = Новый Массив;
            Если ТипЗнч(ИтогСинхр) = Тип("Структура") И ИтогСинхр.Свойство("СписокПропущенных") Тогда
                Пропущенные = ИтогСинхр.СписокПропущенных;
            ИначеЕсли ТипЗнч(ИтогСинхр) = Тип("Массив") Тогда
                Пропущенные = ИтогСинхр; 
            КонецЕсли;
            
            Если ТипЗнч(Пропущенные) = Тип("Массив") И Пропущенные.Количество() > 0 Тогда
                ОбщийСписокПропущенных.Добавить(Строка(ТекТовар) + ": (" + СтрСоединить(Пропущенные, ", ") + ")");
            КонецЕсли;
            
        КонецЦикла;
        
        // 5. Регистрация изменений для выгрузки на сайт
        //AVS_ОбщийМодульСайт.ЗарегистрироватьИзменениеСвязки(Связка);
        
        // Если дошли сюда — всё успешно, фиксируем в БД
        ЗафиксироватьТранзакцию();
        
        // 6. Формирование финального сообщения
        ТекстСообщения = "";
        
        // Блок А: Ошибки валидации категорий (самый важный)
        Если СписокНевалидных.Количество() > 0 Тогда
            ТекстСообщения = "Товар(-ы): " + СтрСоединить(СписокНевалидных, "," + Символы.ПС) + Символы.ПС + 
                "не добавлены в связку, т.к. не входят ни в одну категорию сайта или не настроена их видимость! Проверьте настройки категории!";
        КонецЕсли;
        
        // Блок Б: Предупреждения по характеристикам для добавленных товаров
        Если ОбщийСписокПропущенных.Количество() > 0 Тогда
            ТекстДоп = "Внимание! У следующих позиций не найдены значения характеристик в Доп. Сведениях:" + Символы.ПС + 
                СтрСоединить(ОбщийСписокПропущенных, Символы.ПС) + ". Откройте карточку товара и заполните значения дополнительных сведений.";
            
            ТекстСообщения = ТекстСообщения + ?(ПустаяСтрока(ТекстСообщения), "", Символы.ПС + Символы.ПС) + ТекстДоп;
        КонецЕсли;
        
        РезультатОперации.Сообщение = ТекстСообщения;
        
    Исключение
        // В случае любой ошибки откатываем всё назад
        Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли;
        
        РезультатОперации.Успех = Ложь;
        РезультатОперации.Сообщение = "Критическая ошибка при объединении: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
        
        ЗаписьЖурналаРегистрации("AVS.ИнтеграцияСайт", 
            УровеньЖурналаРегистрации.Ошибка, , , ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
    КонецПопытки;
    
    Возврат РезультатОперации;
    
КонецФункции

&НаКлиенте
Процедура AVS_ВыйтиИзСвязкиКоманда(Команда)
    Попытка
        // 1. Проверяем состояние связки на сервере
        Информация = ПолучитьИнфоОСвязкеДляИсключения();
        
        Если Не Информация.Участвует Тогда
            Сообщить("Товар не входит в группу вариаций.");
            Возврат;
        КонецЕсли;
        
        // 2. Выбираем сценарий вопроса
        Если Информация.ОстанетсяОдин Тогда
            ТекстВопроса = "После удаления в связке останется 1 товар! Удалить связку полностью?";
            ИмяМетодаОбратногоВызова = "ПослеПодтвержденияУдаленияПоследнего";
        Иначе
            ТекстВопроса = "Исключить этот товар из группы вариаций?";
            ИмяМетодаОбратногоВызова = "AVS_ПодтверждениеВыхода";
        КонецЕсли;
        
        ОписаниеОповещения = Новый ОписаниеОповещения(ИмяМетодаОбратногоВызова, ЭтотОбъект, Информация.Связка);
        ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
        
    Исключение
        Сообщить("[AVS ERROR]: Ошибка инициализации выхода из связки: " + ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура AVS_ПодтверждениеВыхода(Результат, Связка) Экспорт
    
    Если Результат = КодВозвратаДиалога.Да Тогда
        // Обычное исключение (товаров в группе много)
        AVS_ИсключитьНаСервере(Ложь);
        
        AVS_RefreshНаСервере();
        ОповеститьОбИзменении(Объект.Ссылка);
        ОповеститьОбИзменении(Связка);
    КонецЕсли;
    
КонецПроцедуры

&НаКлиенте
Процедура ПослеПодтвержденияУдаленияПоследнего(Результат, Связка) Экспорт
    
    // Если пользователь нажал "Нет" - возврат без изменений, как и требовалось
    Если Результат = КодВозвратаДиалога.Да Тогда
        Сообщить("[AVS DEBUG]: Пользователь подтвердил удаление связки целиком.");
        
        // Вызываем серверный метод с флагом полного удаления
        AVS_ИсключитьНаСервере(Истина); 
        
        AVS_RefreshНаСервере();
        ОповеститьОбИзменении(Объект.Ссылка);
        ОповеститьОбИзменении(Связка);
    Иначе
        Сообщить("[AVS DEBUG]: Операция отменена пользователем (отказ от расформирования группы).");
    КонецЕсли;
    
КонецПроцедуры

&НаСервере
Функция ПолучитьИнфоОСвязкеДляИсключения()
    
    Результат = Новый Структура("Участвует, ОстанетсяОдин, Связка", Ложь, Ложь, Неопределено);
    
    Связка = AVS_ОбщийМодульСайт.ПолучитьИдентификаторСвязкиТовара(Объект.Ссылка);
    Если Связка.Пустая() Тогда Возврат Результат; КонецЕсли;
    
    Результат.Участвует = Истина;
    Результат.Связка    = Связка;
    
    // Считаем количество участников
    Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Товар) КАК КолВо ИЗ РегистрСведений.AVS_СоставСвязокНоменклатуры ГДЕ Связка = &Связка");
    Запрос.УстановитьПараметр("Связка", Связка);
    Выборка = Запрос.Выполнить().Выбрать();
    
    Если Выборка.Следующий() Тогда
        // Если сейчас 2 товара, то после удаления одного останется 1
        Результат.ОстанетсяОдин = (Выборка.КолВо <= 2);
    КонецЕсли;
    
    Возврат Результат;
    
КонецФункции

&НаСервере
Процедура AVS_ИсключитьНаСервере(УдалитьСвязкуПолностью = Ложь)
    
    Попытка
        ТоварСсылка = Объект.Ссылка;
        Связка = AVS_ОбщийМодульСайт.ПолучитьИдентификаторСвязкиТовара(ТоварСсылка);
        
        Если УдалитьСвязкуПолностью Тогда
            // Сценарий А: Полный разрыв связки
            AVS_ОбщийМодульСайт.РазорватьСвязку(Связка);
        Иначе
            // Сценарий Б: Просто исключаем текущий товар
            Набор = РегистрыСведений.AVS_СоставСвязокНоменклатуры.СоздатьНаборЗаписей();
            Набор.Отбор.Товар.Установить(ТоварСсылка);
            Набор.Записать(); 
            
            // Регистрируем изменения для оставшихся участников
            //AVS_ОбщийМодульСайт.ЗарегистрироватьИзменениеСвязки(Связка);
            
            Сообщить("[AVS DEBUG]: Товар исключен из группы. Группа сохранена.");
        КонецЕсли;
        
        // В любом случае регистрируем изменение самого товара (у него больше нет связки)
        AVS_ПриЗаписиНоменклатуры.ЗарегистрироватьИзменениеТовара(ТоварСсылка, Перечисления.AVS_ВидСобытия.GROUP_LINK_CHANGE);

    Исключение
        ТекстОшибки = "[AVS ERROR]: Ошибка в AVS_ИсключитьНаСервере: " + ОписаниеОшибки();
        Сообщить(ТекстОшибки);
        AVS_Логирование.ЗаписатьВЛог(ТекстОшибки);
    КонецПопытки;
    
КонецПроцедуры

&НаКлиенте
Процедура AVS_ПрисоединитьКСвязкеКоманда(Команда)
    Оповещение = Новый ОписаниеОповещения("AVS_ПослеВыбораСвязки", ЭтотОбъект);
    // Открываем форму выбора справочника идентификаторов связок
    ОткрытьФорму("Справочник.AVS_ИдентификаторыСвязок.ФормаВыбора", , ЭтотОбъект, , , , Оповещение);
КонецПроцедуры

&НаКлиенте
Процедура AVS_ПослеВыбораСвязки(Результат, ДопПараметры) Экспорт
    Если Результат = Неопределено Тогда Возврат; КонецЕсли;
    
    Попытка
        // { ПРАВКА: Получаем структуру результата с сервера }
        Итог = AVS_ПрисоединитьНаСервере(Результат);
        
        // Обновляем интерфейс
        AVS_RefreshНаСервере();
        
        // Если есть сообщение о незаполненных данных - показываем его
        Если ЗначениеЗаполнено(Итог.Сообщение) Тогда
            ПоказатьПредупреждение(, Итог.Сообщение);
        КонецЕсли;
        
        ОповеститьОбИзменении(Объект.Ссылка);
        ОповеститьОбИзменении(Результат); 
        
    Исключение
        Сообщить("[AVS ERROR]: Ошибка в AVS_ПослеВыбораСвязки: " + ОписаниеОшибки());
    КонецПопытки;
    // { ПРАВКА_КОНЕЦ }
КонецПроцедуры

&НаСервере
Функция AVS_ПрисоединитьНаСервере(Связка)
    
    // { ПРАВКА_НАЧАЛО: Автозаполнение и проверка данных при присоединении }
    
    РезультатОперации = Новый Структура("Успех, Сообщение", Истина, "");
    
    Попытка
        Сообщить("[AVS DEBUG]: Начало присоединения текущего товара к группе: " + Строка(Связка));
        
        Если Не ЗначениеЗаполнено(Связка) Тогда 
            РезультатОперации.Успех = Ложь;
            РезультатОперации.Сообщение = "Группа не выбрана.";
            Возврат РезультатОперации; 
        КонецЕсли;

        // 1. Получаем текущий максимальный порядок (Безопасно через ЕСТЬNULL)
        Запрос = Новый Запрос;
        Запрос.Текст = 
            "ВЫБРАТЬ
            |	ЕСТЬNULL(МАКСИМУМ(Состав.Порядок), 0) КАК МаксПорядок
            |ИЗ
            |	РегистрСведений.AVS_СоставСвязокНоменклатуры КАК Состав
            |ГДЕ
            |	Состав.Связка = &Связка";
        
        Запрос.УстановитьПараметр("Связка", Связка);
        Результат = Запрос.Выполнить();
        
        ТекущийМакс = 0;
        Если Не Результат.Пустой() Тогда
            Выборка = Результат.Выбрать();
            Если Выборка.Следующий() Тогда
                ТекущийМакс = Число(Выборка.МаксПорядок); 
            КонецЕсли;
        КонецЕсли;
        
        НовыйПорядок = ТекущийМакс + 10;

        // 2. ВЫЗОВ АВТОЗАПОЛНЕНИЯ ИЗ ДОП. СВЕДЕНИЙ
        // Функция ЗаполнитьХарактеристикиИзДопСведений (из общего модуля) 
        // сама создаст записи в регистре AVS_СоставСвязокНоменклатуры
        //Пропущенные = AVS_ОбщийМодульСайт.ЗаполнитьХарактеристикиИзДопСведений(Связка, Объект.Ссылка, НовыйПорядок);
        
        // 3. Формирование предупреждения для пользователя
        ИтогСинхр = AVS_ОбщийМодульСайт.ЗаполнитьХарактеристикиИзДопСведений(Связка, Объект.Ссылка, НовыйПорядок);
        
        Пропущенные = Новый Массив;
        Если ТипЗнч(ИтогСинхр) = Тип("Структура") И ИтогСинхр.Свойство("СписокПропущенных") Тогда
            Пропущенные = ИтогСинхр.СписокПропущенных;
        ИначеЕсли ТипЗнч(ИтогСинхр) = Тип("Массив") Тогда
            Пропущенные = ИтогСинхр;
        КонецЕсли;
        
        Если ТипЗнч(Пропущенные) = Тип("Массив") И Пропущенные.Количество() > 0 Тогда
            РезультатОперации.Сообщение = "Товар добавлен в группу, но в его 'Дополнительных сведениях' не заполнены: " 
                + СтрСоединить(Пропущенные, ", ") + ". Откройте карточку товара и заполните значения дополнительных сведений.";
        КонецЕсли;

        // 4. Регистрация изменений для сайта
        //AVS_ОбщийМодульСайт.ЗарегистрироватьИзменениеСвязки(Связка);
		AVS_ОбщийМодульСайт.AVS_ЗарегистрироватьИзменение(Объект.Ссылка, "GROUP_LINK_CHANGE");
        
        Сообщить("[AVS DEBUG]: Товар успешно присоединен к группе. Порядок: " + НовыйПорядок);

    Исключение
        РезультатОперации.Успех = Ложь;
        РезультатОперации.Сообщение = "Ошибка присоединения: " + ОписаниеОшибки();
        
        ТекстОшибки = "[AVS ERROR]: " + РезультатОперации.Сообщение;
        Сообщить(ТекстОшибки);
        AVS_Логирование.ЗаписатьВЛог(ТекстОшибки);
    КонецПопытки;
    
    Возврат РезультатОперации;
    
    // { ПРАВКА_КОНЕЦ }
    
КонецФункции

&НаСервере
Процедура AVS_ОчиститьИнтерфейсСвязокНаСервере()
    // Удаляем только группу связок. Категории не трогаем, чтобы не дублировать реквизиты ДС.
    Элемент = Элементы.Найти("AVS_ГрСвязки");
    Если Элемент <> Неопределено Тогда
        Элементы.Удалить(Элемент);
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура AVS_RefreshКоманда(Команда)
    AVS_RefreshНаСервере(Истина);
КонецПроцедуры

&НаСервере
Процедура AVS_RefreshНаСервере(ВыполнятьСинхронизацию = Ложь)
    // { ПРАВКА_НАЧАЛО: Умное обновление с пересинхронизацией данных }
    
    Попытка
        Связка = AVS_ОбщийМодульСайт.ПолучитьИдентификаторСвязкиТовара(Объект.Ссылка);
        
        Если ЗначениеЗаполнено(Связка)И ВыполнятьСинхронизацию Тогда
			
			БылиИзменения = Ложь;
            
            // 1. Получаем список всех товаров в этой группе
            Запрос = Новый Запрос;
            Запрос.Текст = 
                "ВЫБРАТЬ РАЗЛИЧНЫЕ
                |	Состав.Товар КАК Товар,
                |	Состав.Порядок КАК Порядок
                |ИЗ
                |	РегистрСведений.AVS_СоставСвязокНоменклатуры КАК Состав
                |ГДЕ
                |	Состав.Связка = &Связка";
            Запрос.УстановитьПараметр("Связка", Связка);
            Выборка = Запрос.Выполнить().Выбрать();
            
            // 2. Для каждого товара вызываем функцию обновления из Доп. Сведений
            Пока Выборка.Следующий() Цикл
                ИтогСинхр = AVS_ОбщийМодульСайт.ЗаполнитьХарактеристикиИзДопСведений(Связка, Выборка.Товар, Выборка.Порядок);
                Если ИтогСинхр.Изменено Тогда
                    БылиИзменения = Истина;
                КонецЕсли;
            КонецЦикла;
            
            Если БылиИзменения Тогда
                AVS_ОбщийМодульСайт.ЗарегистрироватьИзменениеСвязки(Связка);
                Сообщить("[AVS DEBUG]: Изменения в связке обнаружены и зарегистрированы.");
            Иначе
                Сообщить("[AVS DEBUG]: Изменений в данных связки нет, шум в регистре исключен.");
            КонецЕсли;
        КонецЕсли;

        // --- ПЕРЕРИСОВКА ИНТЕРФЕЙСА (всегда) ---
        ЭлементыДляУдаления = Новый Массив;
        ЭлементыДляУдаления.Добавить("AVS_ГрКат");
        ЭлементыДляУдаления.Добавить("AVS_ГрСвязки");
        
        Для Каждого ИмяЭлемента Из ЭлементыДляУдаления Цикл
			ЭлементФормы = Элементы.Найти(ИмяЭлемента);
			Если ЭлементФормы <> Неопределено Тогда 
				Попытка Элементы.Удалить(ЭлементФормы); Исключение КонецПопытки;
			КонецЕсли;
		КонецЦикла;
        
        // Пересоздаем элементы и заполняем таблицу актуальными данными из РС
        AVS_ПриСозданииНаСервереПосле(Ложь, Истина);
        
        Если ВыполнятьСинхронизацию Тогда
            Сообщить("[AVS DEBUG]: Синхронизация и регистрация завершены.");
        КонецЕсли;

    Исключение
        AVS_Логирование.ЗаписатьВЛог("Ошибка Refresh: " + ОписаниеОшибки());
    КонецПопытки;
    
    // { ПРАВКА_КОНЕЦ }
КонецПроцедуры

// { ПРАВКА_НАЧАЛО: Логика открытия состава связок }

&НаКлиенте
Процедура AVS_ОткрытьСоставКоманда(Команда)
	
	Попытка
		// Получаем связку через серверную функцию
		Связка = AVS_ПолучитьСвязкуНаСервере(Объект.Ссылка);
		
		Если ЗначениеЗаполнено(Связка) Тогда
			// Открываем форму списка регистра с отбором по текущей связке
			ПараметрыОткрытия = Новый Структура("Отбор", Новый Структура("Связка", Связка));
			ОткрытьФорму("РегистрСведений.AVS_СоставСвязокНоменклатуры.ФормаСписка", ПараметрыОткрытия, ЭтотОбъект);
			Сообщить("[AVS DEBUG]: Открыт состав связки: " + Строка(Связка));
		Иначе
			ПоказатьПредупреждение(, "Товар не входит в группу вариаций.");
		КонецЕсли;
	Исключение
		Сообщить("[AVS ERROR]: Ошибка открытия состава: " + ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция AVS_ПолучитьСвязкуНаСервере(ТоварСсылка)
	// Безопасный вызов общего модуля
	Возврат AVS_ОбщийМодульСайт.ПолучитьИдентификаторСвязкиТовара(ТоварСсылка);
КонецФункции

// { ПРАВКА_КОНЕЦ }

// { ПРАВКА_НАЧАЛО: Безопасная проверка существования реквизитов }
&НаСервере
Функция AVS_РеквизитСуществует(Имя, Путь = "")
	Попытка
		Реквизиты = ЭтаФорма.ПолучитьРеквизиты(Путь);
		Для Каждого Рек Из Реквизиты Цикл
			Если Рек.Имя = Имя Тогда Возврат Истина; КонецЕсли;
		КонецЦикла;
	Исключение
		// Если путь (таблица) не существует, ПолучитьРеквизиты выдаст ошибку
	КонецПопытки;
	Возврат Ложь;
КонецФункции
// { ПРАВКА_КОНЕЦ }

&НаКлиенте
Процедура AVS_ПослеЗакрытияОкнаГруппы(Результат, ДопПараметры) Экспорт
	// Эта процедура сработает автоматически, когда пользователь закроет окно создания группы.
	// Мы просто вызываем обновление текущей карточки товара.
	AVS_RefreshНаСервере(Истина);
КонецПроцедуры

&НаКлиенте
Процедура AVS_ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
    // Это событие сработает, если в форме "Идентификаторы связок" 
    // после записи вызвать: Оповестить("AVS_ОбновлениеСвязок");
    Если ИмяСобытия = "AVS_ОбновлениеСвязок" Тогда
        AVS_RefreshНаСервере();
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура AVS_СтраницыКарточкаНоменклатурыПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	// Параметр "ТекущаяСтраница" — это именно та страница, на которую перешел пользователь.
	// Проверяем её имя (замените на ваше имя страницы, если оно отличается).
	Если ТекущаяСтраница.Имя = "AVS_СтраницаСвязкиИВариации" Тогда
		
		// Вызываем серверную процедуру обновления
		AVS_RefreshНаСервере(Ложь);
		
		// Сообщить("[AVS DEBUG]: Данные связок обновлены при смене вкладки.");
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура AVS_УправлениеСвязкойКоманда(Команда)
	
	Попытка
		// Получаем текущую связку товара
		Связка = AVS_ПолучитьСвязкуНаСервере(Объект.Ссылка);
		
		Если ЗначениеЗаполнено(Связка) Тогда
			// Параметр "Ключ" заставляет 1С открыть форму существующего объекта для редактирования
			ПараметрыФормы = Новый Структура("Ключ", Связка);
			
			// Используем уже существующее оповещение AVS_ПослеЗакрытияОкнаГруппы, 
			// чтобы при закрытии окна управления данные в карточке товара обновились автоматически
			ОписаниеОповещения = Новый ОписаниеОповещения("AVS_ПослеЗакрытияОкнаГруппы", ЭтотОбъект);
			
			ОткрытьФорму("Справочник.AVS_ИдентификаторыСвязок.ФормаОбъекта", ПараметрыФормы, ЭтотОбъект, , , , ОписаниеОповещения);
		Иначе
			ПоказатьПредупреждение(, "Товар не входит в группу вариаций.");
		КонецЕсли;
	Исключение
		Сообщить("[AVS ERROR]: Ошибка открытия управления связкой: " + ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Процедура AVS_НастроитьУсловноеОформлениеТаблицыСвязок()
    
    ИмяТЗ = "AVS_ТаблицаСоставаСвязки";
    
    // Проверяем, существует ли вообще реквизит таблицы на форме
    Если Не AVS_РеквизитСуществует(ИмяТЗ) Тогда
        Возврат;
    КонецЕсли;

    // 1. Очищаем старые правила оформления
    ИдентификаторПравила = "AVS_HighlightCurrentProduct";
    МассивДляУдаления = Новый Массив;
    Для Каждого ЭлементОформления Из УсловноеОформление.Элементы Цикл
        Если ЭлементОформления.ИдентификаторПользовательскойНастройки = ИдентификаторПравила Тогда
            МассивДляУдаления.Добавить(ЭлементОформления);
        КонецЕсли;
    КонецЦикла;
    Для Каждого Элемент Из МассивДляУдаления Цикл
        УсловноеОформление.Элементы.Удалить(Элемент);
    КонецЦикла;

    // 2. Создаем новое правило
    Элемент = УсловноеОформление.Элементы.Добавить();
    Элемент.ИдентификаторПользовательскойНастройки = ИдентификаторПравила;
    
    // Устанавливаем ОФОРМЛЕНИЕ: Жирный шрифт
    Элемент.Оформление.УстановитьЗначениеПараметра("Шрифт", Новый Шрифт(,,Истина));
    
    // 3. Устанавливаем УСЛОВИЕ: Товар в строке таблицы = Текущий товар (Объект.Ссылка)
    ЭлементОтбора = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
    ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяТЗ + ".Товар");
    ЭлементОтбора.ВидСравнения  = ВидСравненияКомпоновкиДанных.Равно;
    ЭлементОтбора.ПравоеЗначение = Объект.Ссылка;
    
    // 4. Указываем ОФОРМЛЯЕМЫЕ ПОЛЯ
    // Добавляем основную колонку товара
    ПолеОформления = Элемент.Поля.Элементы.Добавить();
    ПолеОформления.Поле = Новый ПолеКомпоновкиДанных("ColТовар");
    
    // { ИСПРАВЛЕНО }: Обращаемся к динамической таблице через ЭтаФорма
    ТаблицаОбъект = ЭтаФорма[ИмяТЗ];
    Для Каждого Колонка Из ТаблицаОбъект.Выгрузить().Колонки Цикл
        Если СтрНачинаетсяС(Колонка.Имя, "Хар_") Тогда
            ПолеОформления = Элемент.Поля.Элементы.Добавить();
            ПолеОформления.Поле = Новый ПолеКомпоновкиДанных("Col_" + Колонка.Имя);
        КонецЕсли;
    КонецЦикла;
    
КонецПроцедуры

#Область Медиа

&НаСервере
&После("ПриЗаписиНаСервере")
Процедура AVS_Медиа_ПриЗаписиНаСервереПосле(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	// { БЛОК_МЕДИА: Сохраняем данные ПОСЛЕ того, как товар получил ссылку в БД }
	Если Не Отказ Тогда
		AVS_Медиа_СохранитьДанные(ТекущийОбъект.Ссылка);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
&После("ПослеЗаписи")
Процедура AVS_Медиа_ПослеЗаписи(ПараметрыЗаписи)
	// При сохранении очищаем визуальный индикатор
	Элементы.AVS_СтраницаМедиа.Заголовок = "Медиа (Галерея)";
КонецПроцедуры

#КонецОбласти
// =============================================================================
// БЛОК: УПРАВЛЕНИЕ МЕДИА-ФАЙЛАМИ (ТЗ №2)
