&НаСервере
Процедура AVS_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    
    Попытка
        Сообщить("[AVS DEBUG]: Начало инициализации формы связки...");
        
        // --- 1. СОЗДАНИЕ РЕКВИЗИТОВ (Буфер и Списки) ---
        ДобавляемыеРеквизиты = Новый Массив;
        ТекущиеРеквизиты = ЭтаФорма.ПолучитьРеквизиты();
        
        БуферЕсть = Ложь; СоставЕсть = Ложь; ХарЕсть = Ложь; ФлагХарЕсть = Ложь;
    Для Каждого Рекв Из ТекущиеРеквизиты Цикл
        Если Рекв.Имя = "AVS_БуферХар" Тогда БуферЕсть = Истина; 
        ИначеЕсли Рекв.Имя = "СоставСвязки" Тогда СоставЕсть = Истина;
		ИначеЕсли Рекв.Имя = "ХарактеристикиСвязки" Тогда ХарЕсть = Истина;
		ИначеЕсли Рекв.Имя = "AVS_БылиИзмененияХарактеристик" Тогда ФлагХарЕсть = Истина;
        КонецЕсли;
    КонецЦикла;
    
    Если Не БуферЕсть Тогда
        ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("AVS_БуферХар", Новый ОписаниеТипов("ТаблицаЗначений")));
        ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("Характеристика", Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения"), "AVS_БуферХар"));
        ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("Порядок", Новый ОписаниеТипов("Число"), "AVS_БуферХар"));
    КонецЕсли;
	
	Если Не ФлагХарЕсть Тогда
            ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("AVS_БылиИзмененияХарактеристик", Новый ОписаниеТипов("Булево")));
        КонецЕсли;
	
    Если Не СоставЕсть Тогда
        ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("СоставСвязки", AVS_ДФИ.ОписаниеТипаДинамическийСписок()));
    КонецЕсли;
    Если Не ХарЕсть Тогда
        ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ХарактеристикиСвязки", AVS_ДФИ.ОписаниеТипаДинамическийСписок()));
    КонецЕсли;
	
        Если ДобавляемыеРеквизиты.Количество() > 0 Тогда
            ЭтаФорма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
        КонецЕсли;

        // --- 2. НАСТРОЙКА ДАННЫХ ---
        // Настройка списка состава
        ЭтаФорма.СоставСвязки.ПроизвольныйЗапрос = Истина;
        ЭтаФорма.СоставСвязки.ТекстЗапроса = 
            "ВЫБРАТЬ Состав.Товар КАК Товар, Состав.Порядок КАК Порядок 
            |ИЗ РегистрСведений.AVS_СоставСвязокНоменклатуры КАК Состав ГДЕ Состав.Связка = &ТекущаяСвязка УПОРЯДОЧИТЬ ПО Порядок";
        
        // { ПРАВКА: Настройка списка характеристик (чтобы не было ошибки параметров) }
        ЭтаФорма.ХарактеристикиСвязки.ПроизвольныйЗапрос = Истина;
        ЭтаФорма.ХарактеристикиСвязки.ТекстЗапроса = 
            "ВЫБРАТЬ Характеристики.Характеристика, Характеристики.Порядок 
            |ИЗ РегистрСведений.AVS_ХарактеристикиСвязок КАК Характеристики ГДЕ Характеристики.Связка = &ТекущаяСвязка";
        
        // Загружаем данные из регистра в наш новый буфер
        AVS_ЗагрузитьХарактеристикиВБуфер(Объект.Ссылка);

        УстановитьПараметрыДинамическихСписков();

        // --- 4. ИНТЕРФЕЙС (Группа идентификации) ---
        ГруппаИдентификация = Элементы.Найти("AVS_ГрИдентификация");
        Если ГруппаИдентификация = Неопределено Тогда
            ГруппаИдентификация = AVS_ДФИ.СздГруппаОбычная(ЭтаФорма, "AVS_ГрИдентификация", ЭтаФорма, "Идентификация", 1, 1, 1);
            
            ЭлементНаим = Элементы.Найти("Наименование");
            Если ЭлементНаим <> Неопределено Тогда
                ЭтаФорма.Элементы.Переместить(ЭлементНаим, ГруппаИдентификация);
            КонецЕсли;
            
            ЭлементGUID = Элементы.Найти("GUIDСвязки");
            Если ЭлементGUID <> Неопределено Тогда
                ЭтаФорма.Элементы.Переместить(ЭлементGUID, ГруппаИдентификация);
            КонецЕсли;
        КонецЕсли;

        // --- 5. ТАБЛИЦЫ ---
        Если Не AVS_ЭлементСуществует("AVS_ТаблицаХар") Тогда
            КолонкиХар = Новый Структура;
            КолонкиХар.Вставить("Характеристика", "Характеристика");
            КолонкиХар.Вставить("Порядок", "Порядок");
            
            СобытияХар = Новый Структура;
    		СобытияХар.Вставить("ПередНачаломДобавления", "AVS_ХарПередНачаломДобавления");
    		СобытияХар.Вставить("ПередУдалением", "AVS_ХарПередУдалением");
            
            // ПРИВЯЗКА К БУФЕРУ: Теперь таблица на форме работает с AVS_БуферХар
            AVS_ДФИ.СздТаблицаФормы(ЭтаФорма, "AVS_ТаблицаХар", ГруппаИдентификация, "AVS_БуферХар", КолонкиХар, Новый Структура("Высота", 5), СобытияХар, Истина);
            
            СоздатьКнопкиКоманднойПанелиХарактеристик();
        КонецЕсли;

        Если Параметры.Свойство("AVS_Источник") Тогда
            ЭтаФорма.AVS_ИсточникТовар = Параметры.AVS_Источник;
        КонецЕсли;

    Исключение
        Сообщить("[AVS ERROR]: Ошибка инициализации: " + ОписаниеОшибки());
	КонецПопытки; 
	
	ЭтаФорма.Модифицированность = Ложь;
    
КонецПроцедуры

&НаСервере
Процедура СоздатьКнопкиКоманднойПанелиХарактеристик()
    
    Попытка
        // Имя панели формируется ДФИ по шаблону: <ИмяТаблицы> + "КоманднаяПанель2"
        Панель = Элементы.Найти("AVS_ТаблицаХарКоманднаяПанель2");
        Если Панель = Неопределено Тогда 
            Возврат; 
        КонецЕсли;
        
        // 1. Команда и кнопка "Добавить"
        Если ЭтаФорма.Команды.Найти("ХарДобавить") = Неопределено Тогда
            AVS_ДФИ.СоздатьКоманду(ЭтаФорма, "ХарДобавить", "Добавить", "ХарДобавитьКоманда");
        КонецЕсли;
        Если Элементы.Найти("КнХарДобавить") = Неопределено Тогда
            AVS_ДФИ.СздКнопка(ЭтаФорма, "КнХарДобавить", Панель, "Добавить", "ХарДобавить", 1);
        КонецЕсли;
        
        // 2. Команда и кнопка "Удалить"
        Если ЭтаФорма.Команды.Найти("ХарУдалить") = Неопределено Тогда
            AVS_ДФИ.СоздатьКоманду(ЭтаФорма, "ХарУдалить", "Удалить", "ХарУдалитьКоманда");
        КонецЕсли;
        Если Элементы.Найти("КнХарУдалить") = Неопределено Тогда
            AVS_ДФИ.СздКнопка(ЭтаФорма, "КнХарУдалить", Панель, "Удалить", "ХарУдалить", 1);
		КонецЕсли;
		
		// Команда "Вверх"
        Если ЭтаФорма.Команды.Найти("ХарВверх") = Неопределено Тогда
            AVS_ДФИ.СоздатьКоманду(ЭтаФорма, "ХарВверх", "Вверх", "ХарВверхКоманда", Новый Структура("Картинка", БиблиотекаКартинок.ПереместитьВверх));
        КонецЕсли;
        Если Элементы.Найти("КнХарВверх") = Неопределено Тогда
            AVS_ДФИ.СздКнопка(ЭтаФорма, "КнХарВверх", Панель, "Вверх", "ХарВверх", 1);
        КонецЕсли;

        // Команда "Вниз"
        Если ЭтаФорма.Команды.Найти("ХарВниз") = Неопределено Тогда
            AVS_ДФИ.СоздатьКоманду(ЭтаФорма, "ХарВниз", "Вниз", "ХарВнизКоманда", Новый Структура("Картинка", БиблиотекаКартинок.ПереместитьВниз));
        КонецЕсли;
        Если Элементы.Найти("КнХарВниз") = Неопределено Тогда
            AVS_ДФИ.СздКнопка(ЭтаФорма, "КнХарВниз", Панель, "Вниз", "ХарВниз", 1);
        КонецЕсли;
		
		Если ЭтаФорма.Команды.Найти("ХарРазорвать") = Неопределено Тогда
            AVS_ДФИ.СоздатьКоманду(ЭтаФорма, "ХарРазорвать", "Разорвать связку полностью", "ХарРазорватьКоманда");
        КонецЕсли;
        Если Элементы.Найти("КнХарРазорвать") = Неопределено Тогда
            AVS_ДФИ.СздКнопка(ЭтаФорма, "КнХарРазорвать", Панель, "Разорвать связку полностью", "ХарРазорвать", 1);
		КонецЕсли;
		
        Сообщить("[AVS DEBUG]: Кнопки управления характеристиками добавлены.");
        
    Исключение
        Сообщить("[AVS ERROR]: Ошибка создания кнопок характеристик: " + ОписаниеОшибки());
    КонецПопытки;
    
КонецПроцедуры

&НаСервере
Процедура УстановитьПараметрыДинамическихСписков()
    
    Попытка
        ТекущаяСвязка = Объект.Ссылка;
        // Параметры для списка товаров
        ЭтаФорма.СоставСвязки.Параметры.УстановитьЗначениеПараметра("ТекущаяСвязка", ТекущаяСвязка);
        // Параметры для списка-схемы характеристик
        ЭтаФорма.ХарактеристикиСвязки.Параметры.УстановитьЗначениеПараметра("ТекущаяСвязка", ТекущаяСвязка);
        
        Сообщить("[AVS DEBUG]: Параметры списков обновлены (Связка: " + ТекущаяСвязка + ")");
    Исключение
        Сообщить("[AVS ERROR]: Ошибка установки параметров: " + ОписаниеОшибки());
    КонецПопытки;
    
КонецПроцедуры

&НаКлиенте
Процедура AVS_ХарПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
    Отказ = Истина;
    	
	// { ПРАВКА: Фильтрация выбора только характеристик с типом 'groupLink' (ТЗ 1.10.2) и разрешенные для сайта}
    ПараметрыОтбора = Новый Структура;
    ПараметрыОтбора.Вставить("AVS_ТипСвязки", ПредопределенноеЗначение("Перечисление.AVS_ТипСвязки.groupLink"));
	ПараметрыОтбора.Вставить("AVS_ВыгружатьНаСайт", Истина);
	
    Оповещение = Новый ОписаниеОповещения("ПослеВыбораХарСвязки", ЭтотОбъект);
	
	ПараметрыФормы = Новый Структура;
    ПараметрыФормы.Вставить("РежимВыбора", Истина);
    ПараметрыФормы.Вставить("Отбор",       ПараметрыОтбора);
    ОткрытьФорму("ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения.ФормаВыбора", 
        ПараметрыФормы, ЭтаФорма, , , , Оповещение);
	КонецПроцедуры
	
&НаСервере
Процедура AVS_ЗагрузитьХарактеристикиВБуфер(Связка)
    Если Связка.Пустая() Тогда Возврат; КонецЕсли;
    
    Запрос = Новый Запрос("ВЫБРАТЬ Характеристика, Порядок ИЗ РегистрСведений.AVS_ХарактеристикиСвязок ГДЕ Связка = &Связка УПОРЯДОЧИТЬ ПО Порядок");
    Запрос.УстановитьПараметр("Связка", Связка);
    
    // Исправленная проверка существования реквизита
    БуферНайден = Ложь;
    Для Каждого Рекв Из ЭтаФорма.ПолучитьРеквизиты() Цикл
        Если Рекв.Имя = "AVS_БуферХар" Тогда БуферНайден = Истина; Прервать; КонецЕсли;
    КонецЦикла;
    
    Если БуферНайден Тогда
        ЭтаФорма.AVS_БуферХар.Загрузить(Запрос.Выполнить().Выгрузить());
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораХарСвязки(Результат, ДопПараметры) Экспорт
 Если Результат = Неопределено Тогда Возврат; КонецЕсли;
    
    Сообщить("[AVS DEBUG]: Возврат из формы выбора. Результат: " + Строка(Результат));
    
    Если Результат = Неопределено Тогда 
        Сообщить("[AVS DEBUG]: Выбор отменен пользователем.");
        Возврат; 
    КонецЕсли;
    
    // Более надежная проверка типа через ТипЗнч
    ТипОбъекта = ТипЗнч(Результат);
    Если ТипОбъекта = Тип("ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения") Тогда
        
        ДобавитьХарактеристикуВРегистрНаСервере(Результат);
		
		ЭтаФорма.Модифицированность = Истина;
		
		ТаблицаЭлемент = Элементы.Найти("AVS_ТаблицаХар");
        Если ТаблицаЭлемент <> Неопределено Тогда
            ТаблицаЭлемент.Обновить();
		КонецЕсли;
		
        // ИСПРАВЛЕНО: Имя таблицы должно быть AVS_ТаблицаХар
		Если Элементы.Найти("AVS_ТаблицаХар") <> Неопределено Тогда
		    Элементы.AVS_ТаблицаХар.Обновить();
		    Сообщить("[AVS DEBUG]: Список характеристик обновлен.");
		Иначе
		    Сообщить("[AVS ERROR]: Элемент 'AVS_ТаблицаХар' не найден на форме!");
		КонецЕсли;
        
    Иначе
        Сообщить("[AVS WARNING]: Выбран объект неверного типа: " + Строка(ТипОбъекта));
    КонецЕсли;   
КонецПроцедуры

&НаКлиенте
Процедура ХарДобавитьКоманда(Команда)
    
    // Вызываем существующую процедуру (эмулируем событие таблицы)
    AVS_ХарПередНачаломДобавления(Неопределено, Ложь, Ложь, Неопределено, Неопределено, Неопределено);
    
КонецПроцедуры


&НаКлиенте
Процедура ХарУдалитьКоманда(Команда)
    
    // Вызываем общую логику удаления
    ХарПередУдалением(Неопределено, Ложь);
    
КонецПроцедуры

&НаКлиенте
Процедура ХарВверхКоманда(Команда)
    ПереместитьХарактеристикуКлиент(Истина);
КонецПроцедуры

&НаКлиенте
Процедура ХарВнизКоманда(Команда)
    ПереместитьХарактеристикуКлиент(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура ПереместитьХарактеристикуКлиент(НаправлениеВверх)
    
    Попытка
        ТаблицаХар = Элементы.Найти("AVS_ТаблицаХар");
        Если ТаблицаХар = Неопределено Тогда
            Сообщить("[AVS ERROR]: Таблица 'AVS_ТаблицаХар' не найдена!");
            Возврат;
        КонецЕсли;

        ТекДанные = ТаблицаХар.ТекущиеДанные;
        Если ТекДанные = Неопределено Тогда
            Сообщить("Выберите характеристику для перемещения!");
            Возврат;
        КонецЕсли;

        // Безопасная проверка типа
        Если ТипЗнч(ТекДанные.Характеристика) <> Тип("ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения") Тогда
            Сообщить("[AVS WARNING]: Неверный тип выбранного объекта.");
            Возврат;
        КонецЕсли;

        Сообщить(СтрШаблон("[AVS DEBUG]: Перемещение характеристики '%1' %2", 
            ТекДанные.Характеристика, ?(НаправлениеВверх, "вверх", "вниз")));

        Если ПереместитьХарактеристикуНаСервере(ТекДанные.Характеристика, НаправлениеВверх) Тогда
            ТаблицаХар.Обновить();
			
			ЭтаФорма.Модифицированность = Истина;
        КонецЕсли;

    Исключение
        Сообщить("[AVS ERROR]: Ошибка перемещения на клиенте: " + ОписаниеОшибки());
    КонецПопытки;
    
КонецПроцедуры

// { ПРАВКА_НАЧАЛО: Обработчики перемещения характеристик }
&НаСервере
Функция ПереместитьХарактеристикуНаСервере(ВыбраннаяХар, НаправлениеВверх)
    
    ТЗ = ЭтаФорма.AVS_БуферХар;
    
    Отбор = Новый Структура("Характеристика", ВыбраннаяХар);
    НайденныеСтроки = ТЗ.НайтиСтроки(Отбор);
    
    Если НайденныеСтроки.Количество() = 0 Тогда 
        Возврат Ложь; 
    КонецЕсли;
    
    // Получаем индекс строки
    Индекс = ТЗ.Индекс(НайденныеСтроки[0]);
    
    // Проверка границ
    Если НаправлениеВверх И Индекс = 0 Тогда Возврат Ложь; КонецЕсли;
    Если Не НаправлениеВверх И Индекс = ТЗ.Количество() - 1 Тогда Возврат Ложь; КонецЕсли;
    
    // ПРАВКА: Передаем Индекс вместо строки
    ТЗ.Сдвинуть(Индекс, ?(НаправлениеВверх, -1, 1));
    
    // Пересчет порядков
    Порядок = 10;
    Для Каждого Стр Из ТЗ Цикл
        Стр.Порядок = Порядок;
        Порядок = Порядок + 10;
    КонецЦикла;
    
    ЭтаФорма.Модифицированность = Истина;
	ЭтаФорма.AVS_БылиИзмененияХарактеристик = Истина;
    Возврат Истина;
    
КонецФункции

// { ПРАВКА_КОНЕЦ }

&НаСервере
Процедура ДобавитьХарактеристикуВРегистрНаСервере(Характеристика)
    // Работаем только с буфером в памяти
    Отбор = Новый Структура("Характеристика", Характеристика);
    Если ЭтаФорма.AVS_БуферХар.НайтиСтроки(Отбор).Количество() > 0 Тогда
        Возврат;
    КонецЕсли;

    НоваяСтр = ЭтаФорма.AVS_БуферХар.Добавить();
    НоваяСтр.Характеристика = Характеристика;
    
    МаксПорядок = 0;
    Для Каждого Стр Из ЭтаФорма.AVS_БуферХар Цикл
        МаксПорядок = Макс(МаксПорядок, Стр.Порядок);
    КонецЦикла;
    НоваяСтр.Порядок = МаксПорядок + 10;
    
    ЭтаФорма.Модифицированность = Истина;
	ЭтаФорма.AVS_БылиИзмененияХарактеристик = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ХарПередУдалением(Элемент, Отказ)
    
    Отказ = Истина; // Отменяем стандартное удаление, так как работаем через менеджер записи
    
    ТекущаяТаблица = ?(Элемент = Неопределено, Элементы.AVS_ТаблицаХар, Элемент);
    ТекущиеДанные = ТекущаяТаблица.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда 
		Сообщить("Выберите характеристику для удаления!");
		Возврат; 
	КонецЕсли;
	
	// Создаем описание оповещения для обработки ответа пользователя
    ОписаниеОповещения = Новый ОписаниеОповещения("ПослеПодтвержденияУдаленияХар", ЭтотОбъект, ТекущиеДанные.Характеристика);
    ПоказатьВопрос(ОписаниеОповещения, "Удалить характеристику '" + Строка(ТекущиеДанные.Характеристика) + "' из схемы?", РежимДиалогаВопрос.ДаНет);
	   
КонецПроцедуры 

&НаКлиенте
Процедура ПослеПодтвержденияУдаленияХар(Результат, Характеристика) Экспорт
    
    Если Результат = КодВозвратаДиалога.Да Тогда
        УдалитьХарактеристикуНаСервере(Характеристика);
		ЭтаФорма.Модифицированность = Истина;
        Элементы.AVS_ТаблицаХар.Обновить();
        Сообщить("[AVS DEBUG]: Характеристика '" + Строка(Характеристика) + "' удалена из схемы.");
    КонецЕсли;
    
КонецПроцедуры

&НаСервере
Процедура УдалитьХарактеристикуНаСервере(Характеристика)
    
    Отбор = Новый Структура("Характеристика", Характеристика);
    Строки = ЭтаФорма.AVS_БуферХар.НайтиСтроки(Отбор);
    Для Каждого Стр Из Строки Цикл
        ЭтаФорма.AVS_БуферХар.Удалить(Стр);
    КонецЦикла;
    ЭтаФорма.Модифицированность = Истина;
	ЭтаФорма.AVS_БылиИзмененияХарактеристик = Истина;
    
КонецПроцедуры

&НаСервере
Процедура AVS_ПриЧтенииНаСервере(ТекущийОбъект)
    
    Если Не ТекущийОбъект.Ссылка.Пустая() Тогда
        ЭтаФорма.GUIDСвязки = Строка(ТекущийОбъект.Ссылка.УникальныйИдентификатор());
        // Перечитываем буфер при обновлении формы
        AVS_ЗагрузитьХарактеристикиВБуфер(ТекущийОбъект.Ссылка);
	КонецЕсли;
	ЭтаФорма.Модифицированность = Ложь;
    
КонецПроцедуры

&НаКлиенте
Процедура AVS_ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	// { ПРАВКА }: Запоминаем статус "Новый" для корректного события в РИКС
	ПараметрыЗаписи.Вставить("AVS_ЭтоНовыйОбъект", Объект.Ссылка.Пустая());
	
	// Если были изменения в таблице характеристик, форсируем регистрацию
	Если ЭтаФорма.AVS_БылиИзмененияХарактеристик Тогда
		ПараметрыЗаписи.Вставить("AVS_НужнаРегистрация", Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура AVS_ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	// 1. Проверка уникальности (ваш существующий код)
	Если Не ПустаяСтрока(ТекущийОбъект.Наименование) Тогда
		Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.AVS_ИдентификаторыСвязок ГДЕ Наименование = &Наименование И Ссылка <> &Ссылка");
		Запрос.УстановитьПараметр("Наименование", ТекущийОбъект.Наименование);
		Запрос.УстановитьПараметр("Ссылка", ТекущийОбъект.Ссылка);
		Если Не Запрос.Выполнить().Пустой() Тогда
			Отказ = Истина;
			Сообщить("Группа с таким названием уже существует!", СтатусСообщения.Важное);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	// 2. { ПРАВКА: Точное определение изменений схемы }
	СхемаИзменена = Ложь;
	Если Не ТекущийОбъект.ЭтоНовый() Тогда
		Запрос = Новый Запрос("ВЫБРАТЬ Характеристика, Порядок ИЗ РегистрСведений.AVS_ХарактеристикиСвязок ГДЕ Связка = &Ссылка УПОРЯДОЧИТЬ ПО Порядок");
		Запрос.УстановитьПараметр("Ссылка", ТекущийОбъект.Ссылка);
		ТабБаза = Запрос.Выполнить().Выгрузить();
		
		ТЗ_Буфер = ЭтаФорма.AVS_БуферХар.Выгрузить();
		ТЗ_Буфер.Сортировать("Порядок");
		
		Если ТабБаза.Количество() <> ТЗ_Буфер.Количество() Тогда
			СхемаИзменена = Истина;
		Иначе
			Для Сч = 0 По ТабБаза.Количество() - 1 Цикл
				Если ТабБаза[Сч].Характеристика <> ТЗ_Буфер[Сч].Характеристика 
				   Или ТабБаза[Сч].Порядок <> ТЗ_Буфер[Сч].Порядок Тогда
					СхемаИзменена = Истина; Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;

	// Регистрация нужна только если: изменилась схема, это новый объект, 
	// изменилось имя или добавляется новый товар-источник
	НужнаРегистрация = СхемаИзменена 
	                 Или ТекущийОбъект.ЭтоНовый() 
	                 Или (ТекущийОбъект.Наименование <> ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекущийОбъект.Ссылка, "Наименование"))
	                 Или ЗначениеЗаполнено(ЭтаФорма.AVS_ИсточникТовар);
	
	ПараметрыЗаписи.Вставить("AVS_НужнаРегистрация", НужнаРегистрация);
КонецПроцедуры

&НаСервере
Процедура AVS_ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	Если ТекущийОбъект = Неопределено Тогда Возврат; КонецЕсли;
	СсылкаГруппы = ТекущийОбъект.Ссылка;
	Если СсылкаГруппы.Пустая() Тогда Возврат; КонецЕсли;
	
    ЭтаФорма.GUIDСвязки = Строка(СсылкаГруппы.УникальныйИдентификатор());
	
	Попытка
        // 1. Синхронизация набора характеристик (состав колонок связки)
        Набор = РегистрыСведений.AVS_ХарактеристикиСвязок.СоздатьНаборЗаписей();
        Набор.Отбор.Связка.Установить(СсылкаГруппы);
        Для Каждого Стр Из ЭтаФорма.AVS_БуферХар Цикл
            Запись = Набор.Добавить();
            Запись.Связка = СсылкаГруппы;
            Запись.Характеристика = Стр.Характеристика;
            Запись.Порядок = Стр.Порядок;
        КонецЦикла;
        Набор.Записать(); 

		// 2. Регистрация изменения МЕТАДАННЫХ (Название, состав колонок)
        НужнаРегистрация = Ложь;
        ПараметрыЗаписи.Свойство("AVS_НужнаРегистрация", НужнаРегистрация);

		ЭтоНовый = Ложь;
		ПараметрыЗаписи.Свойство("AVS_ЭтоНовыйОбъект", ЭтоНовый);

		// { ПРАВКА }: При первой записи шлем INSERT, при правках - UPDATE
		Если ЭтоНовый Тогда
			AVS_ОбщийМодульСайт.AVS_ЗарегистрироватьИзменение(СсылкаГруппы, "INSERT");
		ИначеЕсли НужнаРегистрация Или ЭтаФорма.AVS_БылиИзмененияХарактеристик Тогда
			AVS_ОбщийМодульСайт.AVS_ЗарегистрироватьИзменение(СсылкаГруппы, "UPDATE");
		КонецЕсли;
		
		ЭтаФорма.AVS_БылиИзмененияХарактеристик = Ложь;

		// 3. Регистрация изменения СОСТАВА (Добавление товара)
		Если ЗначениеЗаполнено(ЭтаФорма.AVS_ИсточникТовар) Тогда
			
			// { ПРАВКА }: Сохраняем ссылку товара в локальную переменную ДО очистки!
			ТекТовар = ЭтаФорма.AVS_ИсточникТовар;

			// Используем полноценный метод синхронизации, чтобы перенести и значения характеристик
			AVS_ОбщийМодульСайт.ЗаполнитьХарактеристикиИзДопСведений(СсылкаГруппы, ТекТовар, 10);
			
			// Очищаем источник только ПОСЛЕ успешного добавления
			ЭтаФорма.AVS_ИсточникТовар = Справочники.Номенклатура.ПустаяСсылка();
			
			// Регистрируем GROUP_LINK_CHANGE для товара
			AVS_ПриЗаписиНоменклатуры.ЗарегистрироватьИзменениеТовара(ТекТовар, "GROUP_LINK_CHANGE");
		КонецЕсли;

		// СБРОС ФЛАГОВ И ОБНОВЛЕНИЕ СПИСКОВ
		ЭтаФорма.AVS_БылиИзмененияХарактеристик = Ложь;
		УстановитьПараметрыДинамическихСписков();
		AVS_ЗагрузитьХарактеристикиВБуфер(СсылкаГруппы);
		
	Исключение
		Сообщить("[AVS ERROR]: Ошибка после записи связки: " + ОписаниеОшибки());
	КонецПопытки;	
КонецПроцедуры

&НаСервере
Функция AVS_РеквизитСуществует(Имя)
    Реквизиты = ЭтаФорма.ПолучитьРеквизиты();
    Для Каждого Рек Из Реквизиты Цикл
        Если Рек.Имя = Имя Тогда Возврат Истина; КонецЕсли;
    КонецЦикла;
    Возврат Ложь;
КонецФункции

&НаСервере
Функция AVS_ЭлементСуществует(Имя)
    Возврат ЭтаФорма.Элементы.Найти(Имя) <> Неопределено;
КонецФункции

&НаКлиенте
Процедура ХарРазорватьКоманда(Команда)
    
    Если Объект.Ссылка.Пустая() Тогда
        Сообщить("Связка еще не создана!");
        Возврат;
    КонецЕсли;
    
    // 1. Спрашиваем подтверждение
    ОписаниеОповещения = Новый ОписаниеОповещения("ПослеПодтвержденияРазрываСвязки", ЭтотОбъект);
    ПоказатьВопрос(ОписаниеОповещения, "Вы уверены, что хотите ПОЛНОСТЬЮ удалить эту группу? 
    |Все товары будут отвязаны друг от друга, а схема характеристик удалена.", РежимДиалогаВопрос.ДаНет);
    
КонецПроцедуры

&НаКлиенте
Процедура ПослеПодтвержденияРазрываСвязки(Результат, ДопПараметры) Экспорт
    
    Если Результат = КодВозвратаДиалога.Да Тогда
        // 2. Выполняем удаление на сервере
        РазорватьСвязкуНаСервере();
        
        Сообщить("Связка полностью разорвана, группа удалена.");
        
        // 3. Закрываем форму. 
        // Оповещение в карточке товара сработает автоматически и обновит интерфейс.
        Закрыть(); 
    КонецЕсли;
    
КонецПроцедуры

&НаСервере
Процедура РазорватьСвязкуНаСервере()
    
    // { ПРАВКА: Используем централизованный метод из общего модуля }
    AVS_ОбщийМодульСайт.РазорватьСвязку(Объект.Ссылка);
    
КонецПроцедуры

// { ПРАВКА_КОНЕЦ }
