&НаКлиенте
Процедура AVS_ДобавитьТоварВКатегориюВместо(Команда)
Если Объект.Ссылка.Пустая() Тогда
        ПоказатьПредупреждение(, "Сначала сохраните категорию!");
        Возврат;
    КонецЕсли;
    
    Оповещение = Новый ОписаниеОповещения("ВыбратьТоварыПосле", ЭтотОбъект);
    
    ПараметрыФормы = Новый Структура;
    ПараметрыФормы.Вставить("РежимВыбора", Истина);
    ПараметрыФормы.Вставить("МножественныйВыбор", Истина); 
    
    ОткрытьФорму("Справочник.Номенклатура.ФормаВыбора", ПараметрыФормы, , , , , Оповещение);
КонецПроцедуры
    
&НаКлиенте
Процедура ВыбратьТоварыПосле(Результат, ДополнительныеПараметры) Экспорт
    
   Если Результат = Неопределено Тогда Возврат; КонецЕсли;
    
    ВыбранныеТовары = ?(ТипЗнч(Результат) = Тип("Массив"), Результат, Новый Массив);
    Если ТипЗнч(Результат) <> Тип("Массив") Тогда ВыбранныеТовары.Добавить(Результат); КонецЕсли;
    
    // Вызываем серверный метод для безопасного добавления в ТЗ
    AVS_ДобавитьТоварыВБуферНаСервере(ВыбранныеТовары);      
КонецПроцедуры  

&НаСервере
Процедура AVS_ДобавитьТоварыВБуферНаСервере(МассивТоваров)
    
    Для Каждого Товар Из МассивТоваров Цикл
        // На сервере метод НайтиСтроки доступен
        ПараметрыОтбора = Новый Структура("Номенклатура", Товар);
        Если СписокТоваровКатегории.НайтиСтроки(ПараметрыОтбора).Количество() = 0 Тогда
            НоваяСтр = СписокТоваровКатегории.Добавить();
            НоваяСтр.Номенклатура = Товар;
            НоваяСтр.СвязкаАктивна = Истина;
            ЭтаФорма.Модифицированность = Истина;
        КонецЕсли;
    КонецЦикла;
    
КонецПроцедуры

&НаСервере
Процедура AVS_ДобавитьТоварВКатегориюВместоНаСервере(ВыбранныеТовары)
	НачатьТранзакцию();
    
    Попытка
        Набор = РегистрыСведений.AVS_СоставКатегорийНоменклатуры.СоздатьНаборЗаписей();
        Набор.Отбор.Категория.Установить(Объект.Ссылка);
        
        // 1. Читаем текущий состав из базы, чтобы ДОПОЛНИТЬ его
        Набор.Прочитать(); 
        
        // 2. Индексируем текущие товары для быстрого поиска дублей
        СуществующиеТовары = Новый Соответствие;
        Для Каждого Запись Из Набор Цикл
            СуществующиеТовары.Вставить(Запись.Номенклатура, Истина);
        КонецЦикла;
        
        // 3. Добавляем только новые товары
        НовыхДобавлено = 0;
        Для Каждого Товар Из ВыбранныеТовары Цикл
            Если СуществующиеТовары[Товар] = Неопределено Тогда
                НоваяЗапись = Набор.Добавить();
                НоваяЗапись.Категория = Объект.Ссылка;
                НоваяЗапись.Номенклатура = Товар;
                НоваяЗапись.СвязкаАктивна = Истина;
                
                СуществующиеТовары.Вставить(Товар, Истина);
                НовыхДобавлено = НовыхДобавлено + 1;
            КонецЕсли;
        КонецЦикла;
        
        // 4. Записываем весь набор (старые + новые)
        Набор.Записать(Истина);
        
        AVS_РегистрацияИзмененияКатегории(Объект.Ссылка);
        
        ЗафиксироватьТранзакцию();
        Сообщить(СтрШаблон("[AVS DEBUG]: Добавлено новых: %1. Всего в категории: %2", НовыхДобавлено, Набор.Количество()));
        
    Исключение
        ОтменитьТранзакцию();
        Сообщить("[AVS ERROR]: Ошибка массового добавления: " + ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

&НаСервере
Функция ТоварУжеДобавленВКатегорию(Категория, Товар)
    
    Запрос = Новый Запрос;
    Запрос.Текст = 
    "ВЫБРАТЬ
    |   ПЕРВЫЕ 1 1 КАК Флаг
    |ИЗ
    |   РегистрСведений.AVS_СоставКатегорийНоменклатуры КАК Состав
    |ГДЕ
    |   Состав.Категория = &Категория
    |   И Состав.Номенклатура = &Номенклатура";
    
    Запрос.УстановитьПараметр("Категория", Категория);
    Запрос.УстановитьПараметр("Номенклатура", Товар);
    
    Результат = Запрос.Выполнить();
    Выборка = Результат.Выбрать();
    
    Возврат Выборка.Следующий();
    
КонецФункции

&НаКлиенте
Процедура УдалитьТоварИзКатегории(Команда)
    
    ТекущаяСтрока = Элементы.ТаблицаТоварыКатегории.ТекущиеДанные;
    Если ТекущаяСтрока = Неопределено Тогда Возврат; КонецЕсли;
    
    // Проверка возможности удаления (ТЗ 1.6)
    РезультатПроверки = AVS_ПроверитьВозможностьУдаленияТовараНаСервере(ТекущаяСтрока.Номенклатура);
    
    Если РезультатПроверки.Разрешено Тогда
        // В Тонком клиенте Удалить() работает по объекту строки
        СписокТоваровКатегории.Удалить(ТекущаяСтрока);
        ЭтаФорма.Модифицированность = Истина;
    Иначе
        ПоказатьПредупреждение(, РезультатПроверки.Сообщение);
    КонецЕсли;    
    
КонецПроцедуры

&НаСервере
Процедура УдалитьТоварИзКатегорииНаСервере(Категория, Товар)
    
    // { ПРАВКА_НАЧАЛО: Проверка перед удалением товара из категории (08.04.2026)
	// Требование ТЗ: если после удаления у товара не останется ни одной категории,
	// но он участвует в связке номенклатуры — запрещаем удаление и выводим сообщение.
	// Видимость (запись в регистре) не меняется.
	// Добавлена полная отладочная информация и безопасные проверки.
	// }
	Попытка
		
		Сообщить("[AVS DEBUG]: === ПРОВЕРКА ПЕРЕД УДАЛЕНИЕМ ТОВАРА ИЗ КАТЕГОРИИ ===");
		Сообщить("[AVS DEBUG]: Категория = " + Строка(Категория) + ", Товар = " + Строка(Товар));
		
		// 1. Проверка корректности параметров
		Если Не ЗначениеЗаполнено(Товар) Или ТипЗнч(Товар) <> Тип("СправочникСсылка.Номенклатура") Тогда
			Сообщить("[AVS WARNING]: Некорректный параметр Товар (пустой или неверный тип).");
			// Продолжаем выполнение оригинального кода (не блокируем)
		ИначеЕсли Не ЗначениеЗаполнено(Категория) Или ТипЗнч(Категория) <> Тип("СправочникСсылка.AVS_КатегорииНоменклатурыСайт") Тогда
			Сообщить("[AVS WARNING]: Некорректный параметр Категория (пустой или неверный тип).");
		Иначе
			
			// 2. Определяем текущее количество категорий у товара
			КоличествоКатегорий = 0;
			Попытка
				Запрос = Новый Запрос;
				Запрос.Текст = 
				"ВЫБРАТЬ
				|	КОЛИЧЕСТВО(*) КАК Количество
				|ИЗ
				|	РегистрСведений.AVS_СоставКатегорийНоменклатуры КАК Состав
				|ГДЕ
				|	Состав.Номенклатура = &Номенклатура";
				
				Запрос.УстановитьПараметр("Номенклатура", Товар);
				Выборка = Запрос.Выполнить().Выбрать();
				
				Если Выборка.Следующий() Тогда
					КоличествоКатегорий = Выборка.Количество;
				КонецЕсли;
			Исключение
				Сообщить("[AVS ERROR]: Ошибка при подсчёте количества категорий: " + ОписаниеОшибки());
			КонецПопытки;
			
			Сообщить("[AVS DEBUG]: Текущее количество категорий у товара = " + Строка(КоличествоКатегорий));
			
			// 3. Проверяем участие товара в связке
			УчаствуетВСвязке = Ложь;
			ИдентификаторСвязки = Неопределено;
			Попытка
				Если ЗначениеЗаполнено(Товар) Тогда
					ИдентификаторСвязки = AVS_ОбщийМодульСайт.ПолучитьИдентификаторСвязкиТовара(Товар);
					УчаствуетВСвязке = ЗначениеЗаполнено(ИдентификаторСвязки);
				КонецЕсли;
			Исключение
				Сообщить("[AVS WARNING]: Не удалось проверить участие в связке: " + ОписаниеОшибки());
			КонецПопытки;
			
			Сообщить("[AVS DEBUG]: Участие в связке = " + ?(УчаствуетВСвязке, "ДА (GUID: " + Строка(ИдентификаторСвязки) + ")", "НЕТ"));
			
			// 4. Основная проверка по требованию
			Если КоличествоКатегорий <= 1 И УчаствуетВСвязке Тогда
				
				Сообщить("[AVS DEBUG]: === УДАЛЕНИЕ ЗАБЛОКИРОВАНО ===");
				Сообщить("Товар не может быть сейчас удалён из категории, т.к. участвует в связке товаров. Сначала удалите товар из связки.");
				Сообщить("[AVS DEBUG]: Запись в регистре AVS_СоставКатегорийНоменклатуры НЕ УДАЛЕНА.");
				
				// Записываем в лог
				Попытка
					AVS_ЗаписатьВЛогНаСервере("Попытка удаления заблокирована. Товар: " + Строка(Товар) + 
						", Категория: " + Строка(Категория) + 
						". Причина: последняя категория + участие в связке.");
				Исключение
				КонецПопытки;
				
				Возврат; // ← ВЫХОДИМ БЕЗ УДАЛЕНИЯ ЗАПИСИ
			КонецЕсли;
			
			Сообщить("[AVS DEBUG]: Проверка пройдена. Продолжаем удаление записи из регистра.");
			
		КонецЕсли;
		
	Исключение
		Сообщить("[AVS ERROR]: Ошибка в блоке проверки удаления товара из категории: " + ОписаниеОшибки());
		// При любой ошибке в проверке — продолжаем оригинальное удаление (не блокируем функционал)
	КонецПопытки;
	// { ПРАВКА_КОНЕЦ }
	
	// ============================================================================
	// ОРИГИНАЛЬНЫЙ КОД (без изменений)
	// ============================================================================
	
	// Удаляем запись через менеджер записи
	МенеджерЗаписи = РегистрыСведений.AVS_СоставКатегорийНоменклатуры.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Категория = Категория;
	МенеджерЗаписи.Номенклатура = Товар;
	
	Попытка
		МенеджерЗаписи.Удалить();
		
		// Регистрируем изменение категории
		AVS_РегистрацияИзмененияКатегории(Категория);
		
	Исключение
		// Игнорируем ошибку, если записи нет
	КонецПопытки;
    
КонецПроцедуры

&НаКлиенте
Процедура AVS_ОбновитьСписокТоваровВместо(Команда)
	// Перечитываем данные из базы в буфер (с потерей несохраненных изменений!)
	AVS_ЗагрузитьТоварыНаСервере();
КонецПроцедуры

 
// { ПРАВКА_НАЧАЛО: Прямое переключение статуса в списке и массовая обработка }

&НаКлиенте
Процедура ТаблицаТоварыКатегорииСвязкаАктивнаПриИзменении(Элемент)
	ТекДанные = Элементы.ТаблицаТоварыКатегории.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда Возврат; КонецЕсли;
	
	// Если пользователь ПЫТАЕТСЯ СНЯТЬ галочку (новое значение = Ложь)
	Если ТекДанные.СвязкаАктивна = Ложь Тогда
		
		РезультатПроверки = AVS_ПроверитьВозможностьОтключенияВидимостиНаСервере(ТекДанные.Номенклатура);
		
		Если Не РезультатПроверки.Разрешено Тогда
			// Возвращаем галочку назад
			ТекДанные.СвязкаАктивна = Истина;
			ПоказатьПредупреждение(, РезультатПроверки.Сообщение);
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	ЭтаФорма.Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура AVS_ЗаписатьСтатусСвязкиНаСервере(Товар, НовоеСостояние)
	
	// Проверка типов параметров
	Если Не ЗначениеЗаполнено(Товар) Тогда Возврат; КонецЕсли;
	
	// Используем менеджер записи для точечного обновления
	МенеджерЗаписи = РегистрыСведений.AVS_СоставКатегорийНоменклатуры.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Номенклатура = Товар;
	МенеджерЗаписи.Категория    = Объект.Ссылка;
	
	МенеджерЗаписи.Прочитать(); // Читаем, чтобы не потерять другие данные строки
	МенеджерЗаписи.СвязкаАктивна = НовоеСостояние;
	
	Попытка
		МенеджерЗаписи.Записать(Истина); // Замещать = Истина
	Исключение
		ВызватьИсключение "Ошибка записи в регистр: " + ОписаниеОшибки();
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаТоварыКатегорииВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	// 1. Если мы хотим, чтобы двойной клик по колонке "Номенклатура" 
	// открывал карточку товара, а не переключал галочку:
	Если Поле.Имя = "ТаблицаТоварыКатегорииНоменклатура" Тогда
		Возврат; // СтандартнаяОбработка останется Истина, и откроется карточка
	КонецЕсли;

	// 2. Для остальных колонок (или если кликнули прямо по галочке)
	СтандартнаяОбработка = Ложь;
	
	ТекДанные = Элементы.ТаблицаТоварыКатегории.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		
		// Если сейчас галочка СТОИТ и её хотят СНЯТЬ
		Если ТекДанные.СвязкаАктивна = Истина Тогда
			
			РезультатПроверки = AVS_ПроверитьВозможностьОтключенияВидимостиНаСервере(ТекДанные.Номенклатура);
			
			Если Не РезультатПроверки.Разрешено Тогда
				ПоказатьПредупреждение(, РезультатПроверки.Сообщение);
				Возврат;
			КонецЕсли;
			
		КонецЕсли;
		
		// Переключаем значение
		ТекДанные.СвязкаАктивна = Не ТекДанные.СвязкаАктивна;
		ЭтаФорма.Модифицированность = Истина;
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура AVS_АктивироватьВыделенныеТовары(Команда)
	
	Для Каждого Ид Из Элементы.ТаблицаТоварыКатегории.ВыделенныеСтроки Цикл
		Стр = СписокТоваровКатегории.НайтиПоИдентификатору(Ид);
		Если Стр <> Неопределено Тогда
			Стр.СвязкаАктивна = Истина;
		КонецЕсли;
	КонецЦикла;
	ЭтаФорма.Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура AVS_ИзменитьСтатусГруппеНаСервере(МассивТоваров, НовыйСтатус)
	
	// { ИСПРАВЛЕНО }: Работаем с массивом ссылок, а не с элементами формы
	Для Каждого ТоварСсылка Из МассивТоваров Цикл
		AVS_ЗаписатьСтатусСвязкиНаСервере(ТоварСсылка, НовыйСтатус);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция AVS_ПроверитьВозможностьУдаленияТовараНаСервере(Товар)
    
    Результат = Новый Структура("Разрешено, Сообщение", Истина, "");
    
    // 1. Считаем количество категорий у товара в БАЗЕ
    Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК КолВо ИЗ РегистрСведений.AVS_СоставКатегорийНоменклатуры ГДЕ Номенклатура = &Товар");
    Запрос.УстановитьПараметр("Товар", Товар);
    Выборка = Запрос.Выполнить().Выбрать();
    
    КолВоКатегорий = 0;
    Если Выборка.Следующий() Тогда КолВоКатегорий = Выборка.КолВо; КонецЕсли;
    
    // 2. Если это последняя категория, проверяем участие в связке
    Если КолВоКатегорий <= 1 Тогда
        Связка = AVS_ОбщийМодульСайт.ПолучитьИдентификаторСвязкиТовара(Товар);
        Если ЗначениеЗаполнено(Связка) Тогда
            Результат.Разрешено = Ложь;
            Результат.Сообщение = "Товар не может быть удалён из последней категории, так как он участвует в связке товаров!";
        КонецЕсли;
    КонецЕсли;
    
    Возврат Результат;
    
КонецФункции

&НаСервере
Функция AVS_ПроверитьВозможностьОтключенияВидимостиНаСервере(Товар)
    
    Результат = Новый Структура("Разрешено, Сообщение", Истина, "");
    
    // 1. Считаем количество АКТИВНЫХ связей товара с категориями в БАЗЕ
    Запрос = Новый Запрос;
    Запрос.Текст = 
    "ВЫБРАТЬ
    |	КОЛИЧЕСТВО(*) КАК КолВо
    |ИЗ
    |	РегистрСведений.AVS_СоставКатегорийНоменклатуры КАК Состав
    |ГДЕ
    |	Состав.Номенклатура = &Товар
    |	И Состав.СвязкаАктивна = ИСТИНА";
    
    Запрос.УстановитьПараметр("Товар", Товар);
    Выборка = Запрос.Выполнить().Выбрать();
    
    КолВоАктивных = 0;
    Если Выборка.Следующий() Тогда КолВоАктивных = Выборка.КолВо; КонецЕсли;
    
    // 2. Если это последняя активная категория, проверяем участие в связке вариаций
    Если КолВоАктивных <= 1 Тогда
        Связка = AVS_ОбщийМодульСайт.ПолучитьИдентификаторСвязкиТовара(Товар);
        Если ЗначениеЗаполнено(Связка) Тогда
            Результат.Разрешено = Ложь;
            Результат.Сообщение = "Нельзя отключить видимость товара в этой категории, так как он участвует в связке вариаций и это его последняя активная категория!";
        КонецЕсли;
    КонецЕсли;
    
    Возврат Результат;
    
КонецФункции




#КонецОбласти

&НаСервере
Процедура AVS_ОбновитьСписокПослеЗаписиНаСервере()
    
    // 1. Обновляем параметры динамических списков (характеристики и товары)
