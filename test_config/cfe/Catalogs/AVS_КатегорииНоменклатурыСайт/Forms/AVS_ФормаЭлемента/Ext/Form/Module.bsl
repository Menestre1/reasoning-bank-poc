 &НаСервере
Процедура AVS_ПриСозданииНаСервереВместо(Отказ, СтандартнаяОбработка)
	
	// 1. Настройка параметров динамических списков
		УстановитьПараметрыДинамическихСписков();
		
	// 2. Отображение GUID
	Если Не Объект.Ссылка.Пустая() Тогда
                
        GUIDКатегории = Строка(Объект.Ссылка.УникальныйИдентификатор());
    Иначе
        GUIDКатегории = "GUID будет создан при записи!";
    КонецЕсли;
    
    // 3. Настройка интерфейса (растягивание)
    Элементы.СтраницыКатегории.РастягиватьПоВертикали = Истина;
    Элементы.СтраницаХарактеристики.РастягиватьПоВертикали = Истина;
    Элементы.ТаблицаХарактеристикиКатегории.РастягиватьПоВертикали = Истина;
    Элементы.СтраницаТовары.РастягиватьПоВертикали = Истина;
    Элементы.ТаблицаТоварыКатегории.РастягиватьПоВертикали = Истина;
	
    // 4. Скрытие лишних команд управления товарами
    Попытка
        // --- А) СКРЫВАЕМ СТАНДАРТНЫЕ КНОПКИ ---
        // Для Таблицы Значений стандартные кнопки называются так:
        Элементы.ТаблицаТоварыКатегорииДобавить.Видимость = Ложь;
        Элементы.ТаблицаТоварыКатегорииУдалить.Видимость  = Ложь;
        Элементы.ТаблицаТоварыКатегорииСкопировать.Видимость = Ложь;
		
		КнВверх = Элементы.ТаблицаТоварыКатегорииПереместитьВверх;
        КнВниз  = Элементы.ТаблицаТоварыКатегорииПереместитьВниз;
        
        Панель = Элементы.ТаблицаТоварыКатегорииКоманднаяПанель;
        КнУдалитьКастом = Элементы.КнопкаУдалитьТовар; // Наша кнопка "Удалить"
        
        // Ставим стандартные стрелочки ПЕРЕД нашей кнопкой "Удалить"
        // (в итоге они окажутся сразу после нашей кнопки "Добавить")
        ЭтаФорма.Элементы.Переместить(КнВверх, Панель, КнУдалитьКастом);
        ЭтаФорма.Элементы.Переместить(КнВниз,  Панель, КнУдалитьКастом);
        
        // --- В) ЧИСТИМ КОНТЕКСТНОЕ МЕНЮ (правая кнопка мыши) ---
        Элементы.ТаблицаТоварыКатегорииКонтекстноеМенюДобавить.Видимость = Ложь;
        Элементы.ТаблицаТоварыКатегорииКонтекстноеМенюУдалить.Видимость  = Ложь;
        Элементы.ТаблицаТоварыКатегорииКонтекстноеМенюСкопировать.Видимость = Ложь;
        
    Исключение
        // Игнорируем, если каких-то элементов нет (защита от ошибок платформы)
    КонецПопытки;

    // 5. Автоматическая установка порядка сортировки для новых элементов
    Если Объект.Ссылка.Пустая() И Параметры.Ключ.Пустая() Тогда
        Если Объект.ПорядокСортировки = 0 Тогда
            Объект.ПорядокСортировки = AVS_ПолучитьСледующийПорядокКатегорииНаСервере(Объект.Родитель);
        КонецЕсли;
	КонецЕсли;
	
	// 11.04.2026 Загружаем характеристики текущей категории и всех родителей (ТЗ 1.4)
	AVS_ЗагрузитьХарактеристикиНаСервере();
	AVS_ЗагрузитьТоварыНаСервере();
	
	// { ПРАВКА: 10.04.2026 Условное оформление таблицы характеристик (ТЗ 1.4) }
	
	// Создаем новый элемент оформления
	Элемент = УсловноеОформление.Элементы.Добавить();
	Элемент.ИдентификаторПользовательскойНастройки = "AVS_ХарактеристикиРодителей"; // Ключ для поиска
	
	// 1. Что оформляем: Цвет текста = Серый
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.Серый);
	
	// 2. Когда оформляем: Источник НЕ РАВЕН текущей категории
	КомпоновкаОтбора = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	КомпоновкаОтбора.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("СписокХарактеристикКатегории.Источник");
	КомпоновкаОтбора.ВидСравнения   = ВидСравненияКомпоновкиДанных.НеРавно;
	КомпоновкаОтбора.ПравоеЗначение = Объект.Ссылка; // При создании здесь ПустаяСсылка
	КомпоновкаОтбора.Использование  = Истина;
	
	// 3. Где оформляем: Вся строка таблицы
	ПолеОформления = Элемент.Поля.Элементы.Добавить();
	ПолеОформления.Поле = Новый ПолеКомпоновкиДанных("ТаблицаХарактеристикиКатегории");
	
		
	// { КОНЕЦ ПРАВКИ }
	
КонецПроцедуры  


// { ПРАВКА: 11.04.2026 Процедура загрузки характеристик с учетом новых объектов }
&НаСервере
Процедура AVS_ЗагрузитьХарактеристикиНаСервере()
	
	СписокХарактеристикКатегории.Очистить();
	
	// 1. Определяем массив категорий для поиска характеристик
	Если Объект.Ссылка.Пустая() Тогда
		// Для нового элемента берем цепочку от родителя (ТЗ 1.4)
		МассивКат = AVS_ВыгрузкаНаСайт.AVS_ПолучитьМассивРодителей(Объект.Родитель);
	Иначе
		// Для существующего - от самого себя
		МассивКат = AVS_ВыгрузкаНаСайт.AVS_ПолучитьМассивРодителей(Объект.Ссылка);
		МассивКат.Добавить(Объект.Ссылка);
	КонецЕсли;
	
	// 2. Запрос характеристик
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ 
	|	Свойство, 
	|	ПорядокСортировки, 
	|	Категория КАК Источник,
	|	ВЫБОР КОГДА Категория = &ТекущаяКатегория ТОГДА 1 ИНАЧЕ 0 КОНЕЦ КАК ТипИсточника
	|ИЗ 
	|	РегистрСведений.AVS_ХарактеристикиКатегорий 
	|ГДЕ 
	|	Категория В (&Массив)
	|УПОРЯДОЧИТЬ ПО 
	|	ТипИсточника ВОЗР, 
	|	ПорядокСортировки ВОЗР";
	
	Запрос.УстановитьПараметр("Массив", МассивКат);
	Запрос.УстановитьПараметр("ТекущаяКатегория", Объект.Ссылка);
	
	СписокХарактеристикКатегории.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры


// { ПРАВКА: Обработчик изменения родителя для мгновенного обновления характеристик }
&НаКлиенте
Процедура РодительПриИзменении(Элемент)
	AVS_ЗагрузитьХарактеристикиНаСервере();
КонецПроцедуры

&НаСервере
Процедура УстановитьПараметрыДинамическихСписков()
	
	// 1. Параметры для списка ХАРАКТЕРИСТИК (с учетом наследования)
	МассивКатегорий = AVS_ВыгрузкаНаСайт.AVS_ПолучитьМассивРодителей(Объект.Ссылка);
	
	// Если категория новая, но родитель выбран - показываем его характеристики для превью
	Если МассивКатегорий.Количество() = 0 И ЗначениеЗаполнено(Объект.Родитель) Тогда
		МассивКатегорий = AVS_ВыгрузкаНаСайт.AVS_ПолучитьМассивРодителей(Объект.Родитель);
	КонецЕсли;
	
		
КонецПроцедуры	
	
&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если Отказ Тогда Возврат; КонецЕсли;
	// 1. СРАВНЕНИЕ ХАРАКТЕРИСТИК (уже было)
    // { ПРАВКА: Умное определение изменений характеристик }
	Набор = РегистрыСведений.AVS_ХарактеристикиКатегорий.СоздатьНаборЗаписей();
	Набор.Отбор.Категория.Установить(ТекущийОбъект.Ссылка);
	
	// Формируем таблицу нового состава для сравнения
	НовыйСостав = Новый ТаблицаЗначений;
	НовыйСостав.Колонки.Добавить("Свойство");
	НовыйСостав.Колонки.Добавить("ПорядокСортировки");
	
	Для Каждого Стр Из СписокХарактеристикКатегории Цикл
		// Своими считаем те, где источник пуст (новые) или совпадает с нами
		Если Стр.Источник.Пустая() Или Стр.Источник = ТекущийОбъект.Ссылка Тогда
			НоваяСтр = НовыйСостав.Добавить();
			НоваяСтр.Свойство = Стр.Свойство;
			НоваяСтр.ПорядокСортировки = Стр.ПорядокСортировки;
		КонецЕсли;
	КонецЦикла;
	НовыйСостав.Сортировать("Свойство");
	
	// Читаем текущий состав из БД
	Набор.Прочитать();
	СтарыйСостав = Набор.Выгрузить();
	СтарыйСостав.Сортировать("Свойство");
	
	// Сравниваем составы
	ХарактеристикиИзменены = Ложь;
	Если СтарыйСостав.Количество() <> НовыйСостав.Количество() Тогда
		ХарактеристикиИзменены = Истина;
	Иначе
		Для Сч = 0 По СтарыйСостав.Количество() - 1 Цикл
			Если СтарыйСостав[Сч].Свойство <> НовыйСостав[Сч].Свойство 
			   Или СтарыйСостав[Сч].ПорядокСортировки <> НовыйСостав[Сч].ПорядокСортировки Тогда
				ХарактеристикиИзменены = Истина; Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	// Если характеристики изменились — ставим флаг для общего модуля
	Если ХарактеристикиИзменены Тогда
		ТекущийОбъект.ДополнительныеСвойства.Вставить("AVS_ХарактеристикиИзменены", Истина);
	КонецЕсли;
	
	// 2. СРАВНЕНИЕ ТОВАРОВ
	Запрос = Новый Запрос("ВЫБРАТЬ Номенклатура, СвязкаАктивна ИЗ РегистрСведений.AVS_СоставКатегорийНоменклатуры ГДЕ Категория = &Кат");
	Запрос.УстановитьПараметр("Кат", ТекущийОбъект.Ссылка);
	ТабБаза = Запрос.Выполнить().Выгрузить();
	
	МассивЗатронутыхТоваров = Новый Массив;
	ТоварыИзменены = Ложь;

	МассивНовых      = Новый Массив; // Те, кого нет в базе (INSERT)
	МассивИзмененных = Новый Массив; // Те, кто есть, но сменил галочку (UPDATE)
	МассивУдаленных  = Новый Массив; // Те, кто исчез из списка (AUTO: UPDATE/DELETE)
	
	ТоварыИзменены = Ложь;

	// 1. Сравниваем базу с формой (ищем Удаленных и Измененных)
	Для Каждого СтрБаза Из ТабБаза Цикл
		Отбор = Новый Структура("Номенклатура", СтрБаза.Номенклатура);
		НайденныеСтроки = СписокТоваровКатегории.НайтиСтроки(Отбор);
		
		Если НайденныеСтроки.Количество() = 0 Тогда
			МассивУдаленных.Добавить(СтрБаза.Номенклатура);
			ТоварыИзменены = Истина;
		ИначеЕсли НайденныеСтроки[0].СвязкаАктивна <> СтрБаза.СвязкаАктивна Тогда
			МассивИзмененных.Добавить(СтрБаза.Номенклатура);
			ТоварыИзменены = Истина;
		КонецЕсли;
	КонецЦикла;
	
	// 2. Сравниваем форму с базой (ищем Новых)
	Для Каждого СтрФорма Из СписокТоваровКатегории Цикл
		Отбор = Новый Структура("Номенклатура", СтрФорма.Номенклатура);
		Если ТабБаза.НайтиСтроки(Отбор).Количество() = 0 Тогда
			МассивНовых.Добавить(СтрФорма.Номенклатура);
			ТоварыИзменены = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Если ТоварыИзменены Тогда
		ТекущийОбъект.ДополнительныеСвойства.Вставить("AVS_МассивНовых",      МассивНовых);
		ТекущийОбъект.ДополнительныеСвойства.Вставить("AVS_МассивИзмененных", МассивИзмененных);
		ТекущийОбъект.ДополнительныеСвойства.Вставить("AVS_МассивУдаленных",  МассивУдаленных);
		ТекущийОбъект.ДополнительныеСвойства.Вставить("AVS_ТоварыИзменены",   Истина);
	КонецЕсли;	
    
КонецПроцедуры

&После("ПриЗаписиНаСервере")
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	// Если основная запись уже была отменена по каким-то причинам, ничего не делаем
	Если Отказ Тогда Возврат; КонецЕсли;
	
	// 1. ЗАПИСЬ ХАРАКТЕРИСТИК
	// { ПРАВКА: Запись характеристик только когда Ссылка уже точно есть }
	Если ТекущийОбъект.ДополнительныеСвойства.Свойство("AVS_ХарактеристикиИзменены") Тогда
		
		Набор = РегистрыСведений.AVS_ХарактеристикиКатегорий.СоздатьНаборЗаписей();
		Набор.Отбор.Категория.Установить(ТекущийОбъект.Ссылка);
		
		Для Каждого Стр Из СписокХарактеристикКатегории Цикл
			Если Стр.Источник.Пустая() Или Стр.Источник = ТекущийОбъект.Ссылка Тогда
				Запись = Набор.Добавить();
				Запись.Категория = ТекущийОбъект.Ссылка; // Теперь ссылка НЕ ПУСТАЯ
				Запись.Свойство = Стр.Свойство;
				Запись.ПорядокСортировки = Стр.ПорядокСортировки;
				
				// Обновляем визуально на форме
				Стр.Источник = ТекущийОбъект.Ссылка;
			КонецЕсли;
		КонецЦикла;
		
		// Флаг "ЗаписьИзФормы" нужен, чтобы подписка регистра не дублировала события
		Набор.ДополнительныеСвойства.Вставить("AVS_ЗаписьИзФормы", Истина);
		Набор.Записать();
		
	КонецЕсли;
	
	// 2. ЗАПИСЬ ТОВАРОВ (ОДНИМ ПАКЕТОМ)
	Если ТекущийОбъект.ДополнительныеСвойства.Свойство("AVS_ТоварыИзменены") Тогда
		
		Набор = РегистрыСведений.AVS_СоставКатегорийНоменклатуры.СоздатьНаборЗаписей();
		Набор.Отбор.Категория.Установить(ТекущийОбъект.Ссылка);
		
		Для Каждого Стр Из СписокТоваровКатегории Цикл
			Запись = Набор.Добавить();
			Запись.Категория = ТекущийОбъект.Ссылка;
			Запись.Номенклатура = Стр.Номенклатура;
			Запись.СвязкаАктивна = Стр.СвязкаАктивна;
		КонецЦикла;
		
		Набор.Записать(Истина); // Физически обновляем регистр
		
		// 3. РЕГИСТРАЦИЯ ИЗМЕНЕНИЙ ДЛЯ САЙТА
		Для Каждого Товар Из ТекущийОбъект.ДополнительныеСвойства.AVS_МассивНовых Цикл
			AVS_ПриЗаписиНоменклатуры.ЗарегистрироватьИзменениеТовара(Товар, "INSERT");
		КонецЦикла;
		
		// ИЗМЕНЕННЫЕ (галочка) -> Обновление (UPDATE)
		Для Каждого Товар Из ТекущийОбъект.ДополнительныеСвойства.AVS_МассивИзмененных Цикл
			AVS_ПриЗаписиНоменклатуры.ЗарегистрироватьИзменениеТовара(Товар, "UPDATE");
		КонецЦикла;
		
		// УДАЛЕННЫЕ -> Авто-выбор (UPDATE если остался в др. категориях, иначе DELETE)
		Для Каждого Товар Из ТекущийОбъект.ДополнительныеСвойства.AVS_МассивУдаленных Цикл
			AVS_ПриЗаписиНоменклатуры.ЗарегистрироватьИзменениеТовара(Товар);
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

 &НаКлиенте
Процедура ПроверитьСсылкуКомандаВыполнить(Команда)
    
    Ссылка = Объект.СсылкаНаИзображение;
    
    Если ПустаяСтрока(Ссылка) Тогда
        ПоказатьПредупреждение(Новый ОписаниеОповещения("ПослеПустойСсылки", ЭтотОбъект),
            "Ссылка на изображение не указана!");
        Возврат;
    КонецЕсли;
    
    // Проверяем и добавляем протокол
    Если Найти(Ссылка, "http://") = 0 И Найти(Ссылка, "https://") = 0 Тогда
        Ссылка = "http://" + Ссылка;
    КонецЕсли;
    
    // Используем ДРУГОЕ имя переменной
    ПараметрыОповещения = Новый Структура;
    ПараметрыОповещения.Вставить("Ссылка", Ссылка);
    
    ПоказатьВопрос(Новый ОписаниеОповещения("ПослеПодтвержденияОткрытия", ЭтотОбъект, ПараметрыОповещения),
        "Открыть в браузере ссылку?" + Символы.ПС + Ссылка,
        РежимДиалогаВопрос.ДаНет);
    
КонецПроцедуры

&НаКлиенте
Процедура ПослеПодтвержденияОткрытия(Результат, ПараметрыОповещения) Экспорт
    
    Если Результат = КодВозвратаДиалога.Да Тогда
        Ссылка = ПараметрыОповещения.Ссылка;
        ЗапуститьПриложение(Ссылка);
    КонецЕсли;
    
КонецПроцедуры

&НаСервере
Процедура AVS_ПриЧтенииНаСервереВместо(ТекущийОбъект)
    
    // Обновляем все списки при переключении между элементами
	УстановитьПараметрыДинамическихСписков();
	
	
	//11.04.2026 { ПРАВКА: Обновляем таблицу характеристик }
	AVS_ЗагрузитьХарактеристикиНаСервере();
	AVS_ЗагрузитьТоварыНаСервере();
	
	// Обновляем GUID на форме
	Если Не ТекущийОбъект.Ссылка.Пустая() Тогда
		GUIDКатегории = Строка(ТекущийОбъект.Ссылка.УникальныйИдентификатор());
	КонецЕсли;
    
КонецПроцедуры

// Добавим обработчик удаления для появления звездочки
&НаКлиенте
Процедура СписокХарактеристикКатегорииПередУдалением(Элемент, Отказ)
	// При удалении строки динамического списка тоже ставим звездочку
	ЭтаФорма.Модифицированность = Истина;
КонецПроцедуры

&НаКлиенте
Процедура СписокХарактеристикКатегорииПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ТекущиеДанные = Элемент.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда Возврат; КонецЕсли;
	
	// Если это новая строка - заполняем источник
	Если НоваяСтрока Тогда
		ТекущиеДанные.Источник = Объект.Ссылка;
		ТекущиеДанные.ПорядокСортировки = 50; // Значение по умолчанию
	КонецЕсли;
	
	// Запрещаем редактировать родительские характеристики (ТЗ 1.4)
	Если ТекущиеДанные.Источник <> Объект.Ссылка Тогда
		Элемент.ТолькоПросмотр = Истина; 
		// Чтобы не блокировать всю таблицу, лучше использовать Отказ в ПередНачаломИзменения
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокХарактеристикКатегорииПередНачаломИзменения(Элемент, Отказ)
	ТекущиеДанные = Элемент.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено И ТекущиеДанные.Источник <> Объект.Ссылка Тогда
		// Родительские характеристики менять нельзя, их нужно менять в родительской категории
		Отказ = Истина; 
		ПоказатьПредупреждение(, "Эту характеристику можно изменить только в категории: " + ТекущиеДанные.Источник);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура AVS_ПослеЗаписиПосле(ПараметрыЗаписи)
	// Вызываем серверную процедуру для принудительного обновления списка
	AVS_ОбновитьСписокПослеЗаписиНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура AVS_ДобавитьХарактеристикуКомандаВместо(Команда)
	// Рассчитываем порядок на основании данных в таблице формы
    МаксПорядок = 0;
    Для Каждого Стр Из СписокХарактеристикКатегории Цикл
        МаксПорядок = Макс(МаксПорядок, Стр.ПорядокСортировки);
    КонецЦикла;
    СледующийПорядок = МаксПорядок + 10;
    
    Оповещение = Новый ОписаниеОповещения("ВыбратьХарактеристикуПосле", ЭтотОбъект, СледующийПорядок);
    
    ПараметрыОтбора = Новый Структура("AVS_ВыгружатьНаСайт", Истина);
    
    ПараметрыФормы = Новый Структура;
    ПараметрыФормы.Вставить("РежимВыбора", Истина);
    ПараметрыФормы.Вставить("Отбор",       ПараметрыОтбора);
	
	
    ОткрытьФорму("ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения.ФормаВыбора", 
        ПараметрыФормы, ЭтотОбъект, , , , Оповещение);	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьХарактеристикуПосле(Результат, Порядок) Экспорт
    
    Если Результат = Неопределено Тогда Возврат; КонецЕсли;
    
    // 1. Проверяем на дубли прямо в таблице формы
    Для Каждого Стр Из СписокХарактеристикКатегории Цикл
        Если Стр.Свойство = Результат Тогда
            ПоказатьПредупреждение(, "Эта характеристика уже добавлена в список!");
            Возврат;
        КонецЕсли;
    КонецЦикла;
    
    // 2. Добавляем строку в Таблицу Значений на форме (в базу пока ничего не пишем!)
    НоваяСтрока = СписокХарактеристикКатегории.Добавить();
    НоваяСтрока.Свойство = Результат;
    НоваяСтрока.Источник = Объект.Ссылка; // Для новой категории будет пустая ссылка, это нормально
    НоваяСтрока.ПорядокСортировки = Порядок;
	
	ЭтаФорма.Модифицированность = Истина;
КонецПроцедуры

&НаСервере
Функция ХарактеристикаУжеДобавлена(Категория, Характеристика)
    
    Запрос = Новый Запрос;
    Запрос.Текст = 
    "ВЫБРАТЬ
    |   ПЕРВЫЕ 1 1 КАК Флаг
    |ИЗ
    |   РегистрСведений.AVS_ХарактеристикиКатегорий КАК Характеристики
    |ГДЕ
    |   Характеристики.Категория = &Категория
    |   И Характеристики.Свойство = &Свойство";
    
    Запрос.УстановитьПараметр("Категория", Категория);
    Запрос.УстановитьПараметр("Свойство", Характеристика);
    
    Результат = Запрос.Выполнить();
    Выборка = Результат.Выбрать();
    
    Возврат Выборка.Следующий();
    
КонецФункции

&НаКлиенте
Процедура ТаблицаХарактеристикиКатегорииПередУдалением(Элемент, Отказ)
	ТекущиеДанные = Элемент.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда Возврат; КонецЕсли;
	
	// { ПРАВКА: Запрет удаления родительских характеристик (ТЗ 1.4) }
	Если ТекущиеДанные.Источник <> Объект.Ссылка Тогда
		Отказ = Истина;
		ПоказатьПредупреждение(, "Нельзя удалить характеристику, унаследованную от родительской категории!");
		Возврат;
	КонецЕсли;
	
	ЭтаФорма.Модифицированность = Истина;
КонецПроцедуры

&НаКлиенте
Процедура AVS_ХарВверхКоманда(Команда)
	Таблица = СписокХарактеристикКатегории;
	ТекДанные = Элементы.ТаблицаХарактеристикиКатегории.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда Возврат; КонецЕсли;
	
	// 1. Саму родительскую строку двигать нельзя
	Если ЗначениеЗаполнено(ТекДанные.Источник) И ТекДанные.Источник <> Объект.Ссылка Тогда
		Возврат;
	КонецЕсли;
	
	Индекс = Таблица.Индекс(ТекДанные);
	Если Индекс > 0 Тогда
		
		// 2. Проверяем строку, которая стоит ВЫШЕ
		СтрокаВыше = Таблица[Индекс - 1];
		Если СтрокаВыше.Источник <> Объект.Ссылка Тогда
			// Выше стоит родительская характеристика. "Своя" не может быть выше родительской.
			ПоказатьПредупреждение(, "Характеристики текущей категории не могут быть выше родительских!");
			Возврат;
		КонецЕсли;
		
		Таблица.Сдвинуть(Индекс, -1);
		ОбновитьПорядокСортировкиВТаблице();
		ЭтаФорма.Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура AVS_ХарВнизКоманда(Команда)
	Таблица = СписокХарактеристикКатегории;
	ТекДанные = Элементы.ТаблицаХарактеристикиКатегории.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда Возврат; КонецЕсли;
	
	// Родительские строки не двигаем
	Если ЗначениеЗаполнено(ТекДанные.Источник) И ТекДанные.Источник <> Объект.Ссылка Тогда
		Возврат;
	КонецЕсли;
	
	Индекс = Таблица.Индекс(ТекДанные);
	Если Индекс < Таблица.Количество() - 1 Тогда
		
		// Проверка на случай, если внизу вдруг оказалась родительская (хотя они обычно сверху)
		СтрокаНиже = Таблица[Индекс + 1];
		Если СтрокаНиже.Источник <> Объект.Ссылка Тогда
			Возврат;
		КонецЕсли;

		Таблица.Сдвинуть(Индекс, 1);
		ОбновитьПорядокСортировкиВТаблице();
		ЭтаФорма.Модифицированность = Истина;
	КонецЕсли;
КонецПроцедуры  

&НаКлиенте
Процедура ОбновитьПорядокСортировкиВТаблице()
	
	ТекущийПорядок = 0;
	
	Для Каждого Стр Из СписокХарактеристикКатегории Цикл
		
		// Определяем, является ли строка "своей" (учитываем новые объекты с пустой ссылкой)
		ЭтоСвояСтрока = (Стр.Источник = Объект.Ссылка) Или (Не ЗначениеЗаполнено(Стр.Источник));
		
		Если Не ЭтоСвояСтрока Тогда
			// 1. Для родительских строк просто запоминаем их порядок как базу для отсчета
			ТекущийПорядок = Макс(ТекущийПорядок, Стр.ПорядокСортировки);
		Иначе
			// 2. Для "своих" строк увеличиваем порядок, начиная от последнего родительского
			ТекущийПорядок = ТекущийПорядок + 10;
			Стр.ПорядокСортировки = ТекущийПорядок;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Серверный wrapper для логирования (так как модуль AVS_Логирование недоступен на клиенте)
&НаСервереБезКонтекста
Процедура AVS_ЗаписатьВЛогНаСервере(ТекстСообщения)
	
	Попытка
		AVS_Логирование.ЗаписатьВЛог(ТекстСообщения);
	Исключение
		ЗаписьЖурналаРегистрации("AVS.Интеграция", УровеньЖурналаРегистрации.Ошибка, , , 
			"Критическая ошибка логирования: " + ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры


&НаСервере
Функция ПолучитьСледующийПорядокНаСервере(Категория)
    
    Запрос = Новый Запрос;
    Запрос.Текст = 
    "ВЫБРАТЬ
    |   МАКСИМУМ(Характеристики.ПорядокСортировки) КАК МаксПорядок
    |ИЗ
    |   РегистрСведений.AVS_ХарактеристикиКатегорий КАК Характеристики
    |ГДЕ
    |   Характеристики.Категория = &Категория";
    
    Запрос.УстановитьПараметр("Категория", Категория);
    
    Результат = Запрос.Выполнить();
    Выборка = Результат.Выбрать();
    
    Если Выборка.Следующий() Тогда
        МаксПорядок = Выборка.МаксПорядок;
        
        // Проверяем, что значение не NULL и имеет тип Число
        Если МаксПорядок = Неопределено ИЛИ НЕ ТипЗнч(МаксПорядок) = Тип("Число") Тогда
            Возврат 10;
        Иначе
            Возврат МаксПорядок + 10;
        КонецЕсли;
        
    Иначе
        Возврат 10;
    КонецЕсли;
    
КонецФункции

&НаСервере
Функция AVS_ПолучитьСледующийПорядокКатегорииНаСервере(Родитель)
    Запрос = Новый Запрос;
    Запрос.Текст = 
    "ВЫБРАТЬ
    |	МАКСИМУМ(Категории.ПорядокСортировки) КАК МаксПорядок
    |ИЗ
    |	Справочник.AVS_КатегорииНоменклатурыСайт КАК Категории
    |ГДЕ
    |	Категории.Родитель = &Родитель";
    
    Запрос.УстановитьПараметр("Родитель", Родитель);
    
    Попытка
        Результат = Запрос.Выполнить();
        Выборка = Результат.Выбрать();
        
        Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.МаксПорядок) Тогда
            Возврат Выборка.МаксПорядок + 10;
        Иначе
            Возврат 10;
        КонецЕсли;
    Исключение
        Возврат 10;
    КонецПопытки;
КонецФункции

&НаСервере
Процедура AVS_РегистрацияИзмененияКатегории(Категория)
    
    // Проверка типа входящего параметра для предотвращения падения сервера
    Если Не ЗначениеЗаполнено(Категория) Тогда
        Возврат;
    КонецЕсли;
    
    Попытка
        // Проверка наличия перечисления и общего модуля
        ВидСобытия = ПредопределенноеЗначение("Перечисление.AVS_ВидСобытия.UPDATE");
        AVS_ОбщийМодульСайт.AVS_ЗарегистрироватьИзменение(Категория, ВидСобытия);
    Исключение
        ТекстОшибки = "[AVS ERROR]: Ошибка регистрации изменений на сервере: " + ОписаниеОшибки();
        Сообщить(ТекстОшибки);
        ЗаписьЖурналаРегистрации("AVS.Интеграция", УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
    КонецПопытки;
    
КонецПроцедуры


#Область Товары 

// { ПРАВКА: Загрузка товаров из регистра в буфер формы }
&НаСервере
Процедура AVS_ЗагрузитьТоварыНаСервере()
	
	СписокТоваровКатегории.Очистить();
	
	Если Объект.Ссылка.Пустая() Тогда Возврат; КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Состав.Номенклатура КАК Номенклатура,
	|	Состав.СвязкаАктивна КАК СвязкаАктивна
