&Перед("ПередЗаписью")
Процедура AVS_ПередЗаписью(Отказ)
	Если ОбменДанными.Загрузка Тогда Возврат; КонецЕсли;
	
	// 1. Запоминаем состояние "Новый"
	ДополнительныеСвойства.Вставить("AVS_ЭтоНовый", ЭтоНовый());
	
	// 2. Запоминаем старое значение флага выгрузки (ТЗ 1.6)
	Если Не ЭтоНовый() Тогда
		// Получаем значение из базы данных до записи
		СтароеЗначение = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.Ссылка, "AVS_ВыгружатьНаСайт");
		ДополнительныеСвойства.Вставить("AVS_СтароеВыгружатьНаСайт", СтароеЗначение);
	Иначе
		ДополнительныеСвойства.Вставить("AVS_СтароеВыгружатьНаСайт", Ложь);
	КонецЕсли;
КонецПроцедуры

&После("ПриЗаписи")
Процедура AVS_ПриЗаписиПосле()
	
	Если ОбменДанными.Загрузка Тогда Возврат; КонецЕсли;
	
	Попытка
		// Извлекаем сохраненные флаги
		ЭтоНовый = Ложь;
		ДополнительныеСвойства.Свойство("AVS_ЭтоНовый", ЭтоНовый);
		
		СтароеВыгружать = Ложь;
		ДополнительныеСвойства.Свойство("AVS_СтароеВыгружатьНаСайт", СтароеВыгружать);
		
		НовоеВыгружать = ЭтотОбъект.AVS_ВыгружатьНаСайт;

		// Сценарий 1: Характеристика должна быть на сайте (сейчас или была раньше)
		Если НовоеВыгружать Тогда
			// Если только что включили - INSERT, если была и осталась - UPDATE
			ВидСобытия = ?(ЭтоНовый Или Не СтароеВыгружать, "INSERT", "UPDATE");
			AVS_ОбщийМодульСайт.AVS_ЗарегистрироватьИзменение(ЭтотОбъект.Ссылка, ВидСобытия);
			
		// Сценарий 2: Характеристику исключили из выгрузки (была Истина, стала Ложь)
		ИначеЕсли СтароеВыгружать И Не НовоеВыгружать Тогда
			// ТЗ 2.1: При исключении из выгрузки шлем DELETE, чтобы сайт удалил её из метаданных
			AVS_ОбщийМодульСайт.AVS_ЗарегистрироватьИзменение(ЭтотОбъект.Ссылка, "DELETE");
		КонецЕсли;
		
	Исключение
		ЗаписьЖурналаРегистрации("AVS.Интеграция", УровеньЖурналаРегистрации.Ошибка, , , 
			"Ошибка регистрации ПВХ: " + ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

&Перед("ПередУдалением")
Процедура AVS_ПередУдалением(Отказ)
	Если ОбменДанными.Загрузка Тогда Возврат; КонецЕсли;
	
	// Если удаляемая характеристика была на сайте - регистрируем DELETE (ТЗ 1.6)
	Если ЭтотОбъект.AVS_ВыгружатьНаСайт Тогда
		AVS_ОбщийМодульСайт.AVS_ЗарегистрироватьИзменение(ЭтотОбъект.Ссылка, "DELETE");
	КонецЕсли;
КонецПроцедуры