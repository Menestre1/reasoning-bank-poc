&НаСервере
Функция ПроверитьВерсиюИРежимСовместимостиПлатформы()
	
	Информация = Новый СистемнаяИнформация;
	Если Не (Лев(Информация.ВерсияПриложения, 3) = "8.3"
		И (Метаданные.РежимСовместимости = Метаданные.СвойстваОбъектов.РежимСовместимости.НеИспользовать
		Или (Метаданные.РежимСовместимости <> Метаданные.СвойстваОбъектов.РежимСовместимости.Версия8_1
		И Метаданные.РежимСовместимости <> Метаданные.СвойстваОбъектов.РежимСовместимости.Версия8_2_13
		И Метаданные.РежимСовместимости <> Метаданные.СвойстваОбъектов.РежимСовместимости["Версия8_2_16"]
		И Метаданные.РежимСовместимости <> Метаданные.СвойстваОбъектов.РежимСовместимости["Версия8_3_1"]
		И Метаданные.РежимСовместимости <> Метаданные.СвойстваОбъектов.РежимСовместимости["Версия8_3_2"]))) Тогда
		
		ВызватьИсключение Нстр("ru = 'Обработка предназначена для запуска на версии платформы
			|1С:Предприятие 8.3 с отключенным режимом совместимости или выше'");
		
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ДеревоМетаданныхПриАктивизацииСтроки(Элемент)
	
	ТекущаяСтрока = Элементы.ДеревоМетаданных.ТекущиеДанные;
		
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
		
	Элементы.ДеревоМетаданныхОтбор.ТолькоПросмотр         = Не ТекущаяСтрока.ДоступенОтбор;
	Элементы.ДеревоМетаданныхСкопироватьОтбор.Доступность = ТекущаяСтрока.ДоступенОтбор;
	Элементы.ДеревоМетаданныхУдалитьОтбор.Доступность     = ТекущаяСтрока.ДоступенОтбор;
	
	Элементы.ДеревоМетаданныхПоказатьВыгружаемыеДанные.Доступность  = ТекущаяСтрока.ДоступенОтбор;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоМетаданныхОтборНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущаяСтрока = Элементы.ДеревоМетаданных.ТекущиеДанные;
	
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КомпоновщикНастроек = ИнициализироватьКомпоновщикНастроек(Элементы.ДеревоМетаданных.ТекущаяСтрока);
	ТекущаяСтрока.Отбор = КомпоновщикНастроек.Настройки.Отбор;
	
КонецПроцедуры

&НаСервере
Функция ИнициализироватьКомпоновщикНастроек(Знач ИндексСтроки = Неопределено, Знач СтрокаДереваМетаданных = Неопределено)
	
	Если СтрокаДереваМетаданных = Неопределено Тогда
		СтрокаДереваМетаданных = Объект.ДеревоМетаданных.НайтиПоИдентификатору(ИндексСтроки);
	КонецЕсли;
	
	ОбъектОбработка = РеквизитФормыВЗначение("Объект");
	ТекстЗапроса = ПолучитьТекстЗапросаПоСтроке(СтрокаДереваМетаданных);
	СхемаКомпоновкиДанных = ОбъектОбработка.СхемаКомпоновкиДанных(ТекстЗапроса);
	
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	
	АдресВХ = ПоместитьВоВременноеХранилище(СхемаКомпоновкиДанных, УникальныйИдентификатор);
	
	ИсточникНастроек = Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресВХ);
	КомпоновщикНастроек.Инициализировать(ИсточникНастроек);
	КомпоновщикНастроек.ЗагрузитьНастройки(СхемаКомпоновкиДанных.НастройкиПоУмолчанию);
	
	ЕстьДополнительныеОтборы  = СтрокаДереваМетаданных.Отбор.Элементы.Количество() <> 0; 
	
	Если ЕстьДополнительныеОтборы Тогда
		ОбъектОбработка.СкопироватьЭлементы(КомпоновщикНастроек.Настройки.Отбор, СтрокаДереваМетаданных.Отбор);
	КонецЕсли;
	
	Возврат КомпоновщикНастроек;
		
КонецФункции

//+ Muraviev Sergey 2023.12.24
// Для регистров, подчиненных регистратору, можно предоставлять отбор только по регистратору 
&НаСервере
Функция ПолучитьТекстЗапросаПоСтроке(СтрокаДереваМетаданных) 
	
	Если ТипЗнч(СтрокаДереваМетаданных) = Тип("СтрокаДереваЗначений") Тогда
		ОбъектМетаданных  = СтрокаДереваМетаданных.Метаданные;
	Иначе	
		ОбъектМетаданных  = Метаданные[СтрокаДереваМетаданных.ПолучитьРодителя().ПолноеИмяМетаданных][СтрокаДереваМетаданных.ПолноеИмяМетаданных];
	КонецЕсли;
	ИмяМетаданных = ОбъектМетаданных.ПолноеИмя();
	
	Если Метаданные.РегистрыНакопления.Содержит(ОбъектМетаданных)
			ИЛИ Метаданные.РегистрыБухгалтерии.Содержит(ОбъектМетаданных)
			ИЛИ Метаданные.РегистрыРасчета.Содержит(ОбъектМетаданных) 
			ИЛИ (
				Метаданные.РегистрыСведений.Содержит(ОбъектМетаданных) 
				И Метаданные.РегистрыСведений[ОбъектМетаданных.Имя].РежимЗаписи = Метаданные.СвойстваОбъектов.РежимЗаписиРегистра.ПодчинениеРегистратору) Тогда
		
		ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ _.Регистратор ИЗ " + ИмяМетаданных + " КАК _ ";
	Иначе
		ОбъектОбработка = РеквизитФормыВЗначение("Объект");
		ТекстЗапроса = ОбъектОбработка.ПолучитьТекстЗапросаПоСтроке(СтрокаДереваМетаданных, Ложь);
	КонецЕсли;

	Возврат ТекстЗапроса;
	
КонецФункции


&НаСервере
Процедура УдалитьНедоступныеЭлементыОтбора(ДоступныеПоляОтбора, ИсточникЗначения) Экспорт
	
	ИсточникЭлементов = ИсточникЗначения.Элементы;
	
	МассивЭлементовДляУдаления = Новый Массив;
	
	Для каждого ЭлементИсточник Из ИсточникЭлементов Цикл
				
		Если ТипЗнч(ЭлементИсточник) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			УдалитьНедоступныеЭлементыОтбора(ДоступныеПоляОтбора, ЭлементИсточник);
		Иначе
			Если ДоступныеПоляОтбора.НайтиПоле(ЭлементИсточник.ЛевоеЗначение) = Неопределено Тогда
				МассивЭлементовДляУдаления.Добавить(ЭлементИсточник);
			КонецЕсли;	
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого УдаляемоеПоле Из МассивЭлементовДляУдаления Цикл
		 ИсточникЭлементов.Удалить(УдаляемоеПоле);
	КонецЦикла;	
	
КонецПроцедуры

&НаКлиенте
Процедура СкопироватьОтбор(Команда)
	
	ТекущаяСтрока = Элементы.ДеревоМетаданных.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда
		ПоказатьПредупреждение(, Нстр("ru = 'Не выбрана строка отбора данных для копирования'"));
		Возврат;
	КонецЕсли;
	
	Обработчик = Новый ОписаниеОповещения("СкопироватьОтборЗавершение", ЭтотОбъект);
	
	ПоказатьВопрос(Обработчик, Нстр("ru = 'Очистить текущие значения отбора в строках?'"), РежимДиалогаВопрос.ДаНет); 
	
КонецПроцедуры

&НаКлиенте
Процедура СкопироватьОтборЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	ОчищатьПриемник = РезультатВопроса = КодВозвратаДиалога.Да;
	СкопироватьОтборСервер(Элементы.ДеревоМетаданных.ТекущаяСтрока, ОчищатьПриемник);
		
КонецПроцедуры

&НаСервере
Процедура СкопироватьОтборСервер(ИндексСтроки, ОчищатьПриемник)
	
	СтрокаДереваМетаданных = Объект.ДеревоМетаданных.НайтиПоИдентификатору(ИндексСтроки);	
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
		
	СкопироватьОтборДляДерева(Объект.ДеревоМетаданных.ПолучитьЭлементы(), СтрокаДереваМетаданных, ОчищатьПриемник, ОбработкаОбъект);
		
КонецПроцедуры

&НаСервере
Процедура СкопироватьОтборДляДерева(СтрокиДерева, СтрокаДереваМетаданных, ОчищатьПриемник, ОбработкаОбъект)
	
	Для Каждого СтрокаДереваВыгрузки Из СтрокиДерева Цикл
		
		Если СтрокаДереваВыгрузки.ДоступенОтбор 
			И СтрокаДереваВыгрузки.Выгружать = 1 
			И Не СтрокаДереваМетаданных = СтрокаДереваВыгрузки Тогда
			
			СтарыйОтбор = СтрокаДереваВыгрузки.Отбор;
						
			КомпоновщикНастроек = ИнициализироватьКомпоновщикНастроек(,СтрокаДереваВыгрузки);
						
			ОбработкаОбъект.СкопироватьЭлементы(КомпоновщикНастроек.Настройки.Отбор, 
				СтрокаДереваМетаданных.Отбор, 
				ОчищатьПриемник);
				
			УдалитьНедоступныеЭлементыОтбора(
			    КомпоновщикНастроек.Настройки.Отбор.ДоступныеПоляОтбора,
				КомпоновщикНастроек.Настройки.Отбор
				);	
				
			СтрокаДереваВыгрузки.Отбор = КомпоновщикНастроек.Настройки.Отбор;
			
		КонецЕсли;	
		
		Если СтрокаДереваВыгрузки.ПолучитьЭлементы().Количество() > 0 Тогда
			 СкопироватьОтборДляДерева(СтрокаДереваВыгрузки.ПолучитьЭлементы(), СтрокаДереваМетаданных, ОчищатьПриемник, ОбработкаОбъект);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьОтбор(Команда)
	
	УдалитьОтборДляДерева(Объект.ДеревоМетаданных.ПолучитьЭлементы());
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьОтборДляДерева(СтрокиДерева)
	
	Для Каждого СтрокаДереваВыгрузки Из СтрокиДерева Цикл
		
		Если СтрокаДереваВыгрузки.ДоступенОтбор 
			И СтрокаДереваВыгрузки.Выгружать = 1 Тогда
						
			СтрокаДереваВыгрузки.Отбор.Элементы.Очистить();
			
		КонецЕсли;	
		
		Если СтрокаДереваВыгрузки.ПолучитьЭлементы().Количество() > 0 Тогда
			 УдалитьОтборДляДерева(СтрокаДереваВыгрузки.ПолучитьЭлементы());
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьВыгружаемыеДанные(Команда)
	
	ТекущаяСтрока = Элементы.ДеревоМетаданных.ТекущиеДанные;
	
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТабДокумент = ПоказатьВыгружаемыеДанныеСервер(Элементы.ДеревоМетаданных.ТекущаяСтрока);
	ТабДокумент.Показать();
	
КонецПроцедуры

&НаСервере
Функция ПоказатьВыгружаемыеДанныеСервер(ИндексСтроки)
	
	СтрокаДереваМетаданных = Объект.ДеревоМетаданных.НайтиПоИдентификатору(ИндексСтроки);
		
	ОбъектОбработка = РеквизитФормыВЗначение("Объект");
	
	ОбъектОбработка.ДатаНачала = ПериодВыгрузки.ДатаНачала;
	ОбъектОбработка.ДатаОкончания = ПериодВыгрузки.ДатаОкончания;
	
	ТекстЗапроса = ОбъектОбработка.ПолучитьТекстЗапросаПоСтроке(СтрокаДереваМетаданных, Ложь);
	СхемаКомпоновкиДанных = ОбъектОбработка.СхемаКомпоновкиДанных(ТекстЗапроса);
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(ПоместитьВоВременноеХранилище(СхемаКомпоновкиДанных, УникальныйИдентификатор)));
	КомпоновщикНастроек.ЗагрузитьНастройки(СхемаКомпоновкиДанных.НастройкиПоУмолчанию);
	
	ЕстьДополнительныеОтборы  = СтрокаДереваМетаданных.Отбор.Элементы.Количество() <> 0; 
	
	Если ЕстьДополнительныеОтборы Тогда
		ОбъектОбработка.СкопироватьЭлементы(КомпоновщикНастроек.Настройки.Отбор, СтрокаДереваМетаданных.Отбор);
	КонецЕсли;
	
	ОбъектОбработка.УстановитьНастройкуСтруктурыВыводаРезультата(КомпоновщикНастроек.Настройки, Истина);
		
	ОбъектОбработка.УстановитьЗначениеПараметраСКД(КомпоновщикНастроек, "ДатаНачала",        ОбъектОбработка.ДатаНачала);
	ОбъектОбработка.УстановитьЗначениеПараметраСКД(КомпоновщикНастроек, "ДатаОкончания",     ОбъектОбработка.ДатаОкончания);
	
	// Компоновка макета компоновки данных.
	ДанныеРасшифровки = Новый ДанныеРасшифровкиКомпоновкиДанных;
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
		
	МакетКомпоновкиДанных = КомпоновщикМакета.Выполнить(
		СхемаКомпоновкиДанных, 
		КомпоновщикНастроек.Настройки, 
		ДанныеРасшифровки, 
		,
		Тип("ГенераторМакетаКомпоновкиДанных")
		);
		
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновкиДанных, , ДанныеРасшифровки);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	
	ТабДокумент = ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);
	Возврат ТабДокумент;
	
КонецФункции

&НаКлиенте
Асинх Процедура Адапт_ПометитьИзНавигационнойСсылки(Команда)
	
	НавСсылкаСтрока = Адапт_ПрочитатьТекстИзБуфера();
	
	Обещание = ВвестиСтрокуАсинх(НавСсылкаСтрока, "Введите навигационную ссылку",, Ложь);
	
	Результат = Ждать Обещание;
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		Возврат;
	КонецЕсли;
	
    Значение = Адапт_ПолучитьСсылкуИзНавигационной(Результат);
	
	СтрокаИд = Адапт_НайтиСтрокуЗначения(Значение);
	
	Если СтрокаИд = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Строка = Объект.ДеревоМетаданных.НайтиПоИдентификатору(СтрокаИД); 
	
	Адапт_ДобавитьОтборПоСсылке(Строка.Отбор, Значение);
	
	Строка.Выгружать = Истина;
	
	Элементы.ДеревоМетаданных.ТекущаяСтрока = СтрокаИд;
	
КонецПроцедуры

&НаКлиенте
Процедура Адапт_ДобавитьОтборПоСсылке(Отбор, выбСсылка) 
	
	Найдено = Неопределено;
	ЕстьДругиеСсылки = Ложь;
	
	МассивЭлементовОтбораСсылка = Адапт_НайтиЭлементыОтбораСоСсылками(Отбор);
	
	Найдено = Адапт_НайтиЗначениеСвойстваВКоллекции(МассивЭлементовОтбораСсылка, "ПравоеЗначение", выбСсылка);
	ГруппаИли = Адапт_НайтиГруппуИли(Отбор);
	
	Если Найдено = Неопределено Тогда
		ЭлементОтбора = Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Ссылка");
		ЭлементОтбора.ПравоеЗначение = выбСсылка;
		ЭлементОтбора.Использование = Истина;
		МассивЭлементовОтбораСсылка.Добавить(ЭлементОтбора);
	Иначе
		ЭлементОтбора = Найдено;
		ЭлементОтбора.Использование = Истина;
	КонецЕсли;
	
	Если МассивЭлементовОтбораСсылка.Количество() = 1 Тогда
		Возврат;
	КонецЕсли;

	
	
	Если ГруппаИли = Неопределено Тогда
		ГруппаИли = Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
		ГруппаИли.ИдентификаторПользовательскойНастройки = "Или";
		ГруппаИли.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли;
	КонецЕсли;
		
	Для каждого Эл Из МассивЭлементовОтбораСсылка Цикл
		Если Эл.Родитель = Неопределено Тогда
			НовЭлемент = ГруппаИли.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			ЗаполнитьЗначенияСвойств(НовЭлемент, Адапт_СкопироватьЭлементОтбора(Эл));
			//Отбор.Элементы.Удалить(Эл);
		КонецЕсли;
	КонецЦикла;
	
	МассивЭлементовОтбораСсылка = Адапт_НайтиЭлементыОтбораСоСсылками(Отбор);
	Для каждого Эл Из Адапт_НайтиЭлементыОтбораСоСсылками(Отбор) Цикл
		Если Эл.Родитель = Неопределено Тогда
			Отбор.Элементы.Удалить(Эл);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция Адапт_СкопироватьЭлементОтбора(Знач ЭлементОтбора) 
	
	Возврат ЭлементОтбора;
	
КонецФункции

&НаКлиенте
Функция Адапт_НайтиЭлементыОтбораСоСсылками(Отбор, МассивЭлементовОтбораСсылка = Неопределено) 
	
	ЛевоеЗначениеСсылка = Новый ПолеКомпоновкиДанных("Ссылка");
	Если МассивЭлементовОтбораСсылка = Неопределено Тогда
		МассивЭлементовОтбораСсылка = Новый Массив;
	КонецЕсли;
	
	Для каждого Эл Из Отбор.Элементы Цикл
		Если ТипЗнч(Эл) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			Адапт_НайтиЭлементыОтбораСоСсылками(Эл, МассивЭлементовОтбораСсылка);
			Продолжить;
		КонецЕсли;
		Если Эл.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно 
			И Эл.ЛевоеЗначение = ЛевоеЗначениеСсылка Тогда
			
			МассивЭлементовОтбораСсылка.Добавить(Эл);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат МассивЭлементовОтбораСсылка;
	
КонецФункции

&НаКлиенте
Функция Адапт_НайтиГруппуИли(Отбор) 
	
	ГруппаИли = Неопределено;
	Для каждого Эл Из Отбор.Элементы Цикл
		Если ТипЗнч(Эл) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") И Эл.ИдентификаторПользовательскойНастройки = "Или" Тогда
			ГруппаИли = Эл;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ГруппаИли;
	
КонецФункции

&НаКлиенте
Функция Адапт_ПрочитатьТекстИзБуфера() 
	
    WScriptShell = Новый COMОбъект("WScript.Shell");

    ИмяВремФайла = ПолучитьИмяВременногоФайла();
	
    ТекстовыйДокумент = Новый ТекстовыйДокумент;
    ТекстовыйДокумент.Записать(ИмяВремФайла);
	
    СтрокаЗапуска = "powershell -c Get-Clipboard | Out-File """ + ИмяВремФайла + """";
    WScriptShell.Run(СтрокаЗапуска, 0, 1);
	
    ТекстовыйДокумент.Прочитать(ИмяВремФайла);
    Результат = ТекстовыйДокумент.ПолучитьТекст();

    Результат = Сред(Результат, 1, СтрДлина(Результат) - 1);
	
    НачатьУдалениеФайлов(, ИмяВремФайла);
	
    Возврат Результат;
	
КонецФункции

&НаСервере
Функция Адапт_ПолучитьСсылкуИзНавигационной(НС)
    
    ПерваяТочка = Найти(НС, "e1cib/data/");
    ВтораяТочка = Найти(НС, "?ref=");
    
    ПредставлениеТипа   = Сред(НС, ПерваяТочка + 11, ВтораяТочка - ПерваяТочка - 11);
	Попытка
		ШаблонЗначения = ЗначениеВСтрокуВнутр(ПредопределенноеЗначение(ПредставлениеТипа + ".ПустаяСсылка"));
	Исключение
		ОписаниеОшибки = ОписаниеОшибки();
	    ТекстСообщения = "Невозможно обработать навигационную ссылку: " + ПредставлениеТипа + ".ПустаяСсылка";
		ВызватьИсключение(ТекстСообщения);
	КонецПопытки;
    
    ЗначениеСсылки = СтрЗаменить(ШаблонЗначения, "00000000000000000000000000000000", Сред(НС, ВтораяТочка + 5));
    выбСсылка = ЗначениеИзСтрокиВнутр(ЗначениеСсылки);
	
	Возврат выбСсылка;
	
КонецФункции

&НаСервере
Функция Адапт_НайтиСтрокуЗначения(выбЗначение)
	
	Попытка
		ПолноеИмяМетаданных = выбЗначение.Метаданные().ПолноеИмя();
	Исключение
	    ОШ = ОписаниеОшибки();
		Сообщить(ОШ);
		Возврат Неопределено;
		
	КонецПопытки;
	
	ЧастиИмени = СтрРазделить(ПолноеИмяМетаданных, ".", Ложь);
	ВидОбъекта = Адапт_ВидОбъектаВоМножественномЧисле(ЧастиИмени[0]);
	ИмяОбъекта = ЧастиИмени[1];
	
	Строка = Адапт_НайтиЗначениеСвойстваВКоллекции(
		Объект.ДеревоМетаданных.ПолучитьЭлементы(), 
		"ПолноеИмяМетаданных", 
		ВидОбъекта);
		
	Если Строка = Неопределено Тогда
		Сообщить("Не найден вид объекта в дереве: " + ВидОбъекта);
		Возврат Неопределено;
	КонецЕсли;
	
	Строка = Адапт_НайтиЗначениеСвойстваВКоллекции(
		Строка.ПолучитьЭлементы(), 
		"ПолноеИмяМетаданных", 
		ИмяОбъекта);
		
	Если Строка = Неопределено Тогда
		Сообщить("Не найден объект в дереве: " + ПолноеИмяМетаданных);
		Возврат Неопределено;
	КонецЕсли;

	Возврат Строка.ПолучитьИдентификатор();
	
КонецФункции

