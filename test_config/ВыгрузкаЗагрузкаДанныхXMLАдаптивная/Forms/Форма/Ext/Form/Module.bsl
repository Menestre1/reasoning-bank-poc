&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// Исправление ошибки Неизвестный идентификатор формы
	Если КлючУникальности = Неопределено Тогда
		ИмяОбработки = СтрРазделить(ЭтотОбъект.ИмяФормы, ".")[1];
		
		КлючУникальности = ИмяОбработки + XMLСтрока(ТекущаяДата());
		
	КонецЕсли;
	
	Если Адапт_ВозможнаЗагрузкаВыгрузкаВФоновомРежиме() = Ложь Тогда
		ЗагружатьВФоновомРежиме = Ложь;
		Элементы.ЗагружатьВФоновомРежиме.Доступность = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОПрограмме(Команда)
	
	ЧастиИмени = СтрРазделить(ЭтотОбъект.ИмяФормы, ".");
	ИмяОбработки = ЧастиИмени[0] + "." + ЧастиИмени[1];
	ОткрытьФорму(ИмяОбработки + ".Форма.ОПрограмме", , , , , , , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры


