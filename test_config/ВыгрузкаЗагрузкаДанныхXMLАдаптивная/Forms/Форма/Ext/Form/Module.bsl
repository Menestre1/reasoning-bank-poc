&НаСервере
Процедура Адапт_УстановитьПредохранительЗагрузкиНаРабочейБазе() 
	
	ВсеПараметрыСеанса = ПараметрыСеанса;
	Если Адапт_ЕстьСвойство(ВсеПараметрыСеанса, "РаботаСВнешнимиРесурсамиЗаблокирована") 
		И ВсеПараметрыСеанса.РаботаСВнешнимиРесурсамиЗаблокирована = Ложь Тогда //Это рабочая база
		
		ЗагрузкаЗаблокированаВРабочейБазе = Истина;
		Элементы.ГруппаБлокировкаЗагрузки.Видимость = Истина;
		Элементы.ГруппаПредохранитель.Доступность = Ложь;
	Иначе
		ЗагрузкаЗаблокированаВРабочейБазе = Ложь;
		Элементы.ГруппаБлокировкаЗагрузки.Видимость = Ложь;
		Элементы.ГруппаПредохранитель.Доступность = Истина;
	КонецЕсли;
	
КонецПроцедуры

