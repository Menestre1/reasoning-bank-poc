Процедура Адапт_ИнициализироватьСвойстваXDTOЭтойКонфигурации() 
	
	Если мВсеОбъектыКонфигурации <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВсеОбъектыКонфигурации = ФабрикаXDTO.ЭкспортМоделиXDTO("http://v8.1c.ru/8.1/data/enterprise/current-config").package[0].objectType;
	мВсеОбъектыКонфигурации = Новый ТаблицаЗначений;
	мВсеОбъектыКонфигурации.Колонки.Добавить("Наименование");
	мВсеОбъектыКонфигурации.Колонки.Добавить("ОбъектXDTO");
	мВсеОбъектыКонфигурации.Колонки.Добавить("СоответствиеСвойств");
	Для каждого Эл Из ВсеОбъектыКонфигурации Цикл
		НоваяСтрока = мВсеОбъектыКонфигурации.Добавить();
		НоваяСтрока.Наименование = Эл.name;
		НоваяСтрока.ОбъектXDTO = Эл;
		СоответствиеСвойств = Новый Соответствие;
		Для каждого выбСвойство Из Эл.property Цикл
			ИмяСвойства = выбСвойство.name;
			СоответствиеСвойств.Вставить(ИмяСвойства, выбСвойство);
			
			Если ИмяСвойства = "ExtDimensionType" Тогда
				СоответствиеСвойств.Вставить("ExtDimensionTypes", выбСвойство);
			КонецЕсли;
			
		КонецЦикла;
		НоваяСтрока.СоответствиеСвойств = СоответствиеСвойств;
	КонецЦикла;
	мВсеОбъектыКонфигурации.Индексы.Добавить("Наименование");
	
КонецПроцедуры

Процедура Адапт_СообщитьОбОшибкеБезПовторов(ТекстСообщения) 
	
	Если мОшибкиБезПовторов = Неопределено Тогда
		мОшибкиБезПовторов = Новый Соответствие;	
