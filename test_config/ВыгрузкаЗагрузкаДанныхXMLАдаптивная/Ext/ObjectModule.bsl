Функция Адапт_ТекстЗамераВремени(РазницаМиллисекунд) 
	
	СекундВсего = Цел(РазницаМиллисекунд /1000);
	
	Минут = Цел(СекундВсего / 60);
	Если Минут > 0 Тогда
		Склонения = ПолучитьСклоненияСтрокиПоЧислу("минута", Минут); 
		ТекстМинут = Склонения[0];
	Иначе
		ТекстМинут = "";
	КонецЕсли;
	
	Секунд = Цел(СекундВсего % 60);
	Если Секунд = 0 Тогда
		Секунд = 1;
	КонецЕсли;

	Склонения = ПолучитьСклоненияСтрокиПоЧислу("секунда", Секунд);
	ТекстСекунд = Склонения[0];
	
	ТекстСообщения = СтрШаблон("Время выполнения: %1 %2", ТекстМинут, ТекстСекунд);
	
	Возврат ТекстСообщения;
	
КонецФункции

Функция Адапт_СоздатьОбновитьОбъект(ПолноеИмяОбъекта, НовыйОбъектXDTO, ГУИД) 
		
	ОбъектБазыДанных = Адапт_ПолучитьОбъектБД(ПолноеИмяОбъекта, НовыйОбъектXDTO, ГУИД);
	ЭтоНовый = ОбъектБазыДанных.ЭтоНовый();
	
	Для каждого Эл Из НовыйОбъектXDTO.Свойства() Цикл
		РеквизитМодифицирован = Ложь;
		
		ИмяРеквизитаXDTO = Эл.Имя;
		НовоеЗначение = НовыйОбъектXDTO[ИмяРеквизитаXDTO];
		НовТипЗначения = ТипЗнч(НовоеЗначение);
		
		ИмяРеквизита = Адапт_ПолучитьИмяРеквизитаОбъектаБДПоИмениXDTO(ОбъектБазыДанных, ИмяРеквизитаXDTO);
		ПредЗначение = ОбъектБазыДанных[ИмяРеквизита];
		
		ТабЧастьМодифицирована = Ложь;
		Если НовТипЗначения = Тип("СписокXDTO") Тогда
			
			Адапт_ЗаполнитьТабЧасть(ОбъектБазыДанных, НовоеЗначение, ПредЗначение, ТабЧастьМодифицирована);

			Продолжить;
		ИначеЕсли НовТипЗначения = Тип("ОбъектXDTO") Тогда
			
			НовоеЗначение = Сериализатор.ПрочитатьXDTO(НовоеЗначение);
			
		КонецЕсли;
		
		
		Если Не ЗначениеЗаполнено(ПредЗначение) И НовоеЗначение = Неопределено Тогда
			Продолжить;	
		КонецЕсли;
		
		Если ТипЗнч(ПредЗначение) = Тип("ХранилищеЗначения") И НовТипЗначения = Тип("ХранилищеЗначения") Тогда
			Если ЭтоНовый Тогда
				Адапт_УстановитьРеквизитОбъектаБезопасно(ИмяРеквизита, НовоеЗначение, ОбъектБазыДанных);
				РеквизитМодифицирован = Истина;
			ИначеЕсли Адапт_КонтрольнаяСуммаСтрокой(ПредЗначение) <> Адапт_КонтрольнаяСуммаСтрокой(НовоеЗначение) Тогда
				Адапт_УстановитьРеквизитОбъектаБезопасно(ИмяРеквизита, НовоеЗначение, ОбъектБазыДанных);
				РеквизитМодифицирован = Истина;
			КонецЕсли;
			Продолжить;
			
		КонецЕсли;
		
		Если ПредЗначение <> НовоеЗначение Тогда
			Если Не ЭтоНовый И Адапт_НужноЗащититьПредопределенныйЭлемент(ИмяРеквизита) = Истина Тогда
				Продолжить;
			КонецЕсли;
			
			СтрокаБезВозвратовКаретки = СтрЗаменить(НовоеЗначение, Символы.ВК, "");
			Если ПредЗначение = СтрокаБезВозвратовКаретки Тогда
				Продолжить;
			КонецЕсли;
			
			Адапт_УстановитьРеквизитОбъектаБезопасно(ИмяРеквизита, НовоеЗначение, ОбъектБазыДанных);
			РеквизитМодифицирован = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ОбъектБазыДанных;
	
КонецФункции

// Создание объекта БД из ОбъектXDTO глючит для плана видов расчета, поэтому приходится делать это вручную 
Функция Адапт_ПолучитьОбъектБД(ИмяТипа, НовыйОбъектXDTO, ГУИД)
	
	СсылкаНаОбъект = НовыйОбъектXDTO.Ref;
	
	ПредставлениеСсылки = Строка(СсылкаНаОбъект);
	Если Лев(ПредставлениеСсылки, 18) = "<Объект не найден>" Или СсылкаНаОбъект.Пустая() Тогда
		Менеджер = Адапт_ПолучитьМенеджерПоИмени(ИмяТипа);
		Если Адапт_ЭтоДокумент(ИмяТипа) Тогда
			Результат = Менеджер.СоздатьДокумент();
		ИначеЕсли Адапт_ЭтоСправочник(ИмяТипа) Тогда
			Если Адапт_ЕстьСвойство(НовыйОбъектXDTO, "IsFolder") И НовыйОбъектXDTO.IsFolder = Истина Тогда 
				Результат = Менеджер.СоздатьГруппу();
			Иначе
				Результат = Менеджер.СоздатьЭлемент();
			КонецЕсли;
		ИначеЕсли Адапт_ЭтоПланВидовХарактеристик(ИмяТипа) Тогда
			Если Адапт_ЕстьСвойство(НовыйОбъектXDTO, "IsFolder") И НовыйОбъектXDTO.IsFolder = Истина Тогда 
				Результат = Менеджер.СоздатьГруппу();
			Иначе
				Результат = Менеджер.СоздатьЭлемент();
			КонецЕсли;
		ИначеЕсли Адапт_ЭтоПланСчетов(ИмяТипа) Тогда
			Результат = Менеджер.СоздатьСчет();
		ИначеЕсли Адапт_ЭтоПланВидовРасчета(ИмяТипа) Тогда
			Результат = Менеджер.СоздатьВидРасчета();
		ИначеЕсли Адапт_ЭтоБизнесПроцесс(ИмяТипа) Тогда
			Результат = Менеджер.СоздатьБизнесПроцесс();
		ИначеЕсли Адапт_ЭтоЗадача(ИмяТипа) Тогда
			Результат = Менеджер.СоздатьЗадачу();
		ИначеЕсли Адапт_ЭтоПланОбмена(ИмяТипа) Тогда
			Результат = Менеджер.СоздатьУзел();
		Иначе
			ВызватьИсключение("Не определен тип менеджера:" + ИмяТипа);
		КонецЕсли;
		
		Результат.УстановитьСсылкуНового(СсылкаНаОбъект);
		
		Возврат Результат;
	КонецЕсли;
	
	ОбъектБазыДанных = СсылкаНаОбъект.ПолучитьОбъект();
	Возврат ОбъектБазыДанных;

КонецФункции

Функция Адапт_ОбновитьКонстанту(ПолноеИмяОбъекта, НовыйОбъектXDTO, ОбъектМодифицирован) 
	
	ЧастиИмени = СтрРазделить(ПолноеИмяОбъекта, ".", Ложь);
	ИмяКонстанты = ЧастиИмени[1];
	КонстантаМенеджер = Константы[ИмяКонстанты].СоздатьМенеджерЗначения();
	
	КонстантаМенеджер.Прочитать();
	Если КонстантаМенеджер.Значение <> НовыйОбъектXDTO.value Тогда
		КонстантаМенеджер.Значение = НовыйОбъектXDTO.value;
		ОбъектМодифицирован = Истина;
	КонецЕсли;
	
	Возврат КонстантаМенеджер;
	
КонецФункции

Функция Адапт_СоздатьНаборЗаписейРегистра(ПолноеИмяОбъекта, НовыйОбъектXDTO) 
	
	МенеджерРегистра = Адапт_ПолучитьМенеджерПоИмени(ПолноеИмяОбъекта);
	
	НаборЗаписей = МенеджерРегистра.СоздатьНаборЗаписей();
	ПодчиненРегистратору = Адапт_ЕстьСвойство(НаборЗаписей.Отбор, "Регистратор");
	
	
	КоличествоЭлементовОтбора = 0;
	
	СписокЭлементовОтбораXDTO = НовыйОбъектXDTO.Filter.FilterItem;
	Для каждого СтрокаОтбора Из СписокЭлементовОтбораXDTO Цикл
		НаборЭлементОтбора = НаборЗаписей.Отбор[СтрокаОтбора.name];
		Если НаборЭлементОтбора = Неопределено Тогда
			ВызватьИсключение("Ошибка заполнения отбора набора записей:" + ПолноеИмяОбъекта);
		КонецЕсли;	
		НаборЭлементОтбора.Установить(СтрокаОтбора.value);
		КоличествоЭлементовОтбора = КоличествоЭлементовОтбора + 1;
	КонецЦикла;
	
	// В другой конфигурации могли измениться измерения, это может привести к очистке регистра. Сверяем количество.

	
	Если ПодчиненРегистратору = Ложь И СписокЭлементовОтбораXDTO.Количество() <> КоличествоЭлементовОтбора Тогда
		ВызватьИсключение("Ошибка заполнения отбора набора записей:" + ПолноеИмяОбъекта);	
	КонецЕсли;
	
	Для каждого выбЗапись Из НовыйОбъектXDTO.Record Цикл
		НоваяЗапись = НаборЗаписей.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяЗапись, выбЗапись);
		
		Адапт_ЗаполнитьСубконтоЗаписиНабораЗаписей(НоваяЗапись, выбЗапись);
	КонецЦикла;
	
	Возврат НаборЗаписей;
	
КонецФункции

