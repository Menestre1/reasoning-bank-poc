Функция Адапт_КонтрольнаяСуммаСтрокой(Знач Данные, Знач Алгоритм = Неопределено)
	
	Если Алгоритм = Неопределено Тогда
		Алгоритм = ХешФункция.MD5;
	КонецЕсли;
	
	ХешированиеДанных = Новый ХешированиеДанных(Алгоритм);
	Если ТипЗнч(Данные) <> Тип("Строка") И ТипЗнч(Данные) <> Тип("ДвоичныеДанные") Тогда
		Данные = Адапт_ЗначениеВСтрокуXML(Данные);
	КонецЕсли;
	ХешированиеДанных.Добавить(Данные);
	
	Если ТипЗнч(ХешированиеДанных.ХешСумма) = Тип("ДвоичныеДанные") Тогда 
		Результат = СтрЗаменить(ХешированиеДанных.ХешСумма, " ", "");
	ИначеЕсли ТипЗнч(ХешированиеДанных.ХешСумма) = Тип("Число") Тогда
		Результат = Формат(ХешированиеДанных.ХешСумма, "ЧГ=");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Адапт_ЗначениеВСтрокуXML(Значение)
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.УстановитьСтроку();
	СериализаторXDTO.ЗаписатьXML(ЗаписьXML, Значение, НазначениеТипаXML.Явное);
	
	Возврат ЗаписьXML.Закрыть();
	
КонецФункции

Функция Адапт_ПолучитьИмяРеквизитаОбъектаБДПоИмениXDTO(ОбъектБазыДанных, ИмяРеквизитаXDTO) 
	
	Если Адапт_ЕстьСвойство(ОбъектБазыДанных, ИмяРеквизитаXDTO) Тогда
		Возврат ИмяРеквизитаXDTO;
	КонецЕсли;
	
	Если ИмяРеквизитаXDTO = "ExtDimensionType" Тогда
		Возврат "ExtDimensionTypes";
	ИначеЕсли ИмяРеквизитаXDTO = "BaseCalculationType" Тогда
		Возврат "BaseCalculationTypes";
	ИначеЕсли ИмяРеквизитаXDTO = "LeadingCalculationType" Тогда
		Возврат "LeadingCalculationTypes";
	ИначеЕсли ИмяРеквизитаXDTO = "DisplacingCalculationType" Тогда
		Возврат "DisplacingCalculationTypes";
	Иначе
		ВызватьИсключение("Не найден реквизит объекта: " + ИмяРеквизитаXDTO);
	КонецЕсли;
	
КонецФункции

Функция Адапт_ПреобразоватьИмяСтандартнойКоллекции(ОбъектКуда, ИмяКоллекции) 
	
	Если Адапт_ЕстьСвойство(ОбъектКуда, ИмяКоллекции) Тогда
		Возврат ИмяКоллекции;
	КонецЕсли;
	
	Если ИмяКоллекции = "ExtDimensionTypes" Тогда
		Возврат "ExtDimensionType";
	ИначеЕсли ИмяКоллекции = "BaseCalculationTypes" Тогда
		Возврат "BaseCalculationType";
	ИначеЕсли ИмяКоллекции = "LeadingCalculationTypes" Тогда
		Возврат "LeadingCalculationType";
	ИначеЕсли ИмяКоллекции = "DisplacingCalculationTypes" Тогда
		Возврат "DisplacingCalculationType";
	Иначе
		ВызватьИсключение("Не найдено имя стандартной коллекции объекта: " + ИмяКоллекции);
	КонецЕсли;
	
КонецФункции

Процедура Адапт_ЗаполнитьТабЧасть(ОбъектБазыДанных, СписокОткуда, ТабЧастьКуда, ТабЧастьМодифицирована)
	
	ЭтоНовый = ОбъектБазыДанных.ЭтоНовый();
	
	ПредКоличество = ТабЧастьКуда.Количество();
	НовКоличество = СписокОткуда.Количество();
	Если ПредКоличество <> НовКоличество Тогда
		ТабЧастьКуда.Очистить();	
		
		Для Сч = 0 По НовКоличество - 1 Цикл
			ТабЧастьКуда.Добавить();
		КонецЦикла;
		ТабЧастьМодифицирована = Истина;
	КонецЕсли;
	
	Для Сч = 0 По НовКоличество - 1 Цикл
		НовСтрокаТЧ = СписокОткуда[Сч];
		ПредСтрокаТЧ = ТабЧастьКуда[Сч];
		Для каждого выбКолонка Из НовСтрокаТЧ.Свойства() Цикл
			ИмяКолонки = выбКолонка.Имя;
			НовоеЗначение = НовСтрокаТЧ[ИмяКолонки];
			ПредЗначение = ПредСтрокаТЧ[ИмяКолонки];
			НовТипЗначения = ТипЗнч(НовоеЗначение);
			
			Если НовТипЗначения = Тип("ХранилищеЗначения") Тогда
				Если ЭтоНовый 
					Или Адапт_КонтрольнаяСуммаСтрокой(ПредСтрокаТЧ[ИмяКолонки]) <> Адапт_КонтрольнаяСуммаСтрокой(НовоеЗначение) Тогда
					
					Адапт_УстановитьРеквизитОбъектаБезопасно(ИмяКолонки, НовоеЗначение, ПредСтрокаТЧ);
					ТабЧастьМодифицирована = Истина;
				КонецЕсли;
				Продолжить;
				
			ИначеЕсли НовТипЗначения = Тип("ОбъектXDTO") Тогда // ОписаниеТипов

				НовоеЗначение = Сериализатор.ПрочитатьXDTO(НовоеЗначение);
				Адапт_УстановитьРеквизитОбъектаБезопасно(ИмяКолонки, НовоеЗначение, ПредСтрокаТЧ);
				ТабЧастьМодифицирована = Истина;
				Продолжить;
			КонецЕсли;
			
			Если ЭтоНовый 
				Или ПредЗначение <> НовоеЗначение Тогда
				
				СтрокаБезВозвратовКаретки = СтрЗаменить(НовоеЗначение, Символы.ВК, "");
				Если ПредЗначение = СтрокаБезВозвратовКаретки Тогда
					Продолжить;
				КонецЕсли;
				ПредСтрокаТЧ[ИмяКолонки] = НовоеЗначение;
				ТабЧастьМодифицирована = Истина;
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;

КонецПроцедуры

Функция Адапт_ПолучитьИмяОбъекта(Знач выбОбъект)
	
	Если ЗначениеЗаполнено(выбОбъект.ЛокальноеИмя) Тогда
		ИмяОбъекта = выбОбъект.ЛокальноеИмя;
	Иначе
		ИмяОбъекта = выбОбъект.ИмяУзла;
		ЧастиИмени = СтрРазделить(ИмяОбъекта, ":", Ложь);
		ИмяОбъекта = ЧастиИмени[ЧастиИмени.ВГраница()];
	КонецЕсли;
	
	Возврат ИмяОбъекта;

