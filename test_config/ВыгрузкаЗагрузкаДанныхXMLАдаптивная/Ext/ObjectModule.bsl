Функция Адапт_ПолучитьСвойствоXDTO(КоллекцияСвойствОбъекта, ИмяСвойства, ПолноеИмяРодОбъекта) 
	
	СвойстваОбъектаИзКэша = мКэшСвойствXDTO[ПолноеИмяРодОбъекта];
	
	Если СвойстваОбъектаИзКэша = Неопределено Тогда
		Соотв = Новый Соответствие;
		Для каждого Эл Из КоллекцияСвойствОбъекта Цикл
			Соотв.Вставить(Эл.Имя, Эл);
		КонецЦикла;
		мКэшСвойствXDTO.Вставить(ПолноеИмяРодОбъекта, Соотв);
		
		СвойстваОбъектаИзКэша = Соотв;
	КонецЕсли;
	
	Результат = СвойстваОбъектаИзКэша[ИмяСвойства];
	
