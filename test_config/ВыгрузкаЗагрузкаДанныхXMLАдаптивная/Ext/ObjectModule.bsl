Функция Адапт_ПолучитьЗначениеПеречисления(ПолноеИмяПеречисления, ТекстовоеСодержимоеУзла) 
	
	ЧастиИмени = СтрРазделить(ПолноеИмяПеречисления, ".", Ложь);
	ИмяПеречисления = ЧастиИмени[1];
	ПеречислениеМенеджер = Перечисления[ИмяПеречисления];
	
	Результат = Неопределено;
	Если Адапт_ЭтоГУИД(ТекстовоеСодержимоеУзла) Тогда
		Для каждого выбЗначение Из ПеречислениеМенеджер Цикл
			ГУИДЗначения = Адапт_ПолучитьГУИД(выбЗначение);
			Если ГУИДЗначения = ТекстовоеСодержимоеУзла Тогда
				Результат = выбЗначение;
			КонецЕсли;
		КонецЦикла;
	Иначе
		Если Адапт_ЕстьСвойство(ПеречислениеМенеджер, ТекстовоеСодержимоеУзла) Тогда
			Результат = ПеречислениеМенеджер[ТекстовоеСодержимоеУзла];
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Адапт_ПолучитьГУИД(Ссылка)
	
    СтрокаВнутр = ЗначениеВСтрокуВнутр(Ссылка);    
    СтрокаБуфер = СтрЗаменить(СтрЗаменить(СтрокаВнутр, "}", ""), "{", "");
    СтрокаБуфер = СтрРазделить(СтрокаБуфер, ",")[2];
    СтрокаБуфер = СтрРазделить(СтрокаБуфер, ":")[1];
    Результат = 
        Прав(СтрокаБуфер, 8) + "-" + 
        Сред(СтрокаБуфер, 21, 4) + "-" + 
        Сред(СтрокаБуфер, 17, 4) + "-" + 
        Лев(СтрокаБуфер, 4) + "-" + 
        Сред(СтрокаБуфер, 5, 12);
    
    Возврат Результат;
	
КонецФункции

Функция Адапт_ЭтоГУИД(Значение) 
	
	Шаблон = "XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX";
	
	Если СтрДлина(Шаблон) <> СтрДлина(Значение) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для Позиция = 1 По СтрДлина(Значение) Цикл
		Если КодСимвола(Шаблон, Позиция) = 88 // X
			И ((КодСимвола(Значение, Позиция) < 48 Или КодСимвола(Значение, Позиция) > 57) // 0..9
			И (КодСимвола(Значение, Позиция) < 97 Или КодСимвола(Значение, Позиция) > 102) // a..f
			И (КодСимвола(Значение, Позиция) < 65 Или КодСимвола(Значение, Позиция) > 70)) // A..F
			Или КодСимвола(Шаблон, Позиция) = 45 И КодСимвола(Значение, Позиция) <> 45 Тогда // -
				Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;

	
КонецФункции

Процедура Адапт_ЗаполнитьОписаниеТиповXDTO(Значение, СвойствоОбъекта) 
	
	Перем КвалификаторыСтроки, КвалификаторыЧисла, КвалификаторыДаты, КвалификаторыДвоичныхДанных;
	
	МассивТипов = Новый Массив;
	
	Для каждого выбУзел Из СвойствоОбъекта.ДочерниеУзлы Цикл
		СтруктураИмени = Адапт_ВыделитьПрефикс(выбУзел.ИмяЭлемента);
		ИмяЭлемента = СтруктураИмени.Имя;
		Префикс = СтруктураИмени.Префикс;
		
		Если ИмяЭлемента = "StringQualifiers" Тогда
			КвалификаторыСтроки = Адапт_ПолучитьКвалификаторыСтроки(выбУзел.ДочерниеУзлы);
		ИначеЕсли ИмяЭлемента = "NumberQualifiers" Тогда
			КвалификаторыЧисла = Адапт_ПолучитьКвалификаторыЧисла(выбУзел.ДочерниеУзлы);
		ИначеЕсли ИмяЭлемента = "DateQualifiers" Тогда
			КвалификаторыДаты = Адапт_ПолучитьКвалификаторыДаты(выбУзел.ДочерниеУзлы);
		ИначеЕсли ИмяЭлемента = "BinaryDataQualifiers" Тогда
			КвалификаторыДвоичныхДанных = Адапт_ПолучитьКвалификаторыДвоичныхДанных(выбУзел.ДочерниеУзлы);
		ИначеЕсли ИмяЭлемента = "Type" Тогда
						
			РасширенноеИмяXML = Адапт_ПолучитьРасширенноеИмяXMLТипа(выбУзел, Префикс);
			Если РасширенноеИмяXML <> Неопределено Тогда
				Значение.Type.Добавить(РасширенноеИмяXML);	
			КонецЕсли;
			
		ИначеЕсли ИмяЭлемента = "Types" Тогда
			Для каждого выбТип Из выбУзел.ДочерниеУзлы Цикл
				РасширенноеИмяXML = Адапт_ПолучитьРасширенноеИмяXMLТипа(выбТип, Префикс);
				Если РасширенноеИмяXML <> Неопределено Тогда
					Значение.Type.Добавить(РасширенноеИмяXML);
				КонецЕсли;
				
			КонецЦикла;
			
		Иначе
			ВызватьИсключение "Неизвестное имя элемента: " + выбУзел.ИмяЭлемента;	
		КонецЕсли;
	КонецЦикла;
	
	Если КвалификаторыСтроки <> Неопределено Тогда
		Значение.StringQualifiers = КвалификаторыСтроки;
	КонецЕсли;
	
	Если КвалификаторыЧисла <> Неопределено Тогда
		Значение.NumberQualifiers = КвалификаторыЧисла;
	КонецЕсли;
	
	Если КвалификаторыДаты <> Неопределено Тогда
		Значение.DateQualifiers = КвалификаторыДаты;
	КонецЕсли;
	
	Если КвалификаторыДвоичныхДанных <> Неопределено Тогда
		Значение.BinaryDataQualifiers = КвалификаторыДвоичныхДанных;
	КонецЕсли;
	
	
КонецПроцедуры

Функция Адапт_ВыделитьПрефикс(ИмяУзла, ПрефиксРодителя = "") 
	
	Перем Имя, Префикс;
	
	ЧастиИмени = СтрРазделить(ИмяУзла, ":", Ложь);
	Если ЧастиИмени.Количество() = 2 Тогда
		Префикс = ЧастиИмени[0];
		Имя = ЧастиИмени[1];
	Иначе
		Если ЗначениеЗаполнено(ПрефиксРодителя) Тогда
			Префикс = ПрефиксРодителя;
		Иначе
			Префикс = "xmlns";
		КонецЕсли;
		
		Имя = ЧастиИмени[0];
	КонецЕсли;
	
	Возврат Новый Структура("Имя, Префикс", Имя, Префикс);;
	
КонецФункции

Функция Адапт_ПолучитьРасширенноеИмяXMLТипа(выбУзел, ПрефиксРодителя) 
	
	СтруктураИмени = Адапт_ВыделитьПрефикс(выбУзел.ТекстовоеСодержимое, ПрефиксРодителя);
	ИмяТипа = СтруктураИмени.Имя;
	Префикс = СтруктураИмени.Префикс;
	
	Если ВРег(ИмяТипа) = "DATETIME" Тогда
		ТипЗначения = Тип("Дата");
	ИначеЕсли ВРег(ИмяТипа) = "DECIMAL" Тогда
		ТипЗначения = Тип("Число");
	Иначе
		
		Попытка
			ТипЗначения = Тип(ИмяТипа);
		Исключение
			ОписаниеОшибки = ОписаниеОшибки();
			ТекстСообщения = "В данной конфигурации нет типа: " + ИмяТипа;
			Адапт_СообщитьОбОшибкеБезПовторов(ТекстСообщения);
			Возврат Неопределено;
		КонецПопытки;
		
	КонецЕсли;
	
	URIПространстваИмен = выбУзел.НайтиURIПространстваИмен(Префикс);
	Если URIПространстваИмен = "http://v8.1c.ru/data" Тогда
		URIПространстваИмен = "http://v8.1c.ru/8.1/data/enterprise/current-config";
	КонецЕсли;
	
	РасширенноеИмяXML = Новый РасширенноеИмяXML(URIПространстваИмен, ИмяТипа);
	
	Возврат РасширенноеИмяXML;
	
КонецФункции

Функция Адапт_ЗаполнитьОтборXDTO(ЗначениеXDTO, СвойствоОбъекта) 
	
	ЭлементыОтбора = ЗначениеXDTO.FilterItem;
	ТипXDTO_FilterItem = ФабрикаXDTO.Тип("http://v8.1c.ru/8.1/data/enterprise", "FilterItem");
	
	
	Для каждого Эл Из СвойствоОбъекта.ДочерниеУзлы Цикл
		ЗначениеXDTO_FilterItem = ФабрикаXDTO.Создать(ТипXDTO_FilterItem);
		
		ЛевоеЗначение = Адапт_НайтиЗначениеСвойстваВКоллекции(Эл.ДочерниеУзлы, "ИмяУзла", "Name").ТекстовоеСодержимое;
		ПравоеЗначение = Адапт_НайтиЗначениеСвойстваВКоллекции(Эл.ДочерниеУзлы, "ИмяУзла", "Value");
		
		Тип = Адапт_ОпределитьТипПоАтрибуту(ПравоеЗначение);
		Если Тип = Неопределено Тогда
			ЧастиИмениОбъектаРус = Адапт_ПолучитьЧастиИмениОбъекта(СвойствоОбъекта.РодительскийУзел.ЛокальноеИмя, Истина);
			ТекстСообщения = "Ошибка заполнения отбора набора записей: ";
			ТекстСообщения = ТекстСообщения + ЧастиИмениОбъектаРус.ВидОбъекта + "." + ЧастиИмениОбъектаРус.ИмяОбъекта;
			Адапт_СообщитьОбОшибкеБезПовторов(ТекстСообщения);
			Возврат Ложь;
		КонецЕсли;
		ПравоеЗначение = ФабрикаXDTO.Создать(Тип, ПравоеЗначение.ТекстовоеСодержимое); 
		
		ЗначениеXDTO_FilterItem.Name = ЛевоеЗначение;
		ЗначениеXDTO_FilterItem.Value = ПравоеЗначение;
		
		ЭлементыОтбора.Добавить(ЗначениеXDTO_FilterItem);
	
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция Адапт_ПолучитьКвалификаторыСтроки(СписокЭлементов) 
	
	лДлинаСтроки = 0;
	лДопустимаяДлина = ДопустимаяДлина.Переменная;
	
	Для каждого выбКвал Из СписокЭлементов Цикл
		Если выбКвал.ИмяЭлемента = "Length" Тогда
			лДлинаСтроки = Число(выбКвал.ТекстовоеСодержимое);
		ИначеЕсли выбКвал.ИмяЭлемента = "AllowedLength" Тогда
			Если выбКвал.ТекстовоеСодержимое = "Variable" Тогда
				лДопустимаяДлина = ДопустимаяДлина.Переменная;
			ИначеЕсли выбКвал.ТекстовоеСодержимое = "Fixed" Тогда
				лДопустимаяДлина = ДопустимаяДлина.Фиксированная;
			КонецЕсли;					
		КонецЕсли;
	КонецЦикла;
	
	КвалификаторыСтроки = Новый КвалификаторыСтроки(лДлинаСтроки, лДопустимаяДлина);
	ОбъектXDTO = СериализаторXDTO.ЗаписатьXDTO(КвалификаторыСтроки);
	
	Возврат ОбъектXDTO;
	
КонецФункции

Функция Адапт_ПолучитьКвалификаторыЧисла(СписокЭлементов) 
	
	лДопустимыйЗнак = ДопустимыйЗнак.Любой;
	лРазрядность = 0;
	лРазрядностьДробнойЧасти = 0;
	
	Для каждого выбКвал Из СписокЭлементов Цикл
		Если выбКвал.ИмяЭлемента = "AllowedSign" Тогда
			Если выбКвал.ТекстовоеСодержимое = "Any" Тогда
				лДопустимыйЗнак = ДопустимыйЗнак.Любой;
			ИначеЕсли выбКвал.ТекстовоеСодержимое = "Nonnegative" Тогда
				лДопустимыйЗнак = ДопустимыйЗнак.Неотрицательный;
			КонецЕсли;
		ИначеЕсли выбКвал.ИмяЭлемента = "Digits" Тогда
			лРазрядность = Число(выбКвал.ТекстовоеСодержимое);	
		ИначеЕсли выбКвал.ИмяЭлемента = "FractionDigits" Тогда
			лРазрядностьДробнойЧасти = Число(выбКвал.ТекстовоеСодержимое);	
		КонецЕсли;
	КонецЦикла;
	
	КвалификаторыЧисла = Новый КвалификаторыЧисла(лРазрядность, лРазрядностьДробнойЧасти, лДопустимыйЗнак);
	ОбъектXDTO = СериализаторXDTO.ЗаписатьXDTO(КвалификаторыЧисла);
	
	Возврат ОбъектXDTO;
	
КонецФункции

Функция Адапт_ПолучитьКвалификаторыДаты(СписокЭлементов) 
	
	лЧастиДаты = ЧастиДаты.ДатаВремя;
	
	Для каждого выбКвал Из СписокЭлементов Цикл
		Если выбКвал.ТекстовоеСодержимое = "Time" Тогда
			лЧастиДаты = ЧастиДаты.Время;
		ИначеЕсли выбКвал.ТекстовоеСодержимое = "Date" Тогда
			лЧастиДаты = ЧастиДаты.Дата;;	
		ИначеЕсли выбКвал.ТекстовоеСодержимое = "DateTime" Тогда
			лЧастиДаты = ЧастиДаты.ДатаВремя;	
		КонецЕсли;
	КонецЦикла;
	
	КвалификаторыДаты = Новый КвалификаторыДаты(лЧастиДаты);
	ОбъектXDTO = СериализаторXDTO.ЗаписатьXDTO(КвалификаторыДаты);
	
	Возврат ОбъектXDTO;
	
КонецФункции

Функция Адапт_ПолучитьКвалификаторыДвоичныхДанных(СписокЭлементов) 
	
	лДлина = 0;
	лДопустимаяДлина = 0;
	
	Для каждого выбКвал Из СписокЭлементов Цикл
		Если выбКвал.ИмяЭлемента = "Length" Тогда
			лДлина = Число(выбКвал.ТекстовоеСодержимое);
		ИначеЕсли выбКвал.ИмяЭлемента = "AllowedLength" Тогда
			лДопустимаяДлина = Число(выбКвал.ТекстовоеСодержимое);;	
		КонецЕсли;
	КонецЦикла;
	
	КвалификаторыДвоичныхДанных = Новый КвалификаторыДвоичныхДанных(лДлина, лДопустимаяДлина);
	ОбъектXDTO = СериализаторXDTO.ЗаписатьXDTO(КвалификаторыДвоичныхДанных);
	
	Возврат ОбъектXDTO;
	
КонецФункции

Функция Адапт_ОпределитьТипПоАтрибуту(СвойствоОбъекта) 
	
	Атрибуты = СвойствоОбъекта.Атрибуты;
	ТипСсылки = Адапт_НайтиЗначениеСвойстваВКоллекции(Атрибуты, "ЛокальноеИмя", "type");
	Если ТипСсылки <> Неопределено Тогда
		Атрибут = ТипСсылки.Значение; 
		ЧастиИмени = СтрРазделить(Атрибут, ":", Ложь);
		Если ЧастиИмени.Количество() > 1 Тогда
			ПрефиксПространстваИмен = ЧастиИмени[0];
			URIПространстваИмен = Адапт_НайтиПространствоИменВАтрибутах(ПрефиксПространстваИмен, Атрибуты);
			ИмяТипа = ЧастиИмени[1];
		Иначе
			URIПространстваИмен = "http://v8.1c.ru/8.1/data/enterprise/current-config";
			ИмяТипа = ЧастиИмени[0];
		КонецЕсли;

		Попытка
			ТипСвойства = ФабрикаXDTO.Тип(URIПространстваИмен, ИмяТипа);
			
			Возврат ТипСвойства;
		Исключение
		КонецПопытки;
		
	КонецЕсли;
		
	Возврат Неопределено;
	
КонецФункции

Функция Адапт_НайтиПространствоИменВАтрибутах(ПрефиксПространстваИмен, Атрибуты = Неопределено) 
	
	Если Не ЗначениеЗаполнено(ПрефиксПространстваИмен) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	URIПространстваИмен = мДокументDOM.НайтиURIПространстваИмен(ПрефиксПространстваИмен);
	
	Если URIПространстваИмен <> Неопределено Тогда
		Возврат URIПространстваИмен;
	КонецЕсли;
	
	Если Атрибуты = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Для каждого выбАтрибут Из Атрибуты Цикл
		Если выбАтрибут.ЛокальноеИмя = ПрефиксПространстваИмен Тогда
			URIПространстваИмен = выбАтрибут.Значение;
			Возврат URIПространстваИмен;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

Процедура Адапт_ДозаполнитьПустымиЗначениямиТипов(Куда, ПолноеИмяРодОбъекта, ОписанияТиповЭтойКонфигурации) 
	
	Если Адапт_ЭтоСправочник(ПолноеИмяРодОбъекта) Или Адапт_ЭтоПланВидовХарактеристик(ПолноеИмяРодОбъекта) Тогда
		ПроверятьПринадлежностьСвойств = Истина;
	Иначе
		ПроверятьПринадлежностьСвойств = Ложь;	
	КонецЕсли;

	ЭтоГруппа = Ложь;	
		
	Для каждого СвойствоОбъекта Из Куда.Свойства() Цикл
		ИмяСвойства = СвойствоОбъекта.Имя;
		ЗначениеСвойства = Куда[ИмяСвойства];
		Если ЗначениеСвойства <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если ИмяСвойства = "IsFolder" Тогда
			ЭтоГруппа = ЗначениеСвойства;
		КонецЕсли;
		
		Если ПроверятьПринадлежностьСвойств Тогда
			Принадлежность = Адапт_ПолучитьПринадлежностьСвойстваДляГруппыИлиЭлемента(ПолноеИмяРодОбъекта, ИмяСвойства);
			Если ЭтоГруппа = Истина И Принадлежность = "ДляЭлемента" Тогда
				Продолжить;
			ИначеЕсли ЭтоГруппа = Ложь И Принадлежность = "ДляГруппы" Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		Если ИмяСвойства = "ValueType" Тогда
			
			ТипОбъектаXDTO_ОписаниеТипов = ФабрикаXDTO.Тип("http://v8.1c.ru/8.1/data/core", "TypeDescription");
			ЗначениеXDTO = ФабрикаXDTO.Создать(ТипОбъектаXDTO_ОписаниеТипов);
			Куда.Установить(СвойствоОбъекта, ЗначениеXDTO);
		ИначеЕсли ИмяСвойства = "Filter" Тогда
			
			ТипОбъектаXDTO_Фильтр = ФабрикаXDTO.Тип("http://v8.1c.ru/8.1/data/enterprise", "Filter");
			ЗначениеXDTO = ФабрикаXDTO.Создать(ТипОбъектаXDTO_Фильтр);
			Куда.Установить(СвойствоОбъекта, ЗначениеXDTO);
		ИначеЕсли СвойствоОбъекта.Тип = Неопределено Тогда
			
			Куда[ИмяСвойства] = "";
		ИначеЕсли ИмяСвойства = "PredefinedDataName" Тогда
			Продолжить;
		Иначе
			
			ЗначениеXDTO = Адапт_ПустоеЗначениеТипаXDTO(СвойствоОбъекта.Тип);

			Куда[ИмяСвойства] = ЗначениеXDTO;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция Адапт_ПолучитьПринадлежностьСвойстваДляГруппыИлиЭлемента(ПолноеИмяОбъекта, ИмяСвойства) 
	
	Структура = Адапт_ПолучитьЧастиИмениОбъекта(ПолноеИмяОбъекта, Истина);
	ВидОбъекта = Структура.ВидОбъекта;
	ИмяОбъекта = Структура.ИмяОбъекта;
	
	Список = мОписанияТиповКонфигурации[ВидОбъекта];
	
	Принадлежность = Список[ИмяОбъекта].Реквизиты[ИмяСвойства].Использование;
	
	Возврат Принадлежность;
	
КонецФункции

