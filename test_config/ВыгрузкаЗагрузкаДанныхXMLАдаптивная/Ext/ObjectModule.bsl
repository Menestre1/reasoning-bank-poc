КонецФункции

Функция Адапт_ВсеСсылочныеТипыКонфигурации()
	
	Результат = Новый Массив;
	
	Адапт_ДополнитьМассив(Результат, Справочники.ТипВсеСсылки().Типы());
	Адапт_ДополнитьМассив(Результат, Документы.ТипВсеСсылки().Типы());
	Адапт_ДополнитьМассив(Результат, БизнесПроцессы.ТипВсеСсылки().Типы());
	Адапт_ДополнитьМассив(Результат, ПланыВидовХарактеристик.ТипВсеСсылки().Типы());
	Адапт_ДополнитьМассив(Результат, ПланыСчетов.ТипВсеСсылки().Типы());
	Адапт_ДополнитьМассив(Результат, ПланыВидовРасчета.ТипВсеСсылки().Типы());
	Адапт_ДополнитьМассив(Результат, Задачи.ТипВсеСсылки().Типы());
	Адапт_ДополнитьМассив(Результат, ПланыОбмена.ТипВсеСсылки().Типы());
	Адапт_ДополнитьМассив(Результат, Перечисления.ТипВсеСсылки().Типы());
	
	Возврат Результат;
	
КонецФункции

Процедура Адапт_ДополнитьМассив(МассивПриемник, МассивИсточник, ТолькоУникальныеЗначения = Ложь)
	
	Если ТолькоУникальныеЗначения Тогда
		
		УникальныеЗначения = Новый Соответствие;
		
		Для Каждого Значение Из МассивПриемник Цикл
			УникальныеЗначения.Вставить(Значение, Истина);
		КонецЦикла;
		
		Для Каждого Значение Из МассивИсточник Цикл
			Если УникальныеЗначения[Значение] = Неопределено Тогда
				МассивПриемник.Добавить(Значение);
				УникальныеЗначения.Вставить(Значение, Истина);
			КонецЕсли;
		КонецЦикла;
		
	Иначе
		
		Для Каждого Значение Из МассивИсточник Цикл
			МассивПриемник.Добавить(Значение);
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Функция Адапт_ПустоеЗначениеТипаXDTO(ТипXDTO) 
	
	ИмяТипа = ВРЕГ(ТипXDTO.Имя); 
	Если ИмяТипа = "DATETIME" Тогда
		ИмяТипа = "DATE";
	ИначеЕсли ИмяТипа = "DECIMAL" Тогда
		ИмяТипа = "NUMBER";
	КонецЕсли;
	
	Если ИмяТипа = "ANYREF" Тогда
		МассивТипов = Адапт_ВсеСсылочныеТипыКонфигурации();
		ОписаниеТипов = Новый ОписаниеТипов(МассивТипов);
	ИначеЕсли ИмяТипа = "ANYTYPE" Тогда
		ОписаниеТипов = Новый ОписаниеТипов;
		Возврат Неопределено;
	ИначеЕсли ИмяТипа = "CATALOGREF" Тогда
		МассивТипов = Справочники.ТипВсеСсылки().Типы();
		ОписаниеТипов = Новый ОписаниеТипов(МассивТипов);
	ИначеЕсли ИмяТипа = "DOCUMENTREF" Тогда
		МассивТипов = Документы.ТипВсеСсылки().Типы();
		ОписаниеТипов = Новый ОписаниеТипов(МассивТипов);
	ИначеЕсли ИмяТипа = "BISUNESSPROCESSREF" Тогда
		МассивТипов = БизнесПроцессы.ТипВсеСсылки().Типы();
		ОписаниеТипов = Новый ОписаниеТипов(МассивТипов);
	ИначеЕсли ИмяТипа = "CHARTOFCHARACTERISTICTYPESREF" Тогда
		МассивТипов = ПланыВидовХарактеристик.ТипВсеСсылки().Типы();
		ОписаниеТипов = Новый ОписаниеТипов(МассивТипов);
	ИначеЕсли ИмяТипа = "CHARTOFACCOUNTREF" Тогда
		МассивТипов = ПланыСчетов.ТипВсеСсылки().Типы();
		ОписаниеТипов = Новый ОписаниеТипов(МассивТипов);
	ИначеЕсли ИмяТипа = "CHARTOFCALCULATIONTYPESREF" Тогда
		МассивТипов = ПланыВидовРасчета.ТипВсеСсылки().Типы();
		ОписаниеТипов = Новый ОписаниеТипов(МассивТипов);
	ИначеЕсли ИмяТипа = "TAKSREF" Тогда
		МассивТипов = Задачи.ТипВсеСсылки().Типы();
		ОписаниеТипов = Новый ОписаниеТипов(МассивТипов);
	ИначеЕсли ИмяТипа = "EXCHANGEPLANREF" Тогда
		МассивТипов = ПланыОбмена.ТипВсеСсылки().Типы();
		ОписаниеТипов = Новый ОписаниеТипов(МассивТипов);
	ИначеЕсли ИмяТипа = "ENUMREF" Тогда
		МассивТипов = Перечисления.ТипВсеСсылки().Типы();
		ОписаниеТипов = Новый ОписаниеТипов(МассивТипов);
	ИначеЕсли СтрНайти(ИмяТипа, "EXTDIMENSIONS.") > 0 Тогда
		Возврат ФабрикаXDTO.Создать(ТипXDTO);	
	Иначе
		ОписаниеТипов = Новый ОписаниеТипов(ИмяТипа);
	КонецЕсли;
	
	ПустоеЗначение = ОписаниеТипов.ПривестиЗначение("");
	
	Возврат ПустоеЗначение;
	
КонецФункции

// Откуда - структура со свойствами:
//		  *Коллекция - 
//		  *Имя -
//		  *ТипXDTO -
Процедура Адапт_ЗаполнитьТабЧастьОбъектаXDTO(Куда, Откуда, СоответствиеСвойствОбъектаЭтойКонфигурации) 
	
	Если Откуда.Коллекция.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	МассивЗначений = Новый Массив;
	Для каждого КолонкаСтрокиТЧ Из Откуда.Коллекция Цикл
		МассивЗначений.Добавить(КолонкаСтрокиТЧ);
	КонецЦикла;
	
	ТипXDTO = Откуда.ТипXDTO;
	ОбъектXDTO = ФабрикаXDTO.Создать(ТипXDTO);
		
	Адапт_ЗаполнитьСвойстваОбъектаXDTO(ОбъектXDTO, МассивЗначений, ТипXDTO.Имя, СоответствиеСвойствОбъектаЭтойКонфигурации);
	
	Если Куда = Неопределено Тогда
		Куда = ОбъектXDTO;
	Иначе
		Куда.Добавить(ОбъектXDTO);
	КонецЕсли;
	
КонецПроцедуры

// Откуда - структура со свойствами:
//		  *Коллекция - СписокУзловDOM 
//		  *Имя - Строка
//		  *ТипXDTO - ТипОбъектаXDTO
Процедура Адапт_ЗаполнитьСубконтоОбъектаXDTO(Куда, Откуда, СоответствиеСвойствОбъектаЭтойКонфигурации) 
	
	//Откуда.Коллекция - СписокУзловDOM
	
	Коллекция = Откуда.Коллекция;
	Количество = Коллекция.Количество();
	Если Количество = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СписокСубконто = Новый Массив;
	Сч = 0;
	Пока Сч < Количество - 1 Цикл
		Тип = Коллекция[Сч];
		Значение = Коллекция[Сч + 1];
		
		Массив = Новый Массив;
		Массив.Добавить(Тип);
		Массив.Добавить(Значение);
		СписокСубконто.Добавить(Массив);
		
		Сч = Сч + 2;
	КонецЦикла;
	
	
	ТипXDTO = Откуда.ТипXDTO;
	
	ОбъектXDTO = ФабрикаXDTO.Создать(ТипXDTO);
	Для каждого выбСубконто Из СписокСубконто Цикл
		
		Адапт_ЗаполнитьСвойстваОбъектаXDTO(ОбъектXDTO, выбСубконто, ТипXDTO.Имя, СоответствиеСвойствОбъектаЭтойКонфигурации);
	КонецЦикла;
	
	Куда = ОбъектXDTO;

КонецПроцедуры

Процедура Адапт_ЗаполнитьСубконтоЗаписиНабораЗаписей(Куда, Откуда) 
	
	Если Адапт_ЕстьСвойство(Откуда, "ExtDimensionsDr") И Адапт_ЕстьСвойство(Куда, "ExtDimensionsDr") Тогда
		
		СубконтоДтОткуда = Откуда.ExtDimensionsDr;
		СписокСубконтоКуда = Куда.ExtDimensionsDr;
		
		Для Сч = 0 По СубконтоДтОткуда.Value.Количество() - 1 Цикл
			ИмяСубконто = СубконтоДтОткуда.Type[Сч];
			ЗначениеСубКонто =  СубконтоДтОткуда.Value[Сч];
			СписокСубконтоКуда.Вставить(ИмяСубконто, ЗначениеСубКонто);
		КонецЦикла;
		
	КонецЕсли;
		
	Если Адапт_ЕстьСвойство(Откуда, "ExtDimensionsCr") И Адапт_ЕстьСвойство(Куда, "ExtDimensionsCr") Тогда
		СубконтоКтОткуда = Откуда.ExtDimensionsCr;
		СписокСубконтоКуда = Куда.ExtDimensionsCr;
		
		Для Сч = 0 По СубконтоКтОткуда.Value.Количество() - 1 Цикл
			ИмяСубконто = СубконтоКтОткуда.Type[Сч];
			ЗначениеСубКонто =  СубконтоКтОткуда.Value[Сч];
			СписокСубконтоКуда.Вставить(ИмяСубконто, ЗначениеСубКонто);
		КонецЦикла;
	КонецЕсли;
	
	Если Адапт_ЕстьСвойство(Откуда, "ExtDimensions") И Адапт_ЕстьСвойство(Куда, "ExtDimensions") Тогда
		СубконтоОткуда = Откуда.ExtDimensions;
		СписокСубконтоКуда = Куда.ExtDimensions;
		
		Для Сч = 0 По СубконтоОткуда.Value.Количество() - 1 Цикл
			ИмяСубконто = СубконтоОткуда.Type[Сч];
			ЗначениеСубКонто =  СубконтоОткуда.Value[Сч];
			СписокСубконтоКуда.Вставить(ИмяСубконто, ЗначениеСубКонто);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура Адапт_ЗаполнитьДополнительныеСвойства(ЗагруженноеЗначение, СтруктураПараметров)
	

	Если Не Адапт_ЕстьСвойство(ЗагруженноеЗначение, "ДополнительныеСвойства") Тогда
		Возврат;
	КонецЕсли;

	Если СтруктураПараметров.ОтключитьРегистрациюПлановОбмена Тогда
		ЗагруженноеЗначение.ДополнительныеСвойства.Вставить("ОтключитьМеханизмРегистрацииОбъектов", Истина);
	КонецЕсли;
	
	Если СтруктураПараметров.НеВыполнятьКонтрольУдаляемых Тогда
		ЗагруженноеЗначение.ДополнительныеСвойства.Вставить("НеВыполнятьКонтрольУдаляемых", Истина);
	КонецЕсли;
	
	Если СтруктураПараметров.ПропуститьЗаписьВерсииОбъекта Тогда
		ЗагруженноеЗначение.ДополнительныеСвойства.Вставить("ПропуститьЗаписьВерсииОбъекта", Истина);
	КонецЕсли;

КонецПроцедуры

Процедура Адапт_ЗаполнитьРядКоллекцииОбъектаXDTO(Куда, Откуда, СоответствиеСвойствОбъектаЭтойКонфигурации) 
	
	//Куда - СписокXDTO - может быть пустым, если данный ряд - первый
	//Откуда.Имя         = "ChartOfAccountsObject.Хозрасчетный"
	//Откуда.ИмяСвойства = "ExtDimensionType"
	//Откуда.Коллекция - СписокУзловDOM - содержит ЭлементыDOM на каждый реквизит
	Если Откуда.Коллекция.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТипXDTO = Откуда.ТипXDTO;
	ОбъектXDTO = ФабрикаXDTO.Создать(ТипXDTO);
	
	Если СтрНайти(Откуда.ТипXDTO.Имя, "Row.") > 0 Тогда
		ОбъектXDTO = ФабрикаXDTO.Создать(ТипXDTO);
		Адапт_ЗаполнитьСвойстваОбъектаXDTO(ОбъектXDTO, Откуда.Коллекция, ТипXDTO.Имя, СоответствиеСвойствОбъектаЭтойКонфигурации);
		НовСтрока = Куда.Добавить(ОбъектXDTO);
	Иначе
		Для каждого выбРяд Из Откуда.Коллекция Цикл
			ОбъектXDTO = ФабрикаXDTO.Создать(ТипXDTO);
			
			Адапт_ЗаполнитьСвойстваОбъектаXDTO(ОбъектXDTO, выбРяд.ДочерниеУзлы, ТипXDTO.Имя, СоответствиеСвойствОбъектаЭтойКонфигурации);
			НовСтрока = Куда.Добавить(ОбъектXDTO);
		КонецЦикла;
	
	КонецЕсли;
	
КонецПроцедуры

Процедура Адапт_ЗаполнитьРядТабличнойЧастиОбъектаXDTO(Куда, Откуда, ИмяТипа, СоответствиеСвойствОбъектаЭтойКонфигурации) 
	
	Если Откуда.Коллекция.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТипXDTO = Откуда.ТипXDTO;
	ОбъектXDTO = ФабрикаXDTO.Создать(ТипXDTO);
	
	Если Откуда.Коллекция[0].ИмяУзла = "Row" Тогда
		Для каждого выбРяд Из Откуда.Коллекция Цикл
			Адапт_ЗаполнитьСвойстваОбъектаXDTO(ОбъектXDTO, выбРяд.ДочерниеУзлы, ТипXDTO.Имя, СоответствиеСвойствОбъектаЭтойКонфигурации);
			НовСтрока = Куда.Добавить(ОбъектXDTO);
		КонецЦикла;
		
	Иначе
		Адапт_ЗаполнитьСвойстваОбъектаXDTO(ОбъектXDTO, Откуда.Коллекция, ТипXDTO.Имя, СоответствиеСвойствОбъектаЭтойКонфигурации);
		НовСтрока = Куда.Добавить(ОбъектXDTO);	
	КонецЕсли;
	
КонецПроцедуры

// Заполняет ОбъектXDTO из списка элементов DOM
//  Параметры:
//       Куда   - ОбъектXDTO     - ОбъектXDTO нужного типа из типов XDTO данной конфигурации
//       Откуда - СписокУзловDOM - список содержит элементы DOM со значениями реквизитов
Функция Адапт_ЗаполнитьСвойстваОбъектаXDTO(Куда, Откуда, ПолноеИмяРодОбъекта, СоответствиеСвойствОбъектаЭтойКонфигурации) 

	
	ТипXDTO_ОписаниеТипов = ФабрикаXDTO.Тип("http://v8.1c.ru/8.1/data/core", "TypeDescription");
	ТипXDTO_Отбор = ФабрикаXDTO.Тип("http://v8.1c.ru/8.1/data/enterprise", "Filter");
	КлючиОткуда = "Коллекция, Имя, ИмяСвойства, ТипXDTO";
	
	ОписаниеРеквизитовОбъекта = Адапт_ПолучитьИнформациюОРеквизитахОбъектаЭтойКонфигурации(ПолноеИмяРодОбъекта);
	
	ЭтоГруппа = Ложь;
	ГУИД = Неопределено;
	Для каждого СвойствоОбъекта Из Откуда Цикл
		
		Попытка
			ИмяСвойства = Адапт_ПолучитьИмяОбъекта(СвойствоОбъекта);
			
			Если ИмяСвойства = "IsFolder" Тогда
				ЭтоГруппа = СвойствоОбъекта.ТекстовоеСодержимое = "true";
			ИначеЕсли ИмяСвойства = "Ref" Тогда
				ГУИД = СвойствоОбъекта.ТекстовоеСодержимое;
			КонецЕсли;
			
			СвойствоXDTOИзСхемы = СоответствиеСвойствОбъектаЭтойКонфигурации[ИмяСвойства];
			
			
			Если СвойствоXDTOИзСхемы = Неопределено Тогда
				
				//ТекстСообщения = "Нет свойства: " + ПолноеИмяРодОбъекта + " " + ИмяСвойства; //мВсеОбъектыКонфигурации
				//Адапт_СообщитьОбОшибкеБезПовторов(ТекстСообщения);
				
				Продолжить;
			КонецЕсли;			
			
			ТипСвойстваЭтаКонфигурация = Адапт_ПолучитьТипСвойстваЭтаКонфигурация(СвойствоXDTOИзСхемы, СвойствоОбъекта);
			
			Если ТипСвойстваЭтаКонфигурация = Неопределено Тогда
				Продолжить;
			ИначеЕсли  ТипСвойстваЭтаКонфигурация = Null Тогда // свойство Откуда - не заполнено и не указан тип
				Продолжить;
			КонецЕсли;
			
			
			Подчиненные = СвойствоОбъекта.ДочерниеУзлы;
			
			Если Адапт_ЕстьСвойство(ТипСвойстваЭтаКонфигурация, "Свойства") Тогда
				ИмяТипа = СвойствоXDTOИзСхемы.type.ЛокальноеИмя;
				
				
				ВариантЗагрузкиСвойства = Адапт_ВариантЗагрузкиСвойства(ТипСвойстваЭтаКонфигурация, ИмяТипа, ТипXDTO_ОписаниеТипов, ТипXDTO_Отбор);
				
				Если ВариантЗагрузкиСвойства = "ЭтоОписаниеТипов" Тогда
					
					КоллекцияСвойствОбъекта = Куда.Свойства();
					СвойствоXDTO = Адапт_ПолучитьСвойствоXDTO(КоллекцияСвойствОбъекта, ИмяСвойства, ПолноеИмяРодОбъекта);
					
					ЗначениеXDTO = ФабрикаXDTO.Создать(ТипСвойстваЭтаКонфигурация);
					Адапт_ЗаполнитьОписаниеТиповXDTO(ЗначениеXDTO, СвойствоОбъекта); 
					Куда.Установить(СвойствоXDTO, ЗначениеXDTO);
					Продолжить;
					
				ИначеЕсли ВариантЗагрузкиСвойства = "ЭтоОтбор" Тогда
					
					КоллекцияСвойствОбъекта = Куда.Свойства();
					СвойствоXDTO = Адапт_ПолучитьСвойствоXDTO(КоллекцияСвойствОбъекта, ИмяСвойства, ПолноеИмяРодОбъекта);
					ЗначениеXDTO = ФабрикаXDTO.Создать(ТипСвойстваЭтаКонфигурация);
					Если Адапт_ЗаполнитьОтборXDTO(ЗначениеXDTO, СвойствоОбъекта) = Истина Тогда
						Куда.Установить(СвойствоXDTO, ЗначениеXDTO);
					Иначе
						Возврат Новый Структура("ГУИД, Ошибка", Неопределено, Истина);
					КонецЕсли;
					
				ИначеЕсли ВариантЗагрузкиСвойства = "ЭтоРядТабличнойЧасти" Тогда
					
					ОписанияРеквизитовКоллекции = Адапт_ПолучитьСвойстваОбъектаXDTOТекущейКонфигурации(ИмяТипа);
					СтруктураОткуда = Новый Структура(КлючиОткуда, Подчиненные, ПолноеИмяРодОбъекта, ИмяСвойства, ТипСвойстваЭтаКонфигурация);
						
					Адапт_ЗаполнитьРядТабличнойЧастиОбъектаXDTO(Куда[ИмяСвойства], СтруктураОткуда, ИмяТипа, ОписанияРеквизитовКоллекции);
					
				ИначеЕсли ВариантЗагрузкиСвойства = "ЭтоРядКоллекции" Тогда
					
					ИмяКоллекцииЕдЧисло = Адапт_ПреобразоватьИмяСтандартнойКоллекции(Куда, ИмяСвойства);
					
					ОписанияРеквизитовКоллекции = Адапт_ПолучитьСвойстваОбъектаXDTOТекущейКонфигурации(ИмяТипа);
					СтруктураОткуда = Новый Структура(КлючиОткуда, Подчиненные, ПолноеИмяРодОбъекта, ИмяСвойства, ТипСвойстваЭтаКонфигурация);
					Адапт_ЗаполнитьРядКоллекцииОбъектаXDTO(Куда[ИмяКоллекцииЕдЧисло], СтруктураОткуда, ОписанияРеквизитовКоллекции);
					
				ИначеЕсли ВариантЗагрузкиСвойства = "ЭтоСубконто" Тогда
					
					ОписанияРеквизитовКоллекции = Адапт_ПолучитьСвойстваОбъектаXDTOТекущейКонфигурации(ИмяТипа);
					СтруктураОткуда = Новый Структура(КлючиОткуда, Подчиненные, ПолноеИмяРодОбъекта, ИмяСвойства, ТипСвойстваЭтаКонфигурация);
					Адапт_ЗаполнитьСубконтоОбъектаXDTO(Куда[ИмяСвойства], СтруктураОткуда, ОписанияРеквизитовКоллекции);	
					
				Иначе
					
					ОписанияРеквизитовКоллекции = Адапт_ПолучитьСвойстваОбъектаXDTOТекущейКонфигурации(ИмяТипа);
					СтруктураОткуда = Новый Структура(КлючиОткуда, Подчиненные, ПолноеИмяРодОбъекта, ИмяСвойства, ТипСвойстваЭтаКонфигурация);
					Адапт_ЗаполнитьТабЧастьОбъектаXDTO(Куда[ИмяСвойства], СтруктураОткуда, ОписанияРеквизитовКоллекции);
				КонецЕсли;
				
			Иначе
				ТекстовоеСодержимоеУзла = СвойствоОбъекта.ТекстовоеСодержимое;
				
				Если Адапт_ЭтоПеречисление(ТипСвойстваЭтаКонфигурация.Имя)  Тогда
					Значение = Адапт_ПолучитьЗначениеПеречисления(ТипСвойстваЭтаКонфигурация.Имя, ТекстовоеСодержимоеУзла);
					
					Если Значение = Неопределено Тогда
						Продолжить;
					КонецЕсли;
					ЗначениеXDTO = ФабрикаXDTO.Создать(ТипСвойстваЭтаКонфигурация, Значение);
				Иначе

					ОписаниеТипаРеквизитаОбъекта = ОписаниеРеквизитовОбъекта[ИмяСвойства];
					Если Адапт_ЭтоПростойТипXDTO(ТипСвойстваЭтаКонфигурация) Или ТекстовоеСодержимоеУзла = "" Тогда
						ОписаниеТипов = ОписаниеТипаРеквизитаОбъекта.Тип;
						ПриведенноеЗначение = ОписаниеТипов.ПривестиЗначение(ТекстовоеСодержимоеУзла);
						Адапт_ПроверитьНаСимволыВозвратКаретки(ОписаниеТипов, ТекстовоеСодержимоеУзла, ПриведенноеЗначение);
						ЗначениеXDTO = ФабрикаXDTO.Создать(ТипСвойстваЭтаКонфигурация, ПриведенноеЗначение);
					Иначе
						ЗначениеXDTO = ФабрикаXDTO.Создать(ТипСвойстваЭтаКонфигурация, ТекстовоеСодержимоеУзла);
					КонецЕсли;
					
				КонецЕсли;
				
				Если ТипЗнч(Куда[ИмяСвойства]) = Тип("СписокXDTO") Тогда
					Куда[ИмяСвойства].Добавить(ЗначениеXDTO);
					
				Иначе
					КоллекцияСвойствОбъекта = Куда.Свойства();
					СвойствоXDTO = Адапт_ПолучитьСвойствоXDTO(КоллекцияСвойствОбъекта, ИмяСвойства, ПолноеИмяРодОбъекта);
					Куда.Установить(СвойствоXDTO, ЗначениеXDTO);
				КонецЕсли;
			КонецЕсли;
			
		Исключение
			ОШ = ОписаниеОшибки();
			СообщитьПользователю(ОШ);
			Возврат Новый Структура("ГУИД, Ошибка", ГУИД, Истина);
		КонецПопытки;
		
	КонецЦикла;
	
	Если ЭтоГруппа = Ложь Тогда
		Адапт_ДоЗаполнитьПустымиЗначениямиТипов(Куда, ПолноеИмяРодОбъекта, СоответствиеСвойствОбъектаЭтойКонфигурации);
	КонецЕсли;
	
	Возврат Новый Структура("ГУИД, Ошибка", ГУИД, Ложь);
	
КонецФункции

Функция Адапт_ВариантЗагрузкиСвойства(ТипСвойстваЭтаКонфигурация, ИмяТипа, ТипXDTO_ОписаниеТипов, ТипXDTO_Отбор) 
	
	ЭтоОписаниеТипов = (ТипСвойстваЭтаКонфигурация = ТипXDTO_ОписаниеТипов);
	
	Если ТипСвойстваЭтаКонфигурация = ТипXDTO_ОписаниеТипов Тогда
		Возврат "ЭтоОписаниеТипов";
		
	ИначеЕсли ТипСвойстваЭтаКонфигурация = ТипXDTO_Отбор Тогда
		Возврат "ЭтоОтбор";
		
	ИначеЕсли СтрНайти(ИмяТипа, "Row.") > 0 Тогда
		
		Если (СтрНайти(ИмяТипа, "TabularSectionRow.") > 0) Тогда
			Возврат "ЭтоРядТабличнойЧасти";
		Иначе
			Возврат "ЭтоРядКоллекции";
		КонецЕсли;
		
	ИначеЕсли СтрНайти(ИмяТипа, "AccountingRegisterExtDimensions.") > 0 Тогда
		Возврат "ЭтоСубконто";
		
	Иначе
		
		Возврат "ОбщийВариант";
	КонецЕсли;
	
КонецФункции

Процедура Адапт_ПроверитьНаСимволыВозвратКаретки(ОписаниеТипов, ТекстовоеСодержимоеУзла, ПриведенноеЗначение) 
	
	Если ТипЗнч(ПриведенноеЗначение) <> Тип("Строка") Тогда
		Возврат;
	КонецЕсли;
	
	Если СтрДлина(ТекстовоеСодержимоеУзла) > СтрДлина(ПриведенноеЗначение) Тогда
		НовТекст = СтрЗаменить(ТекстовоеСодержимоеУзла, Символы.ВК, "");
		ПриведенноеЗначение = ОписаниеТипов.ПривестиЗначение(НовТекст);
	КонецЕсли;
	
КонецПроцедуры

// Создает структуру с информацией о реквизите объекта конфигурации из метаданных
// Возвращаемое значение:
//	Структура - содержит поля:
//		* Имя - Строка - Русское соответствие имени ("Code" - "Код") 
//		* Тип - ОписаниеТипов -  
//		* Использование - Строка - "ДляГруппы", "ДляГруппыИЭлемента", "ДляЭлемента", Неопределено 
Функция Адапт_ПолучитьИнформациюОРеквизитеОбъектаЭтойКонфигурации(ПолноеИмяОбъекта, ИмяРеквизита = Неопределено) 
	
	Структура = Адапт_ПолучитьЧастиИмениОбъекта(ПолноеИмяОбъекта, Истина);
	ВидОбъектаРус = Структура.ВидОбъекта;
	ИмяОбъекта = Структура.ИмяОбъекта;
	ИмяТабчасти = Структура.ИмяТабчасти;
	
	Если ИмяТабчасти = "" Тогда
		Реквизиты = мОписанияТиповКонфигурации[ВидОбъектаРус][ИмяОбъекта].Реквизиты;
	Иначе
		Реквизиты = мОписанияТиповКонфигурации[ВидОбъектаРус][ИмяОбъекта].ТабличныеЧасти[ИмяТабчасти];
	КонецЕсли;
	
	Если ИмяРеквизита = Неопределено Тогда
		Результат = Реквизиты;
	Иначе
		Результат = Реквизиты[ИмяРеквизита];
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Создает структуру с информацией о реквизитах объекта конфигурации из метаданных
// Возвращаемое значение:
//	Соответствие 
//   Ключ - Строка - ПолноеИмяОбъекта
