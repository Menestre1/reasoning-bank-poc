	Если мОшибкиБезПовторов[ТекстСообщения] = Неопределено Тогда
		Сообщить(ТекстСообщения);
		мОшибкиБезПовторов.Вставить(ТекстСообщения, "СообщениеВыведено");
	КонецЕсли;
	
