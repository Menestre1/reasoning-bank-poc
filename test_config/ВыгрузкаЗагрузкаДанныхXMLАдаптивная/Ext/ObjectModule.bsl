			СоотвРеквизитыОбъекта = Новый Соответствие;
			СоотвТабчастиОбъекта = Новый Соответствие;
			РеквизитыТабчасти = Новый Структура("Реквизиты, ТабличныеЧасти", СоотвРеквизитыОбъекта, СоотвТабчастиОбъекта);
			
			СоотвОбъекты.Вставить(выбОбъект.Имя, РеквизитыТабчасти);
			
			Если ВидМетаданных = "Константы" Тогда
				СтруктураРеквизита = Адапт_СтруктураРеквизита("Value", Неопределено, выбОбъект.Тип);
				СоотвРеквизитыОбъекта.Вставить("Value", СтруктураРеквизита);
				Продолжить;
			КонецЕсли;
			
			
			Для каждого выбРеквизит Из выбОбъект.СтандартныеРеквизиты Цикл
				СтруктураРеквизита = Новый Структура();
				
				ИмяРеквизитаАнгл = СоотвРусАнгл[выбРеквизит.Имя];
				Если ИмяРеквизитаАнгл = Неопределено Тогда
					СообщитьПользователю("Не найден английский синоним: " + выбРеквизит.Имя);	
				КонецЕсли;
				
				СтруктураРеквизита.Вставить("Имя",           выбРеквизит.Имя);
				СтруктураРеквизита.Вставить("Использование", Неопределено);
				СтруктураРеквизита.Вставить("Тип",           выбРеквизит.Тип);
				
				СоотвРеквизитыОбъекта.Вставить(ИмяРеквизитаАнгл, СтруктураРеквизита);
			КонецЦикла;
			
			Для каждого КЗ Из ОбщиеРеквизиты Цикл
				ОбщРеквизит = КЗ.Ключ;
				Состав = КЗ.Значение;
				ЭлСостава = Состав[выбОбъект];
				
				Если ЭлСостава = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				
				СтруктураРеквизита = Новый Структура();
				СтруктураРеквизита.Вставить("Имя",           ОбщРеквизит.Имя);
				СтруктураРеквизита.Вставить("Использование", Неопределено);
				СтруктураРеквизита.Вставить("Тип",           ОбщРеквизит.Тип);
				
				СоотвРеквизитыОбъекта.Вставить(ОбщРеквизит.Имя, СтруктураРеквизита);
			КонецЦикла;
			
			Для каждого выбРеквизит Из выбОбъект.Реквизиты Цикл
				Если ВидМетаданных = "Справочники" Или ВидМетаданных = "ПланыВидовХарактеристик" Тогда
					Использование = Строка(выбРеквизит.Использование);
				Иначе
					Использование = Неопределено;
				КонецЕсли;
				СтруктураРеквизита = Новый Структура();
				СтруктураРеквизита.Вставить("Имя",           выбРеквизит.Имя);
				СтруктураРеквизита.Вставить("Использование", Использование);
				СтруктураРеквизита.Вставить("Тип",           выбРеквизит.Тип);
				
				СоотвРеквизитыОбъекта.Вставить(выбРеквизит.Имя, СтруктураРеквизита);
			КонецЦикла;
			
			Если ВидМетаданных = "ПланыВидовХарактеристик" Тогда
				СтруктураРеквизита = Новый Структура();
				СтруктураРеквизита.Вставить("Имя",           выбРеквизит.Имя);
				СтруктураРеквизита.Вставить("Использование", Неопределено);
				СтруктураРеквизита.Вставить("Тип",           Тип("ОписаниеТипов"));
				СоотвРеквизитыОбъекта.Вставить("ValueType", СтруктураРеквизита);
				
			ИначеЕсли ВидМетаданных = "ПланыСчетов" Тогда
				Для каждого выбПризнак Из выбОбъект.ПризнакиУчета Цикл
					СтруктураРеквизита = Адапт_СтруктураРеквизита(выбПризнак.Имя, Неопределено, выбПризнак.Тип);
					СоотвРеквизитыОбъекта.Вставить(выбПризнак.Имя, СтруктураРеквизита);
				КонецЦикла;
				
				Для каждого выбПризнак Из выбОбъект.ПризнакиУчетаСубконто Цикл
					СтруктураРеквизита = Адапт_СтруктураРеквизита(выбПризнак.Имя, Неопределено, выбПризнак.Тип);
					СоотвРеквизитыОбъекта.Вставить(выбПризнак.Имя, СтруктураРеквизита);
				КонецЦикла;
				
				СтруктураРеквизита = Адапт_СтруктураРеквизита("TurnoversOnly", Неопределено, Новый ОписаниеТипов("Булево"));
				СоотвРеквизитыОбъекта.Вставить("TurnoversOnly", СтруктураРеквизита);
				
			ИначеЕсли ВидМетаданных = "РегистрыБухгалтерии" Тогда
				Для каждого выбИзмерение Из выбОбъект.Измерения Цикл
					
					Если выбИзмерение.ПризнакУчета = Неопределено Тогда
						СтруктураИзмерения = Новый Структура;
						СтруктураИзмерения.Вставить("Имя",      выбИзмерение.Имя);
						СтруктураИзмерения.Вставить("Тип",      выбИзмерение.Тип);
						СоотвРеквизитыОбъекта.Вставить(выбИзмерение.Имя, СтруктураИзмерения);
					Иначе
						СтруктураИзмерения = Новый Структура;
						СтруктураИзмерения.Вставить("Имя",      выбИзмерение.Имя + "Cr");
						СтруктураИзмерения.Вставить("Тип",      выбИзмерение.Тип);
						СоотвРеквизитыОбъекта.Вставить(выбИзмерение.Имя + "Cr", СтруктураИзмерения);
						СтруктураИзмерения = Новый Структура;
						СтруктураИзмерения.Вставить("Имя",      выбИзмерение.Имя + "Dr");
						СтруктураИзмерения.Вставить("Тип",      выбИзмерение.Тип);
						СоотвРеквизитыОбъекта.Вставить(выбИзмерение.Имя + "Dr", СтруктураИзмерения);
					КонецЕсли;
				КонецЦикла;
				
				Для каждого выбРесурс Из выбОбъект.Ресурсы Цикл
					Если выбРесурс.ПризнакУчета = Неопределено Тогда
						СтруктураРесурса = Новый Структура;
						СтруктураРесурса.Вставить("Имя",      выбРесурс.Имя);
						СтруктураРесурса.Вставить("Тип",      выбРесурс.Тип);
						СоотвРеквизитыОбъекта.Вставить(выбРесурс.Имя, СтруктураРесурса);
					Иначе
						СтруктураРесурса = Новый Структура;
						СтруктураРесурса.Вставить("Имя",      выбРесурс.Имя + "Cr");
						СтруктураРесурса.Вставить("Тип",      выбРесурс.Тип);
						СоотвРеквизитыОбъекта.Вставить(выбРесурс.Имя + "Cr", СтруктураРесурса);
						
						СтруктураРесурса = Новый Структура;
						СтруктураРесурса.Вставить("Имя",      выбРесурс.Имя + "Dr");
						СтруктураРесурса.Вставить("Тип",      выбРесурс.Тип);
						СоотвРеквизитыОбъекта.Вставить(выбРесурс.Имя + "Dr", СтруктураРесурса);
					КонецЕсли;
				КонецЦикла;
				
			ИначеЕсли ВидМетаданных = "РегистрыСведений"
				Или ВидМетаданных = "РегистрыНакопления"
				Или ВидМетаданных = "РегистрыРасчета" Тогда
				
				Для каждого выбИзмерение Из выбОбъект.Измерения Цикл
					СтруктураИзмерения = Новый Структура;
					СтруктураИзмерения.Вставить("Имя",      выбИзмерение.Имя);
					СтруктураИзмерения.Вставить("Тип",      выбИзмерение.Тип);
					СоотвРеквизитыОбъекта.Вставить(выбИзмерение.Имя, СтруктураИзмерения);
				КонецЦикла;
				Для каждого выбРесурс Из выбОбъект.Ресурсы Цикл
					СтруктураРесурса = Новый Структура;
					СтруктураРесурса.Вставить("Имя",        выбРесурс.Имя);
					СтруктураРесурса.Вставить("Тип",        выбРесурс.Тип);
					СоотвРеквизитыОбъекта.Вставить(выбРесурс.Имя, СтруктураРесурса);
				КонецЦикла;
			ИначеЕсли ВидМетаданных =  "ПланыВидовРасчета" Тогда

			КонецЕсли;
			
			Если Адапт_ЕстьСвойство(выбОбъект, "ТабличныеЧасти") Тогда
				Для каждого выбТабчасть Из выбОбъект.ТабличныеЧасти Цикл
					РеквизитыТабчасти = Новый Соответствие;
					СоотвТабчастиОбъекта.Вставить(выбТабчасть.Имя, РеквизитыТабчасти);
					
					Для каждого выбРеквизит Из выбТабчасть.СтандартныеРеквизиты Цикл
						СтруктураРеквизита = Адапт_СтруктураРеквизита(выбРеквизит.Имя, Неопределено, выбРеквизит.Тип);
						РеквизитыТабчасти.Вставить(выбРеквизит.Имя, СтруктураРеквизита);
					КонецЦикла;
					
					Для каждого выбРеквизит Из выбТабчасть.Реквизиты Цикл
						СтруктураРеквизита = Адапт_СтруктураРеквизита(выбРеквизит.Имя, Неопределено, выбРеквизит.Тип);
						РеквизитыТабчасти.Вставить(выбРеквизит.Имя, СтруктураРеквизита);
					КонецЦикла;
				КонецЦикла
			КонецЕсли;
			
			Если Адапт_ЕстьСвойство(выбОбъект, "СтандартныеТабличныеЧасти") Тогда
				Для каждого выбТабчасть Из выбОбъект.СтандартныеТабличныеЧасти Цикл
					РеквизитыТабчасти = Новый Соответствие;
					СоотвТабчастиОбъекта.Вставить(выбТабчасть.Имя, РеквизитыТабчасти);
					
					Для каждого выбРеквизит Из выбТабчасть.СтандартныеРеквизиты Цикл
						СтруктураРеквизита = Адапт_СтруктураРеквизита(выбРеквизит.Имя, Неопределено, выбРеквизит.Тип); 
						РеквизитыТабчасти.Вставить(выбРеквизит.Имя, СтруктураРеквизита);
					КонецЦикла;
					
				КонецЦикла
			КонецЕсли;
			
		КонецЦикла;
	КонецЦикла;
	
	мОписанияТиповКонфигурации = СоотвВидыОбъектов;
	
КонецПроцедуры

Функция Адапт_СтруктураРеквизита(Имя, Использование, Тип) 
	
	СтруктураРеквизита = Новый Структура();
	СтруктураРеквизита.Вставить("Имя",           Имя);
	СтруктураРеквизита.Вставить("Использование", Использование);
	СтруктураРеквизита.Вставить("Тип",           Тип);
	
	Возврат СтруктураРеквизита;
	
КонецФункции

Функция Адапт_ПолучитьВидыОбъектов() 
	
	Массив = Новый Массив;
	Массив.Добавить("Константы");
	Массив.Добавить("Справочники");
	Массив.Добавить("Документы");
	Массив.Добавить("ПланыВидовХарактеристик");
	Массив.Добавить("ПланыСчетов");
	Массив.Добавить("ПланыВидовРасчета");
	Массив.Добавить("РегистрыСведений");
	Массив.Добавить("РегистрыНакопления");
	Массив.Добавить("РегистрыБухгалтерии");
	Массив.Добавить("РегистрыРасчета");
	Массив.Добавить("БизнесПроцессы");
	Массив.Добавить("Задачи");
	Массив.Добавить("ПланыОбмена");
	
	Возврат Массив;
	
КонецФункции

Функция Адапт_ПолучитьСоответствиеОбщихРеквизитов() 
	
	ОбщиеРеквизиты = Новый Соответствие;
	Авто = Метаданные.СвойстваОбъектов.ИспользованиеОбщегоРеквизита.Авто;
	Использование = Метаданные.СвойстваОбъектов.ИспользованиеОбщегоРеквизита.Использовать;
	АвтоИспользование = Метаданные.СвойстваОбъектов.АвтоИспользованиеОбщегоРеквизита.Использовать;
	
	Для каждого ОбщРеквизит Из Метаданные.ОбщиеРеквизиты Цикл
		Состав = ОбщРеквизит.Состав;
		
		Соотв = Новый Соответствие;
		ОбщиеРеквизиты.Вставить(ОбщРеквизит, Соотв);
		
		Для каждого ЭлСостава Из Состав Цикл
			Если ЭлСостава.Использование = Использование
					Или (ЭлСостава.Использование = Авто 
						И ОбщРеквизит.АвтоИспользование = АвтоИспользование)
					Тогда
					Соотв.Вставить(ЭлСостава.Метаданные, Истина);
			КонецЕсли;		
		КонецЦикла;
	
	КонецЦикла;
	
	Возврат ОбщиеРеквизиты;
	
КонецФункции

Функция ПолучитьМенеджер(выбОбъект) 
	
	Возврат Вычислить("выбОбъект.Менеджер");	

КонецФункции

Функция Адапт_ПолучитьМенеджерПоИмени(ИмяТипа) 
	
	Структура = Адапт_ПолучитьЧастиИмениОбъекта(ИмяТипа, Истина);
	
	Попытка
		
		Результат = Вычислить(Структура.ВидОбъекта + "." + Структура.ИмяОбъекта);
	Исключение
		ОписаниеОшибки = ОписаниеОшибки();
	    Сообщить(НСтр("ru = '" + ОписаниеОшибки + "'"), СтатусСообщения.Внимание);
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Процедура Адапт_СообщитьПрогрессЗагрузки(КоличествоОбъектов, Сч, ТекстСообщения = "")
	
	Перем Квант, Процент;
	
	Если мЭтоФоновыйРежим = Ложь Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекстСообщения) Тогда
		мДлительныеОперации.СообщитьПрогресс(, ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	Квант = Окр(КоличествоОбъектов / 100);
	Если Квант = 0 Или Сч % Квант = 0 Тогда
		Процент = Окр(Сч / КоличествоОбъектов * 100);
		мДлительныеОперации.СообщитьПрогресс(Процент, "Загружено объектов: " + Сч + " из " + КоличествоОбъектов);	
	КонецЕсли;

КонецПроцедуры

Процедура Адапт_СообщитьПрогрессВыгрузки(Сч, КоличествоОбъектов, ТекстСообщения = "")
	
	Перем Квант, Процент;
	
	Если мЭтоФоновыйРежим = Ложь Тогда
		Возврат;	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекстСообщения) Тогда
		мДлительныеОперации.СообщитьПрогресс(, ТекстСообщения);
		Возврат;	
	КонецЕсли;
	
	Квант = Окр(КоличествоОбъектов / 100);
	Если Квант = 0 Или Сч % Квант = 0 Тогда
		Процент = Окр(Сч / КоличествоОбъектов * 100);
		мДлительныеОперации.СообщитьПрогресс(Процент, "Выгружено объектов: " + Сч + " из " + КоличествоОбъектов);	
	КонецЕсли;

КонецПроцедуры

Процедура Адапт_ИнициализироватьСоотвОбъектовМетаданныхДерева() 
	
	Если мСоотвОбъектовМетаданныхДерева <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	мСоотвОбъектовМетаданныхДерева = Новый Соответствие;
	
	Строки = ДеревоМетаданных.Строки;
	
	Адапт_ЗаполнитьСоотвОбъектовМетаданныхДереваРекурсия(Строки);
	
КонецПроцедуры

Процедура Адапт_ЗаполнитьСоотвОбъектовМетаданныхДереваРекурсия(Строки) 
	
	Для каждого выбСтрока Из Строки Цикл
		мСоотвОбъектовМетаданныхДерева.Вставить(выбСтрока.ОбъектМД, выбСтрока);
		Подчиненные = выбСтрока.Строки;
		Если Подчиненные.Количество() > 0 Тогда
			Адапт_ЗаполнитьСоотвОбъектовМетаданныхДереваРекурсия(Подчиненные);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция Адапт_ПодсчитатьКоличествоВыгружаемыхОбъектов()
	
	Если Ложь Тогда ДополнительныеОбъектыДляВыгрузки = Новый ТаблицаЗначений КонецЕсли;
	
	мПодсчитанныеОбъекты = Новый ТаблицаЗначений;
	мПодсчитанныеОбъекты.Колонки.Добавить("Ссылка");
	мПодсчитанныеОбъекты.Индексы.Добавить("Ссылка");
	
	
	Адапт_СообщитьПрогрессВыгрузки(,,"Подсчет количества объектов выгрузки...");
	
	Для Каждого СтрокаТаблицыВыгрузки Из СоставПолнойВыгрузки Цикл
		
		СтрокаДереваМетаданных = СтрокаТаблицыВыгрузки.СтрокаДерева;
		
		Если СтрокаДереваМетаданных.ЭлементОписания.Менеджер = Неопределено Тогда
			ВызватьИсключение(Нстр("ru = 'Выгрузка данных. Внутренняя ошибка'"));
		КонецЕсли;
		
		Если Метаданные.Константы.Содержит(СтрокаДереваМетаданных.ОбъектМД) Тогда
			
			Адапт_КонстантыПодсчетВыгружаемых(СтрокаДереваМетаданных.ОбъектМД);
			
		ИначеЕсли Метаданные.РегистрыСведений.Содержит(СтрокаДереваМетаданных.ОбъектМД) Или
			Метаданные.РегистрыНакопления.Содержит(СтрокаДереваМетаданных.ОбъектМД) Или
			Метаданные.РегистрыРасчета.Содержит(СтрокаДереваМетаданных.ОбъектМД) Тогда
			
			Адапт_РегистрПодсчетВыгружаемых(СтрокаДереваМетаданных);
			
		ИначеЕсли Метаданные.РегистрыБухгалтерии.Содержит(СтрокаДереваМетаданных.ОбъектМД) Тогда
			
			Адапт_РегистрПодсчетВыгружаемых(СтрокаДереваМетаданных, Истина);
			
		ИначеЕсли ТипЗнч(СтрокаДереваМетаданных.ЭлементОписания.Менеджер) = Тип("Строка") Тогда

			Адапт_ПерерасчетыПодсчетВыгружаемых(СтрокаДереваМетаданных);
			
		ИначеЕсли Метаданные.Последовательности.Содержит(СтрокаДереваМетаданных.ОбъектМД) Тогда
			
			Адапт_ПоследовательностиПодсчетВыгружаемых(СтрокаДереваМетаданных);
			
		Иначе
			
			Адапт_ДанныеОбъектногоТипаПодсчетВыгружаемых(СтрокаДереваМетаданных);
			
		КонецЕсли;
		
	КонецЦикла;
	
	ДополнительныеОбъектыДляВыгрузки.Сортировать("ИмяОбъектаДляЗапроса");
	ТекущийМассивСсылок = Новый Массив();
	ТекущееИмяЗапроса = "";
	
	Для Каждого СтрокаТаблицыВыгрузки Из ДополнительныеОбъектыДляВыгрузки Цикл
		
		Если НЕ ЗначениеЗаполнено(СтрокаТаблицыВыгрузки.Объект)
			ИЛИ НЕ ЗначениеЗаполнено(СтрокаТаблицыВыгрузки.ИмяОбъектаДляЗапроса) Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		Если ТекущееИмяЗапроса <> СтрокаТаблицыВыгрузки.ИмяОбъектаДляЗапроса Тогда
			
			Адапт_ДанныеМассиваСсылокПодсчетВыгружаемых();
			
			ТекущийМассивСсылок = Новый массив();
			ТекущееИмяЗапроса = СтрокаТаблицыВыгрузки.ИмяОбъектаДляЗапроса;
			
		КонецЕсли;
		
		ТекущийМассивСсылок.Добавить(СтрокаТаблицыВыгрузки.Объект);
		
	КонецЦикла;
	
	Адапт_ДанныеМассиваСсылокПодсчетВыгружаемых();
	
	Возврат мПодсчитанныеОбъекты.Количество();
	
	
КонецФункции

Процедура Адапт_КонстантыПодсчетВыгружаемых(МД_Константа) 
	
	МенеджерЗначения = Константы[МД_Константа.Имя].СоздатьМенеджерЗначения();
	МенеджерЗначения.Прочитать();
	Адапт_ПодсчитатьЗначениеПриНеобходимости(МенеджерЗначения.Значение);
	
КонецПроцедуры

Процедура Адапт_ПодсчитатьСсылкиНабораЗаписей(МенеджерНабораЗаписей, ДляЗапроса, ИмяОбъекта, СтрокаДереваМетаданных = Неопределено, РегистрБухгалтерии = Ложь)
	
	// получить состав колонок записи регистра и проверить наличие хотя бы одной записи
	Если ДляЗапроса = "РегистрБухгалтерии." Тогда
		ИмяТаблицыДляЗапроса = ДляЗапроса + ИмяОбъекта + ".ДвиженияССубконто";	
	Иначе
		ИмяТаблицыДляЗапроса = ДляЗапроса + ИмяОбъекта;	
	КонецЕсли;
	
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 * ИЗ " + ИмяТаблицыДляЗапроса + " КАК ТаблицаОбъекта_" + ИмяОбъекта);
	
	РезультатЗапросаПоСоставу = Запрос.Выполнить();
	Если РезультатЗапросаПоСоставу.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаДвижений = РезультатЗапросаПоСоставу.Выгрузить();
	МассивКолонок = ПолучитьМассивКолонокДвижения(ТаблицаДвижений, РегистрБухгалтерии);
	
	// выгрузка регистров осуществляется через его набор записей
	НаборЗаписей = МенеджерНабораЗаписей.СоздатьНаборЗаписей();
	
	Отбор = НаборЗаписей.Отбор;
	
	ЕстьРегистратор = Ложь;
	МассивИмен = Новый Массив;
	Для каждого выбКолонка Из МассивКолонок Цикл
		//для регистров, подчиненных регистратору, может быть отбор только по регистратору
		Если выбКолонка = "Регистратор" Тогда 
			МассивИмен.Очистить();
			МассивИмен.Добавить("Регистратор");
			ЕстьРегистратор = Истина;
			Прервать;
		КонецЕсли;
		Если СтрНайти(выбКолонка, "Субконто") = 1 Тогда
			Продолжить;
		КонецЕсли;
		МассивИмен.Добавить(выбКолонка);
	КонецЦикла;
	
	Если ЕстьРегистратор Тогда
		СтрокаПолейОтбора = "Регистратор";
	Иначе		
		СтрокаПолейОтбора = СтрСоединить(МассивИмен, ",");
	КонецЕсли;
	
	КолонкиОтбора = Адапт_ПолучитьКолонкиОтбора(Отбор);
	
	
	ПостроительОтчета = ПодготовитьПостроительДляВыгрузки(СтрокаДереваМетаданных, СтрокаПолейОтбора); 
	ПостроительОтчета.Выполнить();
	РезультатЗапросаПоЗначениямОтбора = ПостроительОтчета.Результат;	
	ВыборкаИзРезультата = РезультатЗапросаПоЗначениямОтбора.Выбрать();
	
	КоличествоПолейОтбора = Отбор.Количество();
	
	// читаем наборы записей с различным составом отбора и записываем их
	Пока ВыборкаИзРезультата.Следующий() Цикл
		
		// Отбор устанавливаем для регистров, у которых есть хотя бы один отбор (измерение)
		
		// для регистров подчиненных регистратору, отбор только по регистратору
		
		Если ЕстьРегистратор Тогда
			Отбор.Регистратор.Установить(ВыборкаИзРезультата["Регистратор"]);
		ИначеЕсли КоличествоПолейОтбора <> 0 Тогда
		
			Для Каждого Колонка Из РезультатЗапросаПоЗначениямОтбора.Колонки Цикл
				Если Адапт_ЕстьСвойство(Отбор, Колонка.Имя) = Ложь Тогда
					Продолжить;
				КонецЕсли;
				Отбор[Колонка.Имя].Значение = ВыборкаИзРезультата[Колонка.Имя];
				Отбор[Колонка.Имя].ВидСравнения = ВидСравнения.Равно;
				Отбор[Колонка.Имя].Использование = Истина;
			КонецЦикла;
			
		КонецЕсли;
		
		НаборЗаписей.Прочитать();
		
		
		Если мНаличиеВыгрузкиПодчиненныхОбъектов Тогда
		
			// проверяем все записанные в наборе значения на необходимость записи "по ссылке"
			//ВыгрузитьПодчиненныеЗначенияНабора(ЗаписьXML, НаборЗаписей, МассивКолонок, ОбъектыВыгруженныеСОшибками, ТолькоПроверкаНедопустимыхСимволов);
			Адапт_ПодсчитатьПодчиненныеЗначенияНабора(НаборЗаписей, МассивКолонок);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура Адапт_РегистрПодсчетВыгружаемых(СтрокаДереваМетаданных, ЭтоРегистрБухгалтерии = Ложь) 
	
	МенеджерНабораЗаписей = СтрокаДереваМетаданных.ЭлементОписания.Менеджер[СтрокаДереваМетаданных.ОбъектМД.Имя];
	
	ИмяТаблицыДляЗапроса = СтрокаДереваМетаданных.ЭлементОписания.ДляЗапроса;
		
	//ЗаписьЧерезНаборЗаписей(ЗаписьXML, МенеджерНабораЗаписей, ИмяТаблицыДляЗапроса, 
		//СтрокаДереваМетаданных.ОбъектМД.Имя, СтрокаДереваМетаданных, ОбъектыВыгруженныеСОшибками, ТолькоПроверкаНедопустимыхСимволов, РегистрБухгалтерии);
	
	Адапт_ПодсчитатьСсылкиНабораЗаписей(
		МенеджерНабораЗаписей, 
		ИмяТаблицыДляЗапроса, 
		СтрокаДереваМетаданных.ОбъектМД.Имя, 
		СтрокаДереваМетаданных, 
		ЭтоРегистрБухгалтерии);	
		
КонецПроцедуры

Процедура Адапт_ПерерасчетыПодсчетВыгружаемых(СтрокаДереваМетаданных) 
	
	ИмяРегистраРасчета = СтрокаДереваМетаданных.Родитель.Родитель.ОбъектМД.Имя;
	МенеджерСтрокой = СтрЗаменить(СтрокаДереваМетаданных.ЭлементОписания.Менеджер, "%i", ИмяРегистраРасчета);
	МенеджерПерерасчета = Вычислить(МенеджерСтрокой);
	МенеджерПерерасчета = МенеджерПерерасчета[СтрокаДереваМетаданных.ОбъектМД.Имя];
	СтрокаДляЗапроса = СтрЗаменить(СтрокаДереваМетаданных.ЭлементОписания.ДляЗапроса, "%i", ИмяРегистраРасчета);
	
	Адапт_ПодсчитатьСсылкиНабораЗаписей(МенеджерПерерасчета, СтрокаДляЗапроса, СтрокаДереваМетаданных.ОбъектМД.Имя, СтрокаДереваМетаданных);
	
	
КонецПроцедуры

Процедура Адапт_ПоследовательностиПодсчетВыгружаемых(СтрокаДереваМетаданных) 
	
	МенеджерНабораЗаписей = СтрокаДереваМетаданных.ЭлементОписания.Менеджер[СтрокаДереваМетаданных.ОбъектМД.Имя];
	
	Адапт_ПодсчитатьСсылкиНабораЗаписей(МенеджерНабораЗаписей, СтрокаДереваМетаданных.ЭлементОписания.ДляЗапроса,
		СтрокаДереваМетаданных.ОбъектМД.Имя, СтрокаДереваМетаданных);
	
КонецПроцедуры

Процедура Адапт_ДанныеОбъектногоТипаПодсчетВыгружаемых(СтрокаДереваМетаданных) 
	
	РезультатЗапроса = ПолучитьРезультатЗапросаСОграничениями(СтрокаДереваМетаданных);
	
	//было:
	//ЗапросИЗапись(РезультатЗапроса, ЗаписьXML, Истина, ОбъектыВыгруженныеСОшибками, ТолькоПроверкаНедопустимыхСимволов);
	//	ОбработкаРезультатаЗапроса();
	
	//стало:
	Адапт_ПодсчетРезультатаЗапроса(РезультатЗапроса, Истина, Истина);
	
КонецПроцедуры

Функция Адапт_СсылкаПодсчитана(Ссылка)
	
	Возврат мПодсчитанныеОбъекты.Найти(Ссылка, "Ссылка") <> Неопределено;
	
КонецФункции

Процедура Адапт_ДобавитьСсылкуКПодсчитанным(Ссылка)
	
	СтрокаДобавления = мПодсчитанныеОбъекты.Добавить();
	СтрокаДобавления.Ссылка = Ссылка;
	
КонецПроцедуры

Процедура Адапт_ПодсчитатьЗначениеПриНеобходимости(АнализируемоеЗначение)
	
	Если Не ЗначениеЗаполнено(АнализируемоеЗначение) Тогда
		Возврат;
	КонецЕсли;
	
	ОбъектМД = СсылочныеТипы.Получить(ТипЗнч(АнализируемоеЗначение));
	
	Если ОбъектМД = Неопределено Тогда
		Возврат; // это не ссылка
	КонецЕсли;
			
	Если Адапт_СсылкаПодсчитана(АнализируемоеЗначение) Тогда
		Возврат; // объект уже был выгружен
	КонецЕсли;
	
	// Проверка того, что данный тип входит в список выгружаемых дополнительно
	СтрокаТаблицы = СоставПолнойВыгрузки.Найти(ОбъектМД, "ОбъектМД");
	Если СтрокаТаблицы <> Неопределено Тогда
		Возврат;
	КонецЕсли;
			
	СтрокаТаблицы = СоставВспомогательнойВыгрузки.Найти(ОбъектМД, "ОбъектМД");
	Если СтрокаТаблицы <> Неопределено Тогда
		
		ДопЗапрос = Новый Запрос("ВЫБРАТЬ * ИЗ " + СтрокаТаблицы.СтрокаДерева.ЭлементОписания.ДляЗапроса + ОбъектМД.Имя +
			" КАК ТаблицаОбъекта_" + " ГДЕ Ссылка = &Ссылка");				
		ДопЗапрос.УстановитьПараметр("Ссылка", АнализируемоеЗначение);
		РезультатЗапроса = ДопЗапрос.Выполнить();
		
		Адапт_ПодсчетРезультатаЗапроса(РезультатЗапроса, Ложь, Истина);
		
	КонецЕсли;
		
КонецПроцедуры

Процедура Адапт_ПодсчитатьПодчиненныеЗначенияНабора(Движение, МассивКолонок)
		
	Для Каждого ЗаписьИзНабора Из Движение Цикл
								
		Для Каждого Колонка Из МассивКолонок Цикл
			
			Если Колонка = "СубконтоДт"
				ИЛИ Колонка = "СубконтоКт" Тогда
				
				Значение = ЗаписьИзНабора[Колонка];
				Для Каждого КлючИЗначение Из Значение Цикл
					
					Если ЗначениеЗаполнено(КлючИЗначение.Значение) Тогда
						Адапт_ПодсчитатьЗначениеПриНеобходимости(КлючИЗначение.Значение);
					КонецЕсли;
					
				КонецЦикла;
				
			Иначе
			
				СохраненноеЗначение = ЗаписьИзНабора[Колонка];
				Адапт_ПодсчитатьЗначениеПриНеобходимости(СохраненноеЗначение);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура Адапт_ПодсчетРезультатаЗапроса(РезультатЗапроса, ВерхнийУровень = Ложь, ЭтоЗапросПоОбъекту = Ложь) 
	
	ВыборкаИзРезультатовЗапроса = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаИзРезультатовЗапроса.Следующий() Цикл
		
		Если ЭтоЗапросПоОбъекту Тогда
			
			// выгрузка ссылочных объектов
			Ссылка = ВыборкаИзРезультатовЗапроса.Ссылка;
			Если Адапт_СсылкаПодсчитана(Ссылка) Тогда
				
				Продолжить;
				
			КонецЕсли;
			
			Адапт_ДобавитьСсылкуКПодсчитанным(Ссылка);
			
		КонецЕсли;
		
		Если мНаличиеВыгрузкиПодчиненныхОбъектов Тогда
		
			// перебираем колонки запроса в поисках ссылочных значений, которые, возможно, нужно выгрузить
			Для Каждого КолонкаЗапроса Из РезультатЗапроса.Колонки Цикл
				
				ЗначениеКолонки = ВыборкаИзРезультатовЗапроса[КолонкаЗапроса.Имя];
				
				Если ТипЗнч(ЗначениеКолонки) = мТипРезультатЗапроса Тогда
					
					Адапт_ПодсчетРезультатаЗапроса(ЗначениеКолонки);
					
				Иначе
				
					Адапт_ПодсчитатьЗначениеПриНеобходимости(ЗначениеКолонки);
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
		Если ЭтоЗапросПоОбъекту Тогда
			
			Объект = Ссылка.ПолучитьОбъект();
			
			Попытка
				
				//ВыполнитьВспомогательныеДействияДляЗаписиXML(ВсегоОбработаноОбъектов, ЗаписьXML, ТолькоПроверкаНедопустимыхСимволов);
				
				//Сериализатор.ЗаписатьXML(ЗаписьXML, Объект);
				
				МетаданныеОбъекта = Объект.Метаданные();
				
				//Если ЭтоМетаданныеСПредопределеннымиЭлементами(МетаданныеОбъекта) И Объект.Предопределенный Тогда
				//	
				//	НоваяСтрока = ТаблицаПредопределенных.Добавить();
				//	НоваяСтрока.ИмяТаблицы = МетаданныеОбъекта.ПолноеИмя();
				//	НоваяСтрока.Ссылка = XMLСтрока(Ссылка);
				//	НоваяСтрока.ИмяПредопределенныхДанных = Объект.ИмяПредопределенныхДанных;
				//	
				//КонецЕсли;
				
				Если ВыгружатьСДокументомЕгоДвижения И Метаданные.Документы.Содержит(МетаданныеОбъекта) Тогда
					
					// выгрузка движений документа
					Для Каждого Движение Из Объект.Движения Цикл
						
						Движение.Прочитать();
						
						Если мНаличиеВыгрузкиПодчиненныхОбъектов
							И Движение.Количество() > 0 Тогда
							
							ТипРегистра = Тип(Движение);
							
							МассивКолонок = мСоответствиеКолонокДвижений.Получить(ТипРегистра);
							
							Если МассивКолонок = Неопределено Тогда
								
								ТаблицаДвижений = Движение.Выгрузить();
								РегистрБухгалтерии = Метаданные.РегистрыБухгалтерии.Содержит(Движение.Метаданные());
								МассивКолонок = ПолучитьМассивКолонокДвижения(ТаблицаДвижений, РегистрБухгалтерии);
								мСоответствиеКолонокДвижений.Вставить(ТипРегистра, МассивКолонок);	
								
							КонецЕсли;
							
							Адапт_ПодсчитатьПодчиненныеЗначенияНабора(Движение, МассивКолонок);
							
						КонецЕсли;
						
					КонецЦикла;
					
				КонецЕсли;
				
			Исключение
				
				СтрокаОписанияОшибки = ОписаниеОшибки();
				Сообщить("Ошибка подсчета выгружаемых ссылок: " + СтрокаОписанияОшибки);
					
				
			КонецПопытки;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура Адапт_ДанныеМассиваСсылокПодсчетВыгружаемых() 
	
	
	
КонецПроцедуры

