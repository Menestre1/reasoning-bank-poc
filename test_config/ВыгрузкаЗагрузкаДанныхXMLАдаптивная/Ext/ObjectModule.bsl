Функция Адапт_ЭтоПростойТипXDTO(Тип) 
	
	ИмяТипа = Тип.Имя;
	URIПространстваИмен = Тип.URIПространстваИмен;

	Если URIПространстваИмен = "http://www.w3.org/2001/XMLSchema" Тогда
		Если ИмяТипа = "string" Или ИмяТипа = "digital" Или ИмяТипа = "datetime" Или ИмяТипа = "boolean" Или ИмяТипа = "binarydata" Тогда
