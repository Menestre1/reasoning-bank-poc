Функция Адапт_ПолучитьЧастиИмениОбъекта(ПолноеИмяОбъекта, ПеревестиАнглРус = Ложь) 
	
	ЧастиИмени = СтрРазделить(ПолноеИмяОбъекта, ".", Ложь);
	
	ВидОбъекта = ЧастиИмени[0];
	ИмяОбъекта = ЧастиИмени[1];
	Если ЧастиИмени.Количество() = 3 Тогда
		ИмяТабЧасти = ЧастиИмени[2];
	Иначе
		ИмяТабЧасти = "";
	КонецЕсли;
	
	
	Если ПеревестиАнглРус Тогда
		ВидОбъектаРус = мСоответствиеВидовбъектов[ВидОбъекта];
		Если ВидОбъектаРус = Неопределено Тогда
			ВызватьИсключение("Не найден вид объекта: " + ВидОбъекта);
		КонецЕсли;
		
		ВидОбъекта = ВидОбъектаРус;
	КонецЕсли;
	
	Результат = Новый Структура();
	Результат.Вставить("ВидОбъекта",              ВидОбъекта);
	Результат.Вставить("ИмяОбъекта",              ИмяОбъекта);
	Результат.Вставить("ИмяТабчасти",             ИмяТабчасти);
	
	Возврат Результат;
	
КонецФункции

