Функция Адапт_ПолучитьТипСвойстваЭтаКонфигурация(СвойствоXDTOИзСхемы, СвойствоОбъекта) 
	
	Если СвойствоXDTOИзСхемы.type = Неопределено Тогда
		Если СвойствоОбъекта.ТекстовоеСодержимое = "" Тогда
			Возврат Null;
		КонецЕсли;
		//Составной тип, но возможно пустое значение
		URIПространстваИмен = "http://v8.1c.ru/8.1/data/enterprise/current-config";
		ТипСвойстваXDTOИзСхемы = Адапт_ОпределитьТипПоАтрибуту(СвойствоОбъекта);
		Если ТипСвойстваXDTOИзСхемы = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
	Иначе
		URIПространстваИмен = СвойствоXDTOИзСхемы.type.URIПространстваИмен;
		ТипСвойстваXDTOИзСхемы = ФабрикаXDTO.Тип(URIПространстваИмен, СвойствоXDTOИзСхемы.type.ЛокальноеИмя);
	КонецЕсли;
	
	Если URIПространстваИмен = "http://v8.1c.ru/8.1/data/enterprise" 
		И (СвойствоXDTOИзСхемы.type.ЛокальноеИмя = "AnyRef") Тогда
		ТипЛюбаяСсылка = ТипСвойстваXDTOИзСхемы;
		
		ТипСвойстваЭтаКонфигурация = Адапт_ОпределитьТипПоАтрибуту(СвойствоОбъекта);
		Если ТипСвойстваЭтаКонфигурация = Неопределено Тогда
			ТипСвойстваЭтаКонфигурация = ТипЛюбаяСсылка;
		КонецЕсли;
	Иначе
		ТипСвойстваЭтаКонфигурация = ТипСвойстваXDTOИзСхемы;
		
	КонецЕсли;
	
	Возврат ТипСвойстваЭтаКонфигурация;
	
КонецФункции

